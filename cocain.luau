	function HUD.targetTick(now: number)
		local T = HUD.tc
		if not T then
			return
		end
		local f = if cfg.targetCard ~= false and not S.menuOpen and not S.featuresPaused then HUD.targetFighter() else nil
		local on = f ~= nil or HUD.editMode
		if T.card.Visible ~= on then
			T.card.Visible = on
		end
		if not on then
			T.f, T.cur = nil, nil
			return
		end
		
		if f ~= T.f or now - T.at >= 0.1 then
			T.at = now
			local newTarget = f ~= T.f
			T.f = f
			if f then
				local root, model = Game.fighterBody(f)
				local nm = (Game.fighterName(f):gsub(" %[BOT%]", ""))
				T.name.Text = nm
				local me = Game.myRoot()
				T.dist.Text = if root and me then ("%d st"):format(math.floor((root.Position - me.Position).Magnitude + 0.5)) else ""
				local h, mx = Game.fighterHealth(f)
				if h and mx and mx > 0 and mx < math.huge and h == h then
					T.frac = math.clamp(h / mx, 0, 1)
					T.hp.Text = tostring(math.floor(h + 0.5))
				else
					T.frac = 1
					T.hp.Text = "∞"
				end
				local eq = Game.enemyEquipped(f)
				local wep = if type(eq) == "table" and eq.Name then tostring(eq.Name) else "—"
				local part = model and (Game.hitboxPart(f, "Head") or Game.fighterHead(f)) or nil
				local seen = model ~= nil and part ~= nil and Game.rayVisible(model, part)
				local sight = if seen then ('<font color="#%s">in sight</font>'):format(C.ok:ToHex()) else ('<font color="#%s">behind cover</font>'):format(C.warn:ToHex())
				local tag = S.counter and S.counter.tag and S.counter.tag(f) or nil
				local immune = cfg.immuneCheck and Game.fighterImmune(f)
				T.info.Text = HUD.richEscape(wep) .. " · " .. sight .. (if immune then (' · <font color="#%s">immune</font>'):format(Vis.IMMUNE_COLOR:ToHex()) else "") .. (if tag then " · " .. HUD.richEscape(tag) else "")
				if newTarget then
					T.cur = T.frac
				end
			else
				T.name.Text, T.dist.Text, T.hp.Text, T.info.Text, T.frac = "Target", "24 st", "62", "Assault Rifle · in sight", 0.62
			end
			T.stats.Text = HUD.shotLine() or "no shots this round"
		end
		local dt = math.clamp(now - (T.tickAt or now), 0, 0.1)
		T.tickAt = now
		T.cur = if T.cur == nil then T.frac else T.cur + (T.frac - T.cur) * math.min(1, dt * 12)
		local fr = math.floor(T.cur * 400 + 0.5) / 400
		if T.shown ~= fr then
			T.shown = fr
			T.fill.Size = UDim2.new(fr, 0, 1, 0)
			T.fill.BackgroundColor3 = if fr > 0.5 then C.warn:Lerp(C.ok, (fr - 0.5) * 2) else C.danger:Lerp(C.warn, fr * 2)
		end
	end

