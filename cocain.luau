	Vis.priSrc, Vis.priSet = nil, nil
	function Vis.priRefresh()
		local src = if type(cfg.espPriority) == "string" then cfg.espPriority else ""
		if Vis.priSrc == src then
			return
		end
		Vis.priSrc = src
		local set = {}
		for part in src:gmatch("[^,]+") do
			local key = part:lower():match("^%s*(.-)%s*$")
			if key ~= "" then
				set[key] = true
			end
		end
		Vis.priSet = set
	end
	
	function Vis.priorityOn(): boolean
		Vis.priRefresh()
		return next(Vis.priSet) ~= nil
	end
	function Vis.priority(name: string): boolean
		Vis.priRefresh()
		local set = Vis.priSet
		if next(set) == nil then
			return false
		end
		local key = (name:gsub(" %[BOT%]$", "")):lower()
		return set[key] == true
	end

	
	
	
	
	function Vis.dmgAttacker(): Vector3?
		local me, list = Game.myRoot(), S.enemiesNow
		if not me or not list then
			return nil
		end
		local now, H = os.clock(), Combat.hvh
		local fresh, freshAt, near, nearD = nil, nil, nil, math.huge
		for _, f in ipairs(list) do
			local r = Game.fighterBody(f)
			if r then
				local d = (r.Position - me.Position).Magnitude
				if d < nearD then
					near, nearD = r, d
				end
				local e = H and H.enemy and H.enemy[f]
				local t = e and e.lastShot
				if t and now - t < 0.75 and (freshAt == nil or t > freshAt) then
					fresh, freshAt = r, t
				end
			end
		end
		local best = fresh or near
		return if best then best.Position else nil
	end
	Vis.DMG_MARKS = 6 
	Vis.dmgMarks = {}
	Vis.dmgDirN, Vis.selfGhostN = 0, 0
	Vis.dmgHp, Vis.packOn = nil, false
	Vis.ghostPts = {}
	function Vis.dmgPush(has: boolean, x: number, z: number, amount: number)
		local marks = Vis.dmgMarks
		table.insert(marks, { has = has, x = x, z = z, amount = amount, at = os.clock() })
		while #marks > Vis.DMG_MARKS do
			table.remove(marks, 1)
		end
	end
	
	
	
	function Vis.dmgStep()
		local hp = Game.myHealth()
		local last = Vis.dmgHp
		Vis.dmgHp = hp
		if hp and last and hp < last - 0.5 then
			local me = Game.myRoot()
			local pos = Vis.dmgAttacker()
			local x, z, has = 0, 0, false
			if pos and me then
				local d = pos - me.Position
				local flat = math.sqrt(d.X * d.X + d.Z * d.Z)
				if flat > 0.1 then
					x, z, has = d.X / flat, d.Z / flat, true
				end
			end
			Vis.dmgPush(has, x, z, last - hp)
		end
	end
	
	
	
	function Vis.dmgDirDraw(cam: Camera, now: number, center: Vector2, vp: Vector2)
		local marks = Vis.dmgMarks
		local life = math.clamp(tonumber(cfg.dmgDirSec) or 1.5, 0.4, 4)
		while #marks > 0 and now - marks[1].at > life do
			table.remove(marks, 1)
		end
		if cfg.dmgDir ~= true or S.featuresPaused or #marks == 0 then
			if Vis.dmgDirN > 0 then
				Vis.dmgDirN = 0
				Vis.hide("dp", 0)
				Vis.hide("dpt", 0)
			end
			return
		end
		local look = cam.CFrame.LookVector
		local fwd = Vector3.new(look.X, 0, look.Z)
		fwd = if fwd.Magnitude > 0.01 then fwd.Unit else Vector3.new(0, 0, -1)
		local right = Vector3.new(-fwd.Z, 0, fwd.X)
		local sv = Vis.sv
		local col = Vis.BAR_LOW
		local base = math.min(vp.X, vp.Y) * 0.17
		local n = 0
		for i, m in ipairs(marks) do
			if m.has then
				local dir = Vector2.new(m.x * right.X + m.z * right.Z, -(m.x * fwd.X + m.z * fwd.Z))
				if dir.Magnitude > 0.01 then
					n += 1
					dir = dir.Unit
					
					local ring = 0
					for j = 1, i - 1 do
						local o = marks[j]
						if o.has and o.x * m.x + o.z * m.z > 0.985 then
							ring += 1
						end
					end
					
					
					local k = math.clamp((now - m.at) / life, 0, 1)
					local alpha = 1 - k * k
					local tip = center + dir * (base + ring * 14)
					local perp = Vector2.new(-dir.Y, dir.X)
					local inner = tip - dir * 9
					local l1, l2 = Vis.draw("dp" .. (n * 2 - 1), "Line"), Vis.draw("dp" .. (n * 2), "Line")
					if l1 then
						Vis.setLine(l1, tip, inner + perp * 7, col, 2)
						sv(l1, "Transparency", 1 - alpha * 0.9)
					end
					if l2 then
						Vis.setLine(l2, tip, inner - perp * 7, col, 2)
						sv(l2, "Transparency", 1 - alpha * 0.9)
					end
					local txt = Vis.draw("dpt" .. n, "Text")
					if txt then
						sv(txt, "Text", ("%d"):format(math.floor(m.amount + 0.5)))
						Vis.styleText(txt, math.max(9, (cfg.espTextSize or 13) - 3), col, true)
						sv(txt, "Position", inner + dir * 4 + Vector2.new(0, -4))
						sv(txt, "Transparency", 1 - alpha)
						sv(txt, "Visible", true)
					end
				end
			end
		end
		Vis.dmgDirN = n
		Vis.hide("dp", n * 2)
		Vis.hide("dpt", n)
	end
	
	
	
	
	
	
	
	function Vis.selfGhostStep(cam: Camera): (Vector3?, Vector3?, string?)
		local me = Game.myRoot()
		if not me then
			return nil, nil, nil
		end
		local t = Combat.cs and Combat.cs.target
		if S.csyncHead ~= nil and typeof(t) == "CFrame" then
			return t.Position, t.LookVector, "server"
		end
		local delta = Combat.aaServerDelta()
		local echo = S.aaServerRot
		if delta and delta > 0.2 and typeof(echo) == "Vector2" then
			return me.Position, (CFrame.Angles(0, echo.Y, 0)).LookVector, "server yaw"
		end
		local bodyYaw = tonumber(S.aaBodyYaw)
		if bodyYaw then
			local _, camYaw = cam.CFrame:ToOrientation()
			if math.abs(((bodyYaw - camYaw + math.pi) % (2 * math.pi)) - math.pi) > 0.2 then
				return me.Position, (CFrame.Angles(0, bodyYaw, 0)).LookVector, "server yaw"
			end
		end
		return nil, nil, nil
	end
	function Vis.selfGhostOff()
		if Vis.selfGhostN > 0 then
			Vis.selfGhostN = 0
			Vis.hide("sg", 0)
			Vis.off("sgFill")
			Vis.off("sgTxt")
		end
	end
	function Vis.selfGhostDraw(cam: Camera)
		local pos, dir, label = Vis.selfGhostStep(cam)
		if pos == nil or dir == nil then
			Vis.selfGhostOff()
			return
		end
		
		local hx, hy, hz = 1.15, 2.75, 0.85
		local flat = Vector3.new(dir.X, 0, dir.Z)
		local cf = if flat.Magnitude > 0.01 then CFrame.lookAt(pos, pos + flat.Unit) else CFrame.new(pos)
		local pts = Vis.ghostPts
		pts[1] = Vis.w2sNear(cam, cf:PointToWorldSpace(Vector3.new(-hx, hy, -hz)), Vis.NEAR_Z)
		pts[2] = Vis.w2sNear(cam, cf:PointToWorldSpace(Vector3.new(hx, hy, -hz)), Vis.NEAR_Z)
		pts[3] = Vis.w2sNear(cam, cf:PointToWorldSpace(Vector3.new(-hx, hy, hz)), Vis.NEAR_Z)
		pts[4] = Vis.w2sNear(cam, cf:PointToWorldSpace(Vector3.new(hx, hy, hz)), Vis.NEAR_Z)
		pts[5] = Vis.w2sNear(cam, cf:PointToWorldSpace(Vector3.new(-hx, -hy, -hz)), Vis.NEAR_Z)
		pts[6] = Vis.w2sNear(cam, cf:PointToWorldSpace(Vector3.new(hx, -hy, -hz)), Vis.NEAR_Z)
		pts[7] = Vis.w2sNear(cam, cf:PointToWorldSpace(Vector3.new(-hx, -hy, hz)), Vis.NEAR_Z)
		pts[8] = Vis.w2sNear(cam, cf:PointToWorldSpace(Vector3.new(hx, -hy, hz)), Vis.NEAR_Z)
		local ok = true
		for i = 1, 8 do
			if pts[i] == nil then
				ok = false
				break
			end
		end
		if not ok then
			
			
			Vis.selfGhostOff()
			return
		end
		local sv = Vis.sv
		local col = Vis.col("colSelf")
		for i, e in ipairs(Vis.BOX_EDGES) do
			local ln = Vis.draw("sg" .. i, "Line")
			if ln then
				Vis.setLine(ln, pts[e[1]], pts[e[2]], col, 1)
				sv(ln, "Transparency", 0.3)
			end
		end
		local x0, y0, x1, y1 = pts[1].X, pts[1].Y, pts[1].X, pts[1].Y
		for i = 2, 8 do
			local p = pts[i]
			x0, y0 = math.min(x0, p.X), math.min(y0, p.Y)
			x1, y1 = math.max(x1, p.X), math.max(y1, p.Y)
		end
		Vis.selfGhostN = 1
		local fill = Vis.draw("sgFill", "Square")
		if fill then
			sv(fill, "Position", Vector2.new(x0, y0))
			sv(fill, "Size", Vector2.new(x1 - x0, y1 - y0))
			sv(fill, "Color", col)
			sv(fill, "Filled", true)
			sv(fill, "Transparency", 0.9)
			sv(fill, "ZIndex", 1)
			sv(fill, "Visible", true)
		end
		local txt = Vis.draw("sgTxt", "Text")
		if txt then
			sv(txt, "Text", label or "server")
			Vis.styleText(txt, math.max(9, (cfg.espTextSize or 13) - 3), col, true)
			sv(txt, "Position", Vector2.new((x0 + x1) / 2, y0 - 12))
			sv(txt, "Transparency", 0.15)
			sv(txt, "Visible", true)
		end
	end
	
	
	
	function Vis.espPackTick()
		local cam = workspace.CurrentCamera
		if not cam then
			return
		end
		local ghostOn = cfg.selfGhost == true and cfg.esp == true
		if cfg.dmgDir ~= true and not ghostOn then
			if Vis.packOn then
				Vis.packOn = false
				Vis.dmgDirN = 0
				Vis.hide("dp", 0)
				Vis.hide("dpt", 0)
				Vis.selfGhostOff()
				table.clear(Vis.dmgMarks)
				
				
				Vis.dmgHp = nil
			end
			return
		end
		Vis.packOn = true
		local now = os.clock()
		Vis.dmgStep()
		Vis.dmgDirDraw(cam, now, cam.ViewportSize / 2, cam.ViewportSize)
		if ghostOn then
			Vis.selfGhostDraw(cam)
		else
			Vis.selfGhostOff()
		end
	end

	
	
	
	
