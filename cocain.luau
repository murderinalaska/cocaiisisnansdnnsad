	function Vis.skyCustomIds(): { string }?
		local raw = cfg.skyboxCustom
		if raw == nil or raw == "" then
			Vis.skyCustomAt, Vis.skyCustomIds6 = nil, nil
			return nil
		end
		if Vis.skyCustomAt == raw then
			return Vis.skyCustomIds6
		end
		Vis.skyCustomAt = raw
		local ids: { string } = {}
		for part in string.gmatch(raw, "[^,%s]+") do
			
			local id = if part:match("^%d+$") then "rbxassetid://" .. part else part
			table.insert(ids, id)
			if #ids == 6 then
				break
			end
		end
		Vis.skyCustomIds6 = if #ids == 6 then ids else nil
		return Vis.skyCustomIds6
	end
	
