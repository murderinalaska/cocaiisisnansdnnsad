	Combat.hlLive = 0
	function Combat.hitFlash(model: Instance?, kill: boolean?)
		if not cfg.hitChams or typeof(model) ~= "Instance" or model.Parent == nil or Combat.hlLive >= 4 then
			return
		end
		pcall(function()
			local c = cfg.colHitChams
			local col = if kill then Color3.fromRGB(255, 60, 60) elseif type(c) == "table" then Color3.fromRGB(c[1] or 255, c[2] or 255, c[3] or 255) else Color3.new(1, 1, 1)
			local h = Instance.new("Highlight")
			h.Name = "CocaineHitFlash"
			h.Adornee = model
			h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
			h.FillColor = col
			h.OutlineColor = col:Lerp(Color3.new(1, 1, 1), 0.5)
			h.FillTransparency = 0.25
			h.OutlineTransparency = 0.05
			h.Parent = workspace.CurrentCamera
			Combat.hlLive += 1
			local life = if kill then 0.8 else 0.4
			game:GetService("TweenService"):Create(h, TweenInfo.new(life, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), { FillTransparency = 1, OutlineTransparency = 1 }):Play()
			task.delay(life + 0.05, function()
				Combat.hlLive = math.max(Combat.hlLive - 1, 0)
				pcall(h.Destroy, h)
			end)
		end)
	end
	
