local function siteError(message: string): boolean
	local lic = genv().CocaineLicense
	if type(lic) ~= "table" or type(lic.session) ~= "string" or #lic.session < 16 or type(lic.base) ~= "string" then
		return false
	end
	local req = request or http_request or (syn and syn.request)
	if type(req) ~= "function" then
		return false
	end
	task.spawn(function()
		pcall(req, {
			Url = lic.base .. "/api/telemetry",
			Method = "POST",
			Headers = { ["Content-Type"] = "application/json", Authorization = "Bearer " .. lic.session },
			Body = game:GetService("HttpService"):JSONEncode({ kind = "error", level = "error", message = message:sub(1, 400) }),
		})
	end)
	return true
end

local initOk, initErr = pcall(genv().CocaineInit)
genv().CocaineLoadingSince = nil
if not initOk and string.find(tostring(initErr), "superseded by a newer inject", 1, true) then
	
	
	if type(genv().CocaineLicense) ~= "table" then
		warn("[cocaine] " .. tostring(initErr))
	end
	initOk = true
end
if not initOk then
	
	
	local errText = tostring(initErr)
	if not siteError("failed to start: " .. errText:sub(1, 300)) then
		warn("[cocaine] " .. errText)
	end
	pcall(function()
		game:GetService("StarterGui"):SetCore("SendNotification", {
			Title = "cocaine",
			Text = "failed to start: " .. string.sub(tostring(initErr), 1, 90),
			Duration = 10,
		})
	end)
	pcall(function()
