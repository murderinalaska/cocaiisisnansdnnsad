	function Hooks.rollback(stage: string?): string?
		local P = Game.pilot
		local why = "shots stopped registering" .. (if stage then " — died at " .. stage else "")
		if P.get("wrapper") == "cclosure" and P.set("wrapper", "raw", why) then
			local n = Hooks.giveBack({ fire = true, aim = true, reload = true })
			installed.fireGun, installed.fireMelee = nil, nil
			installed.fighterLocal, installed.fighterEnemy, installed.fighter, installed.cameraData = nil, nil, nil, nil
			installed.gun, installed.spreadClaim, installed.camera = nil, nil, false
			pcall(Hooks.installCamera)
			pcall(Hooks.installFire)
			pcall(Hooks.installGun)
			local lf = Game.localFighter()
			if lf then
				pcall(Hooks.installFighter, lf)
			end
			return ("shooting-path hooks put back without newcclosure (%d re-installed)"):format(n)
		end
		if Hooks.fireInstalled() and P.get("wrapper") ~= "restore" and P.set("wrapper", "restore", why) then
			local n = Hooks.giveBack({ fire = true })
			installed.fireGun, installed.fireMelee = "off", "off"
			return ("fire gate taken out (%d given back — rapid fire and voidspam's fire hold are off)"):format(n)
		end
		if P.get("payload") == "claim" and P.set("payload", "rotation", why) then
			local n = Hooks.giveBack({ aim = true })
			installed.camera, installed.cameraData, installed.spreadClaim = "off", "off", "off"
			return ("aim hooks given back (%d) — silent aim uses the raycast redirect and the rotation only"):format(n)
		end
		if installed.namecall == true and P.set("namecall", "off", why) then
			Hooks.namecallOff(why)
			return "__namecall given back — raycast redirect, anti-aim rewrite and device spoof are off"
		end
		if P.get("shield") == "full" and P.set("shield", "safe", why) then
			local n = Hooks.giveBack({ all = true })
			Hooks.namecallOff(why)
			return ("safe mode — every hook given back (%d): ESP and aimbot only"):format(n)
		end
		return nil
	end
	S.hooksRollback = Hooks.rollback

	
	
	
