		local hui = (type(gethui) == "function" and pcall(gethui) and gethui()) or game:GetService("CoreGui")
		g.Parent = hui
		badges[plr] = g
	end

	local presenceAcc = 0
	local presenceConn
	presenceConn = RunService.Heartbeat:Connect(function(dt)
		if not alive() then
			presenceConn:Disconnect()
			for plr, g in pairs(badges) do
				pcall(g.Destroy, g)
				badges[plr] = nil
			end
			for plr in pairs(realVals) do
				pcall(applyOne, plr, nil)
			end
			for _, plr in ipairs(Players:GetPlayers()) do
				pcall(applyIdentity, plr, nil)
			end
			pcall(idPass)
			pcall(idUninstall)
			return
		end
		idAcc += dt
		if idAcc >= 0.5 then
			idAcc = 0
			pcall(idPass)
		end
		presenceAcc += dt
		if presenceAcc < 0.3 then
			return
		end
		presenceAcc = 0
		local stS = findGlobal("CocaineState")
		local selfMax = type(stS) == "table" and stS.edition == "max"
		local mine = if selfMax then findGlobal("CocaineMaxBroadcast") else nil
		for _, plr in ipairs(Players:GetPlayers()) do
			local m, r = isMax(plr)
			local spoof, badge = m and r.spoof or nil, m and r.badge == true
			local kind = if m and r.edition == "nightly" then "nightly" else "max"
			if plr == LP and selfMax then
				
				
				spoof = if type(mine) == "table" then mine.spoof else nil
				badge = type(mine) == "table" and mine.badge ~= false
				kind = if runningEdition() == "nightly" then "nightly" else "max"
			end
			pcall(applyOne, plr, spoof)
			pcall(applyIdentity, plr, spoof)
			pcall(badgeFor, plr, badge, kind)
		end
		for plr, g in pairs(badges) do
			if not plr.Parent then
				pcall(g.Destroy, g)
				badges[plr] = nil
			end
		end
	end)

	local function desiredSkin(playerName, weapon)
		local lower = string.lower(playerName)
		for _, row in pairs(others) do
			if type(row) == "table" and type(row.username) == "string" and string.lower(row.username) == lower then
				local eq = row.equips and row.equips[weapon]
				if type(eq) == "table" and type(eq.Skin) == "string" then
					return eq.Skin
				end
			end
		end
		return nil
	end
	local function restore(model)
		local parts = hidden[model]
		if parts then
			for part, tr in pairs(parts) do
				if part.Parent then
					part.LocalTransparencyModifier = tr
				end
			end
			hidden[model] = nil
		end
	end
	local function clearClones()
		for key, clone in pairs(clones) do
			follow[clone] = nil
			pcall(clone.Destroy, clone)
			clones[key] = nil
		end
	end
	local followConn = RunService.RenderStepped:Connect(function()
		if next(follow) == nil then
			return
		end
		for clone, model in pairs(follow) do
			if clone.Parent and model.Parent then
				pcall(clone.PivotTo, clone, model:GetPivot())
			else
				follow[clone] = nil
			end
		end
	end)

	
	
	local acc = 0
	local conn
	conn = RunService.Heartbeat:Connect(function(dt)
		if not alive() then
			conn:Disconnect()
			followConn:Disconnect()
			clearClones()
			return
		end
		acc += dt
		if acc < 0.1 then
			return
		end
		acc = 0
		if #others == 0 then
			if next(clones) then
				clearClones()
			end
			return
		end
		local root = workspace:FindFirstChild("ViewModels")
		if not root then
			return
		end
		local seen = {}
		local mine = LP.Name .. " - "
		for _, model in ipairs(root:GetChildren()) do
			if model:IsA("Model") and model.Name:sub(1, #mine) ~= mine then
				local parts = string.split(model.Name, " - ")
				if #parts >= 3 then
					local vm = parts[#parts]
					local weapon = parts[#parts - 1]
					local who = table.concat(parts, " - ", 1, #parts - 2)
					local skin = desiredSkin(who, weapon)
					local key = model:GetDebugId()
					seen[key] = true
					if skin and skin ~= vm then
						local template = findTemplate(skin)
						if template and template:IsA("Model") then
							local clone = clones[key]
							if not clone or not clone.Parent then
								clone = template:Clone()
								clone.Name = "CocaineShared"
								clone.Parent = workspace.CurrentCamera
								clones[key] = clone
								local saved = {}
								for _, d in ipairs(model:GetDescendants()) do
									if d:IsA("BasePart") then
										saved[d] = d.LocalTransparencyModifier
										d.LocalTransparencyModifier = 1
									end
								end
								hidden[model] = saved
							end
							follow[clone] = model
						end
					else
						restore(model)
						local clone = clones[key]
						if clone then
							follow[clone] = nil
							clone:Destroy()
							clones[key] = nil
						end
					end
				end
			end
		end
		for key, clone in pairs(clones) do
			if not seen[key] then
				follow[clone] = nil
				clone:Destroy()
				clones[key] = nil
			end
		end
	end)
end

