		req.void, req.sky, req.far = D.kind == "void" or D.kind == "slab" or tl, D.kind == "sky", D.kind == "far" or tl
		req.clear = if tl then select(2, Combat.translocParams()) else nil
		req.hold = if D.kind == "slab" and cfg.defenseVoidSpam then 0.25 else 0.6
		
		local spot = D.spot
