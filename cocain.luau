					if spot.kind ~= D.kind then
						log("INFO", ("defense: moving %s (%s)"):format(Combat.hideWhere(spot), if mustMove then "volume clock" else "hop"))
					end
					D.spot, D.kind, D.hopAt = spot.pos, spot.kind, now
					Combat.noteVoidspam(spot)
				elseif mustMove then
					Combat.defenseReturn("volume clock")
					return
				end
			end
		end
		Combat.holdHide()
	end
	
	
	function Combat.akMove(): string
		local m = cfg.autokillMove
		if m ~= "Auto" then
			return m
		end
		
		if ak.mode == "Orbit" then
			return "Orbit"
		end
		local sit = S.situation
		if sit and (sit.crowd or sit.aimingAtMe >= 2 or sit.hpFrac < 0.5) then
			return "Hop"
		end
		return "Orbit"
	end
	
	
	
	Combat.akModeStats = {}
	
	Combat.COMBO_CLASSES = { "Sniper", "Shotgun", "Rifle", "Pistol", "Burst", "Projectile", "Melee", "Other" }
	Combat.COMBO_DEFAULTS = { Sniper = "High", Shotgun = "Under", Rifle = "Void", Pistol = "Mode", Burst = "Mode", Projectile = "Mode", Melee = "Mode", Other = "Mode" }
	Combat.AK_MODE_LIST = { "Origin", "Orbit", "Void", "Snap", "Under", "High", "Glue" }
	function Combat.comboClass(prof: any): string
		local c = prof and prof.class
		if c == "sniper" then
			return "Sniper"
		elseif c == "shotgun" then
			return "Shotgun"
		elseif c == "burst" then
			return "Burst"
		elseif c == "projectile" then
			return "Projectile"
		elseif c == "melee" or c == "crit melee" then
			return "Melee"
		elseif c == "rifle" or c == "flamethrower" then
			local item = prof.item
			local auto = prof.spamFlag == true or (item ~= nil and Combat.spammable ~= nil and Combat.spammable(item))
			return if auto or c == "flamethrower" then "Rifle" else "Pistol"
		end
		return "Other"
	end
	function Combat.resetCombos()
		for cls, def in pairs(Combat.COMBO_DEFAULTS) do
			cfg["autokillMode" .. cls] = def
		end
		log("INFO", "[autokill:combos] reset to defaults (Sniper High, Shotgun Under, Rifle Void)")
	end
	
	function Combat.enemyType(f: any): string
		if f == nil or f.IsBot then
			return "bot"
		end
		if Combat.hvh and Combat.hvh.isGluebot and Combat.hvh.isGluebot(f) then
			return "gluebot"
		end
		local _, model = Game.fighterBody(f)
		if model and S.bounds.underDesync(model) then
			return "under"
		end
		local t = S.counter and S.counter.track and S.counter.track[f]
		if t and S.counter.spammer and S.counter.spammer(t) then
			return "voidspam"
		end
		if (t and S.counter.teleporter and S.counter.teleporter(t)) or (model and Resolver.warping(model)) then
			return "ragebot"
		end
		return "legit"
	end
	
	function Combat.roofOver(head: BasePart?): boolean
		local params = Game.losParams()
		if not (head and params) then
			return false
		end
		return workspace:Raycast(head.Position, Vector3.new(0, 40, 0), params) ~= nil
	end
	function Combat.autoKey(cls: string, enemy: string, mode: string): string
		return ("%s|%s|%s|%s"):format(tostring(Combat.voidKey() or game.PlaceId), cls, enemy, mode)
	end
	
	function Combat.autoBucket(key: string): any
		local b = cfg.autoStats[key]
		if type(b) ~= "table" then
			b = { n = 0, hit = 0, t = os.time() }
			cfg.autoStats[key] = b
		end
		local age = (os.time() - (tonumber(b.t) or os.time())) / 86400
		if age > 0.01 then
			local k = 0.5 ^ (age / math.max(cfg.autoDecayDays, 0.5))
			b.n, b.hit, b.t = (tonumber(b.n) or 0) * k, (tonumber(b.hit) or 0) * k, os.time()
		end
		return b
	end
	function Combat.autoRecord(hit: boolean)
		if not (ak.autoCls and ak.autoEnemy and ak.mode) then
			return
		end
		local b = Combat.autoBucket(Combat.autoKey(ak.autoCls, ak.autoEnemy, ak.mode))
		b.n += 1
		if hit then
			b.hit += 1
		end
	end
	
	
	function Combat.autoPickMode(target: any, prof: any, cls: string): (string, string, string?)
		local enemy = Combat.enemyType(target)
		local head = target and (Game.hitboxPart(target, "Head") or Game.fighterHead(target))
		local roof = Combat.roofOver(head)
		local thick = Combat.slabUnder and head and Combat.slabUnder(head.Position) or nil
		local slow = (S.pingMs or 0) > cfg.autoPingHops
		local comboPref = Combat.COMBO_DEFAULTS[cls]
		local want = cfg["autokillMode" .. cls]
		if want == "Mode" or want == "Auto" then
			want = comboPref
		end
		local scored = {}
		for _, m in ipairs(Combat.AK_MODE_LIST) do
			local ok = true
			if m == "Glue" and not (enemy == "gluebot" or enemy == "ragebot") then
				ok = false
			end
			if ok then
				local b = Combat.autoBucket(Combat.autoKey(cls, enemy, m))
				local prior = if m == want then 0.35 elseif m == "Glue" and enemy == "gluebot" then 0.45 else 0.2
				local pw = cfg.autoMinSamples
				local s = (b.hit + prior * pw) / (b.n + pw)
				if m == "High" and roof then
					s *= 0.6
				end
				if m == "Under" and thick and (thick.layers > 1 or thick.thick > cfg.underMaxSlab) then
					s *= 0.6
				end
				if slow then
					s *= if m == "Orbit" or m == "Snap" then 0.8 elseif m == "Void" or m == "High" then 1.05 else 1
				end
				table.insert(scored, { m = m, s = s, n = b.n, rate = if b.n > 0 then b.hit / b.n else nil })
			end
		end
		table.sort(scored, function(a, b)
			return a.s > b.s
		end)
		local pick, runner = scored[1], scored[2]
		local why = ("auto (%s, %s)"):format(cls, enemy)
		if math.random() * 100 < cfg.autoExplore then
			local few = {}
			for _, e in ipairs(scored) do
				if e.n < cfg.autoMinSamples then
					table.insert(few, e)
				end
			end
			if #few > 0 then
				runner = pick
				pick = few[math.random(1, #few)]
				why ..= " · exploring"
			end
		end
		log("INFO", ("[auto:pick] mode %s (map %s, %s, %s) · hit %s of %.0f%s%s%s"):format(pick.m, tostring(Combat.voidKey() or game.PlaceId), cls, enemy, if pick.rate then ("%d%%"):format(math.floor(pick.rate * 100 + 0.5)) else "?", pick.n, if runner then (" · runner-up %s %s"):format(runner.m, if runner.rate then ("%d%%"):format(math.floor(runner.rate * 100 + 0.5)) else "?") else "", if roof then " · roof" else "", if slow then " · high ping" else ""))
		return pick.m, why, runner and runner.m
	end
	
	function Combat.akPickMode(target: any, prof: any): (string, string)
		local cls = Combat.comboClass(prof)
		ak.autoCls, ak.autoEnemy = cls, Combat.enemyType(target)
		if cfg.gluebotCounter and ak.autoEnemy == "gluebot" and Combat.hvh and Combat.hvh.counterFor(target) then
			return "Glue", "glue-bot counter"
		end
		local want = cfg["autokillMode" .. cls] or "Mode"
		local why = cls .. " combo"
		if want == "Mode" then
			want, why = cfg.autokillMode, "main mode"
		end
		local runner: string? = nil
		if want == "Auto" then
			want, why, runner = Combat.autoPickMode(target, prof, cls)
		end
		if not table.find(Combat.AK_MODE_LIST, want) then
			want = "Origin"
		end
		if want == "Glue" and not (Combat.hvh and Combat.hvh.glueOk()) then
			want, why = "Origin", why .. " · glue unavailable"
		end
		
		
		if want == "Under" and ak.autoEnemy == "under" then
			want, why = "Origin", why .. " · target is under the floor"
		end
		if Combat.akBladeClose(target, want) then
			want, why = "High", why .. " · blade out: out of reach"
		end
		if Combat.akModeGuarded(want) then
			local alt = if runner and runner ~= want then runner else "Origin"
			why = ("%s · guard %s -> %s"):format(why, want, alt)
			want = alt
		end
		return want, why
	end
	
	Combat.AK_CLOSE_MODES = { Under = true, Orbit = true, Void = true, Glue = true }
	function Combat.akBladeClose(target: any, mode: string): boolean
		return Combat.AK_CLOSE_MODES[mode] == true and target ~= nil and Game.fighterMeleeOut(target) ~= nil
	end
	function Combat.akModeGuarded(mode: string): boolean
		if not cfg.autokillModeGuard or mode == "Origin" then
			return false
		end
		local ms = Combat.akModeStats[mode]
		if not ms or ms.n < 25 or ms.hit / ms.n >= 0.15 then
			return false
		end
		local now = os.clock()
		if now - (Combat.akGuardLogAt or 0) > 20 then
			Combat.akGuardLogAt = now
			log("WARN", ("[autokill:mode-guard] %s landed %d of %d rounds this session (%d%%) — this run uses Origin"):format(mode, ms.hit, ms.n, math.floor(ms.hit / ms.n * 100 + 0.5)))
		end
		return true
	end

	
	
	
	Combat.akSkip = setmetatable({}, { __mode = "k" })
	function Combat.akScore(f: any, from: Vector3, enemies: { any }): (number?, number)
		local r = Game.fighterBody(f)
		if not r then
			return nil, math.huge
		end
		if (cfg.deadTargetGuard and Target.isDead(f)) or (cfg.immuneCheck and Game.fighterImmune(f)) then
			return nil, math.huge
		end
		
		local _, rm = Game.fighterBody(f)
		if S.counter.offMap(f) or os.clock() < (Combat.akSkip[f] or 0) or not Combat.engageable(rm) then
			return nil, math.huge
		end
		local d = (r.Position - from).Magnitude
		
		if S.bounds.isVoidFighter(f) then
			d = ((r.Position - from) * Vector3.new(1, 0, 1)).Magnitude
		end
		local score = d
		
		local _, fm = Game.fighterBody(f)
		if S.bounds.underDesync(fm) then
			score -= 40
		end
		if cfg.autokillAdaptive then
			score -= Target.threat(f) * 15
			local hp, mx = Game.fighterHealth(f)
			if hp and mx and mx > 0 then
				score -= (1 - hp / mx) * 20
			end
			for _, o in ipairs(enemies) do
				if o ~= f then
					local ro = Game.fighterBody(o)
					if ro and (ro.Position - r.Position).Magnitude < 25 then
						score += 10
					end
				end
			end
			if Combat.enemyDeflecting(f) then
				score += 25
			end
		end
		return score, d
	end
	function Combat.pickAutokillTarget(enemies: { any }, exclude: any): (any, number)
		local me = Game.myRoot()
		if not me then
			return nil, math.huge
		end
		
		
		
		local B = Combat.body
		local from = if (ak.state == "idle" or ak.state == "done") and S.teleported and B.home then B.home.Position else me.Position
		local best, bestS, bestD = nil, math.huge, math.huge
		for _, f in ipairs(enemies) do
			if f ~= exclude then
				local s, d = Combat.akScore(f, from, enemies)
				if s and s < bestS then
					best, bestS, bestD = f, s, d
				end
			end
		end
		return best, bestD
	end
	
	function Combat.akGeometry(prof: any, target: any): (number, number, number)
		local r, hgt, speedMult = cfg.autokillRadius, cfg.autokillHeight, 1
		if prof.melee then
			r, hgt = 2.2, 0.6
		elseif prof.pellets > 1 then
			r, hgt = math.min(r, 3), math.min(hgt, 1.5)
		end
		local info = prof.item and prof.item.Info
		if cfg.autokillAdaptive and type(info) == "table" then
			local boom = tonumber(info.ExplosionRadius) or tonumber(info.BlastRadius) or tonumber(info.ExplosionSize) or 0
			if prof.projectile and boom > 0 then
				r, hgt = math.max(r, boom + 2), math.max(hgt, 3) 
			end
			if info.AimScopePercent then
				r, hgt = math.max(r, 6), math.max(hgt, 4) 
			end
			local eq = Game.enemyEquipped(target)
			local einfo = type(eq) == "table" and eq.Info
			if type(einfo) == "table" then
				if einfo.Type ~= "Gun" or (tonumber(einfo.ShootPellets) or 1) > 1 then
					r, hgt = r + 2, hgt + 1 
				end
				if einfo.AimScopePercent then
					speedMult = 1.6 
				end
			end
		end
		return math.clamp(r, 1.5, 8), math.clamp(hgt, 1, 6), speedMult
	end
	
	Combat.akReq = { hold = 0.5, pin = false, turnCam = false, key = nil, jump = false, velocity = nil, geometry = true, void = false, sky = false, refGround = nil }
	
	function Combat.akTranslocOpts(r: any, shooting: boolean)
		local on = shooting and ak.transloc == true
		local head = on and ak.fighter and Game.fighterHead(ak.fighter) or nil
