	function Combat.farSpot(me: Vector3, fresh: boolean?): Vector3?
		if Combat.parkCsyncOn() then
			return Combat.parkSpot(me, fresh)
		end
		local now = os.clock()
		local capKey = Combat.voidKey()
		local distSet = math.min(cfg.voidSpamDist, (capKey and tonumber(cfg.voidFarCap[capKey])) or math.huge)
		local key = tostring(game.PlaceId) .. ":" .. tostring(distSet)
		local fc = Combat.farCache
		if not fresh and fc and fc.key == key and now - fc.at < 8 and fc.pos then
			return fc.pos
		end
		local box = S.safe.mapBox()
		local center = if box then (box.min + box.max) * 0.5 else me
		local half = if box then (box.max - box.min) * 0.5 else Vector3.new(500, 0, 500)
		local edge = math.max(half.X, half.Z)
		local y = math.max(me.Y + (if fresh then math.random() * 1400 - 200 else 0), S.fpdh() + 400)
		local last = Combat.farLast
		local best: Vector3? = nil
		local why: string? = nil
		local base = math.random() * math.pi * 2
		local W = Combat.FAR_WORLD
		for i = 0, Combat.FAR_TRIES - 1 do
			
			local ring = if i < 8 then 0 else 1 + math.floor((i - 8) / 4)
			local a = if ring == 0 then base + i * (math.pi / 4) else base + (i % 4) * (math.pi / 2) + ring * 0.7
			local cx, cz = math.cos(a), math.sin(a)
			local want = distSet * (if fresh then 0.7 + math.random() * 0.3 else 1)
			local dist = math.max(10000, want - ring * 5000) + edge
			
			local lim = math.huge
			if math.abs(cx) > 1e-3 then
				lim = math.min(lim, ((if cx > 0 then W else -W) - center.X) / cx)
			end
			if math.abs(cz) > 1e-3 then
				lim = math.min(lim, ((if cz > 0 then W else -W) - center.Z) / cz)
			end
			dist = math.min(dist, lim)
			local p = Vector3.new(center.X + cx * dist, y, center.Z + cz * dist)
			if dist >= 10000 and not (fresh and last and (p - last).Magnitude < Combat.FAR_GAP) then
				local ok, w = S.safe.check(p, Combat.farReq)
				if ok then
					best = p
					break
				end
				why = why or w
			end
		end
		Combat.farCache = { key = key, at = now, pos = best, why = why }
		if best then
			Combat.farLast = best
		end
		return best
	end
	
	
	
	Combat.HIDE_COST = {
		Auto = { transloc = 0, void = 0, slab = 20, far = 30 },
