			g:slider("Pip lifetime", "dmgDirSec", 0.4, 4, 0.1, { unit = "s", fmt = function(n: number): string
				return ("%.1f"):format(n)
			end })
			g:toggle("Self desync ghost", "selfGhost", { desc = "A dim wireframe where the server thinks your body is, while CSYNC or the anti-aim yaw has it somewhere else. Shows the server's spot during a CSYNC hold; yaw only otherwise, since a random fake position is never kept." })
			g:textbox("Priority names", "espPriority", { maxLen = 400, placeholder = "name, name" })
			g:color("Priority colour", "colEspPriority")
			local gr = UI.group(col, "Radar extras", { simple = true })
			gr:toggle("Rotate with view", "radarRotateView", { desc = "On: the radar turns with the camera. Off: north stays up." })
			gr:toggle("Facing arrows", "radarFacing", { desc = "A tail on each dot showing which way that player is facing." })
			gr:toggle("Height delta", "radarHeight", { desc = "Marks a dot more than ~10 st above or below you with the difference." })
			gr:toggle("Names", "radarNames", { desc = "Name under each dot." })
			gr:toggle("Teammate dots", "radarTeam", { desc = "Show teammates on the radar, in the ally colour." })
		end,
	})

	function Vis.drawRadar(enemies: { any })
		local cam = workspace.CurrentCamera
		local on = cfg.radar and cfg.esp and cam ~= nil
		if not on then
			if Vis.radarOn then
				Vis.radarOn = false
				Vis.off("_rbg")
				Vis.off("_rbd")
				Vis.off("_rcd")
				Vis.off("_rla")
				Vis.off("_rlb")
				Vis.arrsOff(Vis.radarDots, 1)
				Vis.hide("rf", 0)
				Vis.hide("rh", 0)
				Vis.hide("rn", 0)
				Vis.radarShown = 0
			end
			return
		end
		Vis.radarOn = true
		local bg = Vis.draw("_rbg", "Square")
		local bd = Vis.draw("_rbd", "Square")
		local cd = Vis.draw("_rcd", "Circle")
		local lnA, lnB = Vis.draw("_rla", "Line"), Vis.draw("_rlb", "Line")
		if not (bg and bd and cd and lnA and lnB) then
			return
		end
		local sv = Vis.sv
		local size = cfg.radarSize
		local origin = Vector2.new(cam.ViewportSize.X - size - 16, 64)
		local c = origin + Vector2.new(size / 2, size / 2)
		local sizeV = Vector2.new(size, size)
		sv(bg, "Position", origin)
		sv(bg, "Size", sizeV)
		sv(bg, "Color", Vis.RADAR_BG)
		sv(bg, "Filled", true)
		sv(bg, "Transparency", 0.75)
		sv(bg, "Visible", true)
		sv(bd, "Position", origin)
		sv(bd, "Size", sizeV)
		sv(bd, "Color", Vis.col("colEspVisible"))
		sv(bd, "Filled", false)
		sv(bd, "Thickness", 1)
		sv(bd, "Transparency", 0.9)
		sv(bd, "Visible", true)
		Vis.setLine(lnA, Vector2.new(c.X, origin.Y), Vector2.new(c.X, origin.Y + size), Vis.RADAR_GRID)
		Vis.setLine(lnB, Vector2.new(origin.X, c.Y), Vector2.new(origin.X + size, c.Y), Vis.RADAR_GRID)
		sv(cd, "Position", c)
		sv(cd, "Radius", 3)
		sv(cd, "Color", Vis.col("colText"))
		sv(cd, "Filled", true)
		sv(cd, "NumSides", 12)
		sv(cd, "Visible", true)
		local scale = (size / 2) / cfg.radarRange
		
		
		local heading = if cfg.radarRotateView == false then Vector3.new(0, 0, -1) else cam.CFrame.LookVector
		local fwd = Vector3.new(heading.X, 0, heading.Z)
		fwd = if fwd.Magnitude > 0.01 then fwd.Unit else Vector3.new(0, 0, -1)
		local right = Vector3.new(-fwd.Z, 0, fwd.X)
		local camPos = cam.CFrame.Position
		local colVisible, colHidden = Vis.col("colEspVisible"), Vis.col("colEsp")
		local colTeam, colPri, colTxt = Vis.col("colEspTeam"), Vis.col("colEspPriority"), Vis.col("colText")
		local showFace, showHt, showNames = cfg.radarFacing == true, cfg.radarHeight == true, cfg.radarNames == true
		local showTeam = cfg.radarTeam ~= false
		
		
		if showNames ~= Vis.radarNamesOn then
			Vis.radarNamesOn = showNames
			if not showNames then
				Vis.hideAll("rn")
			end
		end
		local priOn = Vis.priorityOn()
		local myRoot = Game.myRoot()
		local myY = if myRoot then myRoot.Position.Y else camPos.Y
		local lockModel = S.silentTargetModel
		local vis = Vis.visTbl
		local n = 0
		for _, f in ipairs(enemies) do
			local root, model = Game.fighterBody(f)
			if root then
				n += 1
				local d = Vis.radarDots[n]
				if d == nil then
					d = Vis.draw("r" .. n, "Circle") or false
					Vis.radarDots[n] = d
				end
				local mate = Game.isTeammate(f)
				local name = if showNames or priOn then Game.fighterName(f) else nil
				local pri = name ~= nil and Vis.priority(name)
				
				if d == nil or not (pri or showTeam or not mate) then
					if d then
						sv(d, "Visible", false)
					end
					
					
					Vis.off("rf" .. n)
					Vis.off("rh" .. n)
					Vis.off("rn" .. n)
				else
					local rel = root.Position - camPos
					local v = Vector2.new(rel.X * right.X + rel.Z * right.Z, -(rel.X * fwd.X + rel.Z * fwd.Z)) * scale
					if v.Magnitude > size / 2 - 4 then
						v = v.Unit * (size / 2 - 4)
					end
					local locked = model ~= nil and model == lockModel
					local dot = c + v
					local dcol = if locked then Vis.LOCK_COLOR elseif pri then colPri elseif mate then colTeam elseif model and vis[model] then colVisible else colHidden
					sv(d, "Position", dot)
					sv(d, "Radius", if locked then 4 else 3)
					sv(d, "Color", dcol)
					sv(d, "Filled", true)
					sv(d, "NumSides", 12)
					sv(d, "Visible", true)
					
					
					local fl = Vis.draw("rf" .. n, "Line")
					if fl then
						local lv = if showFace then root.CFrame.LookVector else nil
						local fd = if lv then Vector2.new(lv.X * right.X + lv.Z * right.Z, -(lv.X * fwd.X + lv.Z * fwd.Z)) else nil
						if fd and fd.Magnitude > 0.01 then
							Vis.setLine(fl, dot, dot + fd.Unit * 5, dcol, 1)
							sv(fl, "Transparency", 0.4)
						else
							sv(fl, "Visible", false)
						end
					end
					
					
					local ht = Vis.draw("rh" .. n, "Text")
					if ht then
						local dy = root.Position.Y - myY
						if showHt and math.abs(dy) > 10 then
							sv(ht, "Text", if dy > 0 then ("+%d"):format(math.floor(dy)) else ("-%d"):format(math.floor(-dy)))
							Vis.styleText(ht, 11, colTxt, false)
							sv(ht, "Position", Vector2.new(dot.X + 7, dot.Y - 8))
							sv(ht, "Transparency", 0.2)
							sv(ht, "Visible", true)
						else
							sv(ht, "Visible", false)
						end
					end
					if showNames then
						local nt = Vis.draw("rn" .. n, "Text")
						if nt then
							sv(nt, "Text", name or Game.fighterName(f))
							Vis.styleText(nt, 11, dcol, true)
							sv(nt, "Position", Vector2.new(dot.X, dot.Y - 9))
							sv(nt, "Transparency", 0.1)
							sv(nt, "Visible", true)
						end
					end
				end
			end
		end
		Vis.arrsOff(Vis.radarDots, n + 1)
		Vis.hide("rf", n)
		Vis.hide("rh", n)
		Vis.hide("rn", n)
		Vis.radarShown = n
	end

	
	Vis.HM_OFF = { Vector2.new(-1, -1), Vector2.new(1, -1), Vector2.new(-1, 1), Vector2.new(1, 1) }
	Vis.CROSS = {
		{ "_c1", Vector2.new(-7, 0), Vector2.new(-2, 0) }, { "_c2", Vector2.new(2, 0), Vector2.new(7, 0) },
		{ "_c3", Vector2.new(0, -7), Vector2.new(0, -2) }, { "_c4", Vector2.new(0, 2), Vector2.new(0, 7) },
	}
	Vis.HM_COLOR_OK, Vis.HM_COLOR = Color3.fromRGB(70, 220, 150), Color3.new(1, 1, 1)
	function Vis.fovRoll(now: number): number
		if cfg.fovRotate ~= true or S.featuresPaused then
			return 0
		end
		return math.rad(cfg.fovRoll or 0) + now * math.rad(cfg.fovSpin or 0)
	end
	
	
	function Vis.spinAngle(now: number): number?
		if cfg.fovRotate == true and not S.featuresPaused then
			return Vis.fovRoll(now)
		end
		if cfg.overlaySpin == true then
			return now * math.rad(cfg.fovSpin or 0)
		end
		return nil
	end
	
	
	Vis.RING_SEGS = 36
	Vis.ringUnit = table.create(Vis.RING_SEGS + 1)
	for i = 0, Vis.RING_SEGS do
		local t = i / Vis.RING_SEGS * 2 * math.pi
		Vis.ringUnit[i + 1] = Vector2.new(math.cos(t), math.sin(t))
	end
	Vis.ringSegOn = {}
	function Vis.gradientRing(key: string, show: boolean, center: Vector2, radius: number, c1: Color3, c2: Color3, turn: number, alpha: number)
		local n = Vis.RING_SEGS
		if not show then
			if Vis.ringSegOn[key] then
				Vis.ringSegOn[key] = nil
				for i = 1, n do
					Vis.off(key .. i)
				end
			end
			return
		end
		Vis.ringSegOn[key] = true
		local sv, unit = Vis.sv, Vis.ringUnit
		for i = 1, n do
			local ln = Vis.draw(key .. i, "Line")
			if ln then
				sv(ln, "Visible", true)
				sv(ln, "From", center + unit[i] * radius)
				sv(ln, "To", center + unit[i + 1] * radius)
				sv(ln, "Color", c1:Lerp(c2, 0.5 - 0.5 * math.cos((i - 0.5) / n * 2 * math.pi - turn)))
				sv(ln, "Thickness", 1)
				sv(ln, "Transparency", alpha)
			end
		end
	end
	Vis.fovRolled = false
	function Vis.applyFovRoll()
		local cam = workspace.CurrentCamera
		if not cam then
			return
		end
		local roll = Vis.fovRoll(os.clock())
		if roll == 0 and not Vis.fovRolled then
			return
		end
		Vis.fovRolled = roll ~= 0
		local cf = cam.CFrame
		local rx, ry = cf:ToOrientation()
		cam.CFrame = CFrame.new(cf.Position) * CFrame.fromOrientation(rx, ry, roll)
	end
	Vis.tagOrig = setmetatable({}, { __mode = "k" })
	Vis.nameOrig = setmetatable({}, { __mode = "k" })
	Vis.spoofAt = 0
	function Vis.spoofTick()
		local now = os.clock()
		if now - Vis.spoofAt < 0.5 then
			return
		end
		Vis.spoofAt = now
		local hideTags = cfg.hideNametags == true or cfg.streamerMode == true or (cfg.nameSpoof == true and cfg.nameSpoofMode == "Hide")
		local rename = cfg.nameSpoof == true or cfg.streamerMode == true
		for _, plr in ipairs(Players:GetPlayers()) do
			local char = plr.Character
			if plr ~= LP and char then
				local fake = if rename then Game.spoofedName({ Player = plr }) else nil
				local hum = char:FindFirstChildOfClass("Humanoid")
				if hum then
					if fake ~= nil and fake ~= "" and hum.DisplayName ~= fake then
						if Vis.nameOrig[hum] == nil then
							Vis.nameOrig[hum] = hum.DisplayName
						end
						hum.DisplayName = fake
					elseif fake == nil and Vis.nameOrig[hum] ~= nil then
						hum.DisplayName = Vis.nameOrig[hum]
						Vis.nameOrig[hum] = nil
					end
				end
				for _, d in ipairs(char:GetChildren()) do
					if d:IsA("BillboardGui") then
						if hideTags then
							if Vis.tagOrig[d] == nil then
								Vis.tagOrig[d] = d.Enabled
							end
							if d.Enabled then
								d.Enabled = false
							end
						elseif Vis.tagOrig[d] ~= nil then
							d.Enabled = Vis.tagOrig[d]
							Vis.tagOrig[d] = nil
						end
						if fake ~= nil and not hideTags then
							for _, t in ipairs(d:GetDescendants()) do
								if t:IsA("TextLabel") and (t.Text == plr.DisplayName or t.Text == plr.Name or Vis.nameOrig[t] ~= nil) then
									if Vis.nameOrig[t] == nil then
										Vis.nameOrig[t] = t.Text
									end
									local shown = if fake == "" then "" else fake
									if t.Text ~= shown then
										t.Text = shown
									end
								end
							end
						end
					end
				end
			end
		end
		if not rename and not hideTags then
			Vis.spoofRestore()
		end
	end
	
	
	
	function Vis.spoofRestore()
		for inst, prev in pairs(Vis.nameOrig) do
				local ok = pcall(function()
					if inst:IsA("TextLabel") then
						inst.Text = prev
					elseif inst:IsA("Humanoid") then
						inst.DisplayName = prev
					end
				end)
				
				
				
				
				if not ok then
					log("WARN", "name spoof: could not restore one instance, its name stays spoofed until respawn")
				end
			Vis.nameOrig[inst] = nil
		end
		for inst, was in pairs(Vis.tagOrig) do
			if not pcall(function()
				inst.Enabled = was
			end) then
				log("WARN", "name spoof: could not re-enable one nameplate")
			end
			Vis.tagOrig[inst] = nil
		end
	end
	function Vis.drawOverlay(accent: Color3, accent2: Color3)
		local cam = workspace.CurrentCamera
		if not cam then
			return
		end
		local sv = Vis.sv
		local center = cam.ViewportSize / 2
		
		
		
		local live = not S.featuresPaused
		local silentCircle = live and cfg.silentAim and Target.silentRadius() ~= math.huge
		local aimCircle = live and cfg.aimbot and not cfg.aimFov360
		local spin = Vis.spinAngle(os.clock())
		local grad = cfg.overlayGradient == true
		
		local fov = Vis.draw("_fov", "Circle")
		local showAim = cfg.showFov and (if cfg.fovLinked then (aimCircle or silentCircle) else aimCircle)
		local aimLocked = cfg.fovLinked and S.silentTarget ~= nil
		local aimSegs = showAim and grad and not aimLocked
		if fov then
			sv(fov, "Visible", showAim and not aimSegs)
			if showAim and not aimSegs then
				sv(fov, "Position", center)
				sv(fov, "Radius", if cfg.fovLinked then cfg.silentFov else cfg.aimFov)
				sv(fov, "NumSides", 64)
				sv(fov, "Color", if aimLocked then Vis.LOCK_COLOR elseif S.aimHeld then accent2 else accent)
				sv(fov, "Thickness", 1)
				sv(fov, "Filled", false)
				sv(fov, "Transparency", 0.8)
			end
		end
		Vis.gradientRing("_fovg", aimSegs == true, center, if cfg.fovLinked then cfg.silentFov else cfg.aimFov, accent, accent2, spin or 0, 0.8)
		local sfov = Vis.draw("_sfov", "Circle")
		local showSilent = silentCircle and cfg.showFov and not cfg.fovLinked
		local silentSegs = showSilent and grad and S.silentTarget == nil
		if sfov then
			sv(sfov, "Visible", showSilent and not silentSegs)
			if showSilent and not silentSegs then
				sv(sfov, "Position", center)
				sv(sfov, "Radius", cfg.silentFov)
				sv(sfov, "NumSides", 64)
				sv(sfov, "Color", if S.silentTarget then Vis.LOCK_COLOR else accent2)
				sv(sfov, "Thickness", 1)
				sv(sfov, "Filled", false)
				sv(sfov, "Transparency", 0.45)
			end
		end
		Vis.gradientRing("_sfovg", silentSegs == true, center, cfg.silentFov, accent2, accent, spin or 0, 0.45)
		
		local dir = if spin then Vector2.new(math.cos(spin), math.sin(spin)) else nil
		local tick = Vis.draw("_fovtick", "Line")
		if tick then
			local showTick = dir ~= nil and cfg.showFov == true and (aimCircle or silentCircle)
			sv(tick, "Visible", showTick)
			if showTick and dir then
				local radius = if cfg.fovLinked or not aimCircle then cfg.silentFov else cfg.aimFov
				sv(tick, "From", center + dir * (radius - 8))
				sv(tick, "To", center + dir * (radius + 6))
				sv(tick, "Color", accent)
				sv(tick, "Thickness", 2)
			end
		end
		local stick = Vis.draw("_sfovtick", "Line")
		if stick then
			local showTick = dir ~= nil and showSilent == true and aimCircle
			sv(stick, "Visible", showTick)
			if showTick and dir then
				sv(stick, "From", center + dir * (cfg.silentFov - 8))
				sv(stick, "To", center + dir * (cfg.silentFov + 6))
				sv(stick, "Color", accent2)
				sv(stick, "Thickness", 2)
			end
		end
		
		local rc, rs = math.cos(spin or 0), math.sin(spin or 0)
		local function arm(p: Vector2, q: Vector2): (Vector2, Vector2)
			if p.Magnitude > q.Magnitude then
				p, q = q, p
			end
			if spin then
				p = Vector2.new(p.X * rc - p.Y * rs, p.X * rs + p.Y * rc)
				q = Vector2.new(q.X * rc - q.Y * rs, q.X * rs + q.Y * rc)
			end
			return p, q
		end
		local dot = Vis.draw("_cdot", "Circle")
		local ring = Vis.draw("_cring", "Circle")
		local show = cfg.crosshair
		local sz = (cfg.crosshairSize or 1) * 7
		local style = cfg.crosshairStyle or "Classic"
		if dot then
			sv(dot, "Visible", show and (style == "Dot" or style == "Circle"))
			if show and (style == "Dot" or style == "Circle") then
				sv(dot, "Position", center)
				sv(dot, "Radius", if style == "Dot" then math.max(2, sz * 0.35) else sz)
				sv(dot, "Filled", style == "Dot" or style == "Circle")
				sv(dot, "Color", accent)
				sv(dot, "Thickness", 1)
				sv(dot, "NumSides", if style == "Circle" then 48 else 12)
			end
		end
		if ring and style == "Circle" then
			sv(ring, "Visible", show)
			if show then
				sv(ring, "Position", center)
				sv(ring, "Radius", sz)
				sv(ring, "Filled", false)
				sv(ring, "Color", accent)
				sv(ring, "Thickness", 1)
				sv(ring, "NumSides", 48)
			end
		elseif ring then
			sv(ring, "Visible", false)
		end
		local outlined = show and style == "Outlined"
		
		local classic = show and (style == "Classic" or style == "Cross")
		local scale = cfg.crosshairSize or 1
		for _, seg in ipairs(Vis.CROSS) do
			local ln = Vis.draw(seg[1], "Line")
			local tip = Vis.draw(seg[1] .. "g", "Line")
			local p, q = arm(seg[2] * scale, seg[3] * scale)
			local mid = (p + q) / 2
			
			local thick = if style == "Cross" then 3 else 2
			if ln then
				sv(ln, "Visible", classic)
				if classic then
					sv(ln, "From", center + p)
					sv(ln, "To", center + (if grad then mid else q))
					sv(ln, "Color", accent)
					sv(ln, "Thickness", thick)
				end
			end
			if tip then
				sv(tip, "Visible", classic and grad)
				if classic and grad then
					sv(tip, "From", center + mid)
					sv(tip, "To", center + q)
					sv(tip, "Color", accent2)
					sv(tip, "Thickness", thick)
				end
			end
		end
		
		local gap = 4 * scale
		local len = 10 * scale
		local arms = if outlined then {
			{ Vector2.new(0, -gap), Vector2.new(0, -gap - len) },
			{ Vector2.new(0, gap), Vector2.new(0, gap + len) },
			{ Vector2.new(-gap, 0), Vector2.new(-gap - len, 0) },
			{ Vector2.new(gap, 0), Vector2.new(gap + len, 0) },
		} else nil
		for i = 1, 4 do
			local out = Vis.draw("_ko" .. i, "Line")
			local ln = Vis.draw("_ka" .. i, "Line")
			local tip = Vis.draw("_kg" .. i, "Line")
			local spec = arms and arms[i]
			local p, q = Vector2.zero, Vector2.zero
			if spec then
				p, q = arm(spec[1], spec[2])
			end
			local mid = (p + q) / 2
			if out then
				sv(out, "Visible", spec ~= nil)
				if spec then
					sv(out, "From", center + p)
					sv(out, "To", center + q)
					sv(out, "Color", Color3.new(0, 0, 0))
					sv(out, "Thickness", 3)
				end
			end
			if ln then
				sv(ln, "Visible", spec ~= nil)
				if spec then
					sv(ln, "From", center + p)
					sv(ln, "To", center + (if grad then mid else q))
					sv(ln, "Color", accent)
					sv(ln, "Thickness", 1)
				end
			end
			if tip then
				sv(tip, "Visible", spec ~= nil and grad)
				if spec and grad then
					sv(tip, "From", center + mid)
					sv(tip, "To", center + q)
					sv(tip, "Color", accent2)
					sv(tip, "Thickness", 1)
				end
			end
		end
		local relLeft = (S.reloadUntil or 0) - os.clock()
		local showRel = cfg.reloadIndicator == true and relLeft > 0
		local relBar = Vis.draw("_rbar", "Line")
		local relRing = Vis.draw("_rring", "Circle")
		local relTxt = Vis.draw("_rtxt", "Text")
		local styleRel = cfg.reloadIndicatorStyle or "Bar"
		if relBar then
			sv(relBar, "Visible", showRel and styleRel == "Bar")
			if showRel and styleRel == "Bar" then
				local w = 36 * math.clamp(relLeft / 2.5, 0.08, 1)
				sv(relBar, "From", center + Vector2.new(-18, 16))
				sv(relBar, "To", center + Vector2.new(-18 + w, 16))
				sv(relBar, "Color", accent)
				sv(relBar, "Thickness", 3)
			end
		end
		if relRing then
			sv(relRing, "Visible", showRel and styleRel == "Ring")
			if showRel and styleRel == "Ring" then
				sv(relRing, "Position", center)
				sv(relRing, "Radius", 18)
				sv(relRing, "Thickness", 2)
				sv(relRing, "Filled", false)
				sv(relRing, "Color", accent)
				sv(relRing, "Transparency", math.clamp(relLeft / 2.5, 0.25, 1))
			end
		end
		if relTxt then
			sv(relTxt, "Visible", showRel and styleRel == "Text")
			if showRel and styleRel == "Text" then
