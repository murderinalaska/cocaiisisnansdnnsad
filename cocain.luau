		local function lerp3(a: { number }, b: { number }, t: number): { number }
			t = clamp(t, 0, 1)
			mix[1], mix[2], mix[3] = a[1] + (b[1] - a[1]) * t, a[2] + (b[2] - a[2]) * t, a[3] + (b[3] - a[3]) * t
