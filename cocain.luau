	function Combat.hideWhere(spot: any): string
		if spot.kind == "sky" then
			return ("in sky void Y %.0f"):format(spot.pos.Y)
		elseif spot.kind == "transloc" then
			local p = spot.part
			return ("translocated under %s (%.1f s kill volume, %.1f st clear)"):format(if p then p.Name else "a kill volume", if p then S.bounds.budget(p) else 0, S.bounds.clearance(spot.pos))
