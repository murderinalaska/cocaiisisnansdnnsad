	Combat.breakReq = { hold = 0.3, geometry = false, void = false, refGround = nil }
	function Combat.breakerSpot(target: Vector3): Vector3?
		local Sf = S.safe
		local g = Sf.groundY(target)
		Combat.breakReq.refGround = g
		for _ = 1, 5 do
			local a = math.random() * 2 * math.pi
			local r = 12 + math.random() * 12
			local base = target + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
			local gy = Sf.groundY(base)
			if gy then
				local p = Vector3.new(base.X, gy + 3 + math.random() * 3, base.Z)
				if Sf.check(p, Combat.breakReq) then
					return p
				end
			end
		end
		return nil
	end
	
	
	
	
	
	
	
	
	function Combat.hurtHide(now: number, f: any): boolean
		if not (cfg.autokillHvh and S.hurtAt and now - S.hurtAt < 0.6) then
			return false
		end
		if f ~= nil and Combat.killable(f) then
			return false
		end
		
		
		if now - (Combat.hurtHideStart or -10) >= 1.5 then
			Combat.hurtHideStart = now
		end
		if now - Combat.hurtHideStart >= 0.6 then
			return false
		end
		if now - (Combat.hurtLogAt or 0) > 2 then
			Combat.hurtLogAt = now
			log("INFO", ("[autokill:hurt] took %.0f on the spot — hiding before the next round"):format(S.hurtAmount or 0))
		end
		return true
	end
	function Combat.akHvhSpot(now: number, origin: Vector3, aim: Vector3): (Vector3?, string?)
		local left = Combat.cannotFireFor(S.gameState)
		local back = Combat.fireLead()
		if left <= back and not Combat.hurtHide(now, ak.fighter) then
			if ak.hvh then
				ak.hvh = nil
				ak.faceSince = now 
			end
			return nil, nil
		end
		local hv = ak.hvh
		if not hv then
			hv = { since = now, hopAt = 0, spot = nil, kind = nil }
			ak.hvh = hv
			log("DEBUG", ("[autokill:hvh] gun busy %.2f s → hide + spin (body %s)"):format(left, Combat.body.owner or "you"))
		end
		if not hv.spot or (cfg.defenseVoidSpam and now - hv.hopAt >= 1 / math.max(cfg.defenseHopHz, 1)) then
			local c = Combat.pickHide(origin, Game.targets())
			if cfg.rageBreaker and not c then
				local b = Combat.breakerSpot(aim)
				if b then
					c = { pos = b, kind = "break" }
				end
			end
			if c then
				hv.spot, hv.kind, hv.hopAt = c.pos, c.kind, now
			end
		end
		return hv.spot, hv.kind
	end
	
	
	
	Combat.akOriginOpts = { holdSec = 0.5, noclip = true }
	function Combat.akOriginStep(head: BasePart, model: Model?, f: any, now: number)
		local part = S.silentPart
		local aimPart = if typeof(part) == "Instance" and part.Parent then part else head
		local aim = aimPart.Position
		Combat.akOriginOpts.holdSec = 0.5
		Combat.akOriginOpts.noclip = true
		local origin = Combat.origin.plan(aim, model, aimPart, Combat.akOriginOpts)
		ak.originLast = origin
		
		local hide, kind = nil, nil
		if cfg.autokillHvh and Combat.rageOn() then
			hide, kind = Combat.akHvhSpot(now, origin, aim)
		end
		ak.hiding = hide ~= nil
		if hide then
			local r = Combat.akReq
			r.pin, r.turnCam = not cfg.autokillVisible, cfg.autokillVisible
			r.key, r.jump, r.velocity, r.jumpDist = hide, false, nil, nil
			
			r.sky, r.void, r.far, r.geometry = kind == "sky", kind == "void" or kind == "slab" or kind == "transloc", kind == "far" or kind == "transloc", false
			r.budget = kind == "slab"
			r.refGround = if kind == "break" then ak.refGround else nil
			Combat.akTranslocOpts(r, false)
			r.hold = if kind == "slab" then 0.25 else 0.5
			Combat.body.request("autokill", hide, aim, r)
			ak.originSettled = false
			
			S.preFaceFrom = origin + Vector3.new(0, 1.85, 0)
			S.preFace = Combat.cannotFireFor(S.gameState) <= Combat.fireLead() + Combat.echoLead()
			return
		end
		
		
		
		if ak.forceHop then
			ak.forceHop = nil
			Combat.magicJit.force = true
		end
		local off = Combat.magicJitterOffset(aim, origin, model)
		if not cfg.magicJitter then
			off = Vector3.new(math.sin(now * 15) * 0.5, -math.abs(math.sin(now * 11 + 1)) * 0.2, math.cos(now * 13) * 0.5)
		end
		Combat.akRequest(origin + off, aim, origin, false, nil, nil)
		
		ak.originSettled = Combat.body.settledFor("autokill")
		ak.hopSettled = S.magicHopSettled ~= false
	end
	
	
	
	
	
	function Combat.akSnapStep(head: BasePart, model: Model?, f: any, now: number)
		local settle = Combat.settleSec()
		local left = Combat.cannotFireFor(S.gameState)
		if ak.snapPhase == "rest" then
			if now - (ak.snapPhaseAt or 0) < 0.12 or left > settle + 0.02 then
				ak.originSettled = false
				return
			end
			ak.snapPhase = nil
		end
		if ak.snapPhase == nil then
			ak.snapPhase, ak.snapPhaseAt, ak.snapPulses = "strike", now, S.pulses or 0
		end
		Combat.akOriginStep(head, model, f, now)
		local shot = (S.pulses or 0) > (ak.snapPulses or 0)
		if (shot and left > settle * 2 + 0.1) or now - ak.snapPhaseAt > cfg.autokillSnapHold + settle then
			ak.snapPhase, ak.snapPhaseAt = "rest", now
			ak.snapStrikes = (ak.snapStrikes or 0) + 1
			Combat.body.release("autokill")
		end
	end
	
	
	
	
	
	
	
	Combat.DESYNC_EYE = 1.85 
	Combat.DESYNC_GRACE = 0.6
	function Combat.desyncSpot(f: any, part: BasePart, model: Model?, mode: string): (Vector3?, string?)
		local root = Game.fighterBody(f)
		if not root then
			return nil, nil
		end
		local me = S.myRootPart
		local home = if Combat.body.home then Combat.body.home.Position elseif me then me.Position else nil
		local side = if home then (home - root.Position) * Vector3.new(1, 0, 1) else Vector3.zero
		side = if side.Magnitude > 0.1 then side.Unit else Vector3.new(0, 0, 1)
		local col = Vector3.new(root.Position.X, 0, root.Position.Z) + side * 1.2
		if mode == "High" then
			if cfg.highSearch then
				return Combat.highSpot(root, part, model, col)
			end
			local base = ak.refGround or root.Position.Y
			local y = math.min(root.Position.Y + cfg.autokillHighDist, base + cfg.safeMaxHeight - 0.5)
			if y < root.Position.Y + 4 then
				return nil, nil
			end
			local spot = Vector3.new(col.X, y, col.Z)
			if Game.rayVisible(model, part, spot + Vector3.new(0, Combat.DESYNC_EYE, 0)) then
				return spot, "high"
			end
			return nil, nil
		end
		if cfg.underMeasure then
			local spot = Combat.underSpot(root, col)
			if spot then
				return spot, "under"
			end
		end
		return Vector3.new(col.X, root.Position.Y - cfg.autokillUnderDist, col.Z), "under"
	end
	
	function Combat.mapRay(origin: Vector3, dir: Vector3): RaycastResult?
		local params = Game.losParams()
		if not params then
			return nil
		end
		local len = dir.Magnitude
		if len < 1e-3 then
			return nil
		end
		local u = dir / len
		local from, left = origin, len
		for _ = 1, 5 do
			local hit = workspace:Raycast(from, u * left, params)
			if not hit then
				return nil
			end
			local inst = hit.Instance
			local char = LP.Character
			if not (S.bounds.isEnemyInstance(inst) or (char and inst:IsDescendantOf(char))) then
				return hit
			end
			local step = (hit.Position - from).Magnitude + 0.05
			from, left = from + u * step, left - step
			if left <= 0 then
				return nil
			end
		end
		return nil
	end
	
	
	function Combat.highSpot(root: BasePart, part: BasePart, model: Model?, col: Vector3): (Vector3?, string?)
		local rp = root.Position
		local eye = Vector3.new(0, Combat.DESYNC_EYE, 0)
		local base = ak.refGround or rp.Y
		local top = math.min(rp.Y + cfg.autokillHighDist, base + cfg.safeMaxHeight - 0.5)
		local roof = Combat.mapRay(rp + Vector3.new(0, 3, 0), Vector3.new(0, cfg.autokillHighDist + 2, 0))
		ak.highRoof = roof ~= nil
		if roof then
			top = math.min(top, roof.Position.Y - cfg.highCeilingGap - Combat.DESYNC_EYE)
		end
		local low = rp.Y + math.min(cfg.highMinDist, math.max(top - rp.Y, 0))
		if top < rp.Y + 4 then
			return nil, nil
		end
		local window = Combat.cannotFireFor(S.gameState) <= Combat.settleSec() + 0.05
		local function stumble(p: Vector3): Vector3
			if window or cfg.highStumble <= 0 then
				return p
			end
			local t = os.clock() * 1.7
			local a = cfg.highStumble
			return p + Vector3.new(math.noise(t, 2.1) * a, math.noise(t, 6.3) * a * 0.5, math.noise(t, 9.7) * a)
		end
		if cfg.highSticky and ak.highSpot then
			local s = rp + ak.highSpot
			if s.Y <= top + 0.01 and Game.rayVisible(model, part, s + eye) then
				return stumble(s), "high"
			end
			ak.highSpot = nil
		end
		local nb, nh = math.max(1, cfg.highBearings), math.max(1, cfg.highHeights)
		local a0 = math.random() * math.pi * 2
		for hi = 0, nh - 1 do
			local y = if nh == 1 then top else top - (top - low) * hi / (nh - 1)
			for bi = 0, nb do
				local p
				if bi == 0 then
					p = Vector3.new(col.X, y, col.Z)
				else
					local a = a0 + (bi - 1) * (2 * math.pi / nb)
					p = Vector3.new(rp.X + math.cos(a) * cfg.highRing, y, rp.Z + math.sin(a) * cfg.highRing)
				end
				if Game.rayVisible(model, part, p + eye) then
					ak.highSpot = p - rp
					ak.highIdx = hi * (nb + 1) + bi
					return stumble(p), "high"
				end
			end
		end
		return nil, nil
	end
	
	
	function Combat.slabUnder(pos: Vector3): any
		local down = Combat.mapRay(pos + Vector3.new(0, 1, 0), Vector3.new(0, -24, 0))
		if not down then
			return nil
		end
		local topY = down.Position.Y
		local up = Combat.mapRay(Vector3.new(pos.X, topY - 14, pos.Z), Vector3.new(0, 14 - 0.02, 0))
		local bottomY = if up then up.Position.Y else topY - 14
		local layers = 1
		if Combat.mapRay(Vector3.new(pos.X, bottomY - 0.05, pos.Z), Vector3.new(0, -6, 0)) then
			layers = 2
		end
		return { top = topY, bottom = bottomY, thick = topY - bottomY, layers = layers, part = down.Instance }
	end
	
	
	
	function Combat.underSpot(root: BasePart, col: Vector3): Vector3?
		local rp = root.Position
		local prof = ak.profile or Game.weaponProfile()
		local radius = if prof and prof.pellets and prof.pellets > 1 then math.min(cfg.underShotgunRadius, cfg.underColumnRadius) else cfg.underColumnRadius
		local function place(x: number, z: number): Vector3?
			local slab = Combat.slabUnder(Vector3.new(x, rp.Y, z))
			if not slab or slab.layers > 1 or slab.thick > cfg.underMaxSlab then
				return nil
			end
			ak.underSlab = slab
			return Vector3.new(x, slab.top - cfg.underInSlab - Combat.DESYNC_EYE, z)
		end
		if cfg.underSticky and ak.underCol then
			local p = place(rp.X + ak.underCol.X, rp.Z + ak.underCol.Z)
			if p then
				return p
			end
			ak.underCol = nil
		end
		local cands = { Vector3.new(col.X - rp.X, 0, col.Z - rp.Z) }
		local n = math.max(1, cfg.underColumns)
		local a0 = math.random() * math.pi * 2
		for i = 0, n - 1 do
			local a = a0 + i * (2 * math.pi / n)
			table.insert(cands, Vector3.new(math.cos(a) * radius, 0, math.sin(a) * radius))
		end
		for _, off in ipairs(cands) do
			local p = place(rp.X + off.X, rp.Z + off.Z)
			if p then
				ak.underCol = off
				return p
			end
		end
		return nil
	end
	function Combat.akDesyncStep(head: BasePart, model: Model?, f: any, now: number)
		local part = S.silentPart
		local aimPart = if typeof(part) == "Instance" and part.Parent then part else head
		local aim = aimPart.Position
		local spot, kind = Combat.desyncSpot(f, aimPart, model, ak.mode)
		ak.hiding = false
		local root = Game.fighterBody(f)
		if not spot and root and ak.desyncRel and now - (ak.desyncOkAt or 0) < Combat.DESYNC_GRACE then
			spot, kind = root.Position + ak.desyncRel, ak.desyncRelKind
		end
		if spot then
			local r = Combat.akReq
			r.pin, r.turnCam = not cfg.autokillVisible, cfg.autokillVisible
			
			r.key, r.jump, r.velocity, r.jumpDist = nil, false, nil, 3
			r.sky, r.far = false, false
			r.void = kind == "under"
			r.budget = kind == "under"
			r.geometry = kind == "under"
			r.refGround = ak.refGround
			Combat.akTranslocOpts(r, true)
			r.hold = 0.4
			if kind == "under" then
				
				Combat.noclip.rage(0.6)
			end
			if Combat.body.request("autokill", spot, aim, r) then
				if ak.desyncKind ~= kind and now - (ak.desyncLogAt or 0) > 1 then
					ak.desyncLogAt = now
					log("INFO", ("[autokill:%s] riding %s %s"):format(kind, if kind == "under" then "inside the floor under" else "over the head of", Game.fighterName(f)))
				end
				ak.desyncKind = kind
				if root then
					ak.desyncRel, ak.desyncRelKind, ak.desyncOkAt = spot - root.Position, kind, now
				end
				
				S.preFaceFrom = spot + Vector3.new(0, Combat.DESYNC_EYE, 0)
				S.preFace = true
				ak.originSettled = Combat.body.settledFor("autokill")
				return
			end
		end
		if ak.desyncKind ~= nil and now - (ak.desyncLogAt or 0) > 1 then
			ak.desyncLogAt = now
			log("DEBUG", ("[autokill:%s] no spot here → Origin's plan"):format(string.lower(ak.mode)))
		end
		ak.desyncKind = nil
		Combat.akOriginStep(head, model, f, now)
	end
	
	function Combat.akSetup(target: any): any
		local prof = Game.weaponProfile()
		ak.profile = prof
		ak.behind = prof.melee and (cfg.autoBackstabAnyMelee or Combat.critMelee(prof.item))
		local speedMult
		ak.radius, ak.height, speedMult = Combat.akGeometry(prof, target)
		ak.speed = math.min(cfg.autokillOrbitSpeed * speedMult, cfg.autokillMaxSpeed / math.max(ak.radius, 1))
		return prof
	end
	function Combat.startAutokill(enemies: { any }?): boolean
		enemies = enemies or Game.targets()
		if ak.state ~= "idle" and ak.state ~= "done" then
			return false
		end
		if S.calibrating then
			return false
		end
		if not Combat.rageOn() then
			log("INFO", "[autokill:skip:rage-off] positioning is None — pick a rage position first")
			notify("autokill needs a rage position (Ragebot → Positioning)", 3, "warn")
			return false
		end
		local me = Game.myRoot()
		if not me then
			log("WARN", "autokill: no character")
			notify("autokill: no character", 3, "warn")
			return false
		end
		local myHp = Game.myHealth()
		local gs0 = Game.state()
		if (myHp ~= nil and myHp <= 0) or gs0.alive == false or gs0.item == nil then
			log("WARN", "autokill: not alive / no weapon out — not starting")
			notify("autokill: you are dead or have no weapon out", 2, "warn")
			return false
		end
		if gs0.locked then
			log("INFO", "autokill: items locked (round start) — not starting")
			notify("autokill: the round has not started yet", 2, "warn")
			return false
		end
		
		if cfg.gluebotCounter and cfg.counterSpawnHold and Game.fighterImmune(Game.localFighter()) and Combat.cannotFireFor(gs0) > Combat.fireLead() then
			return false
		end
		local best, bestD = Combat.pickAutokillTarget(enemies, nil)
		if not best then
			local anyone = Target.nearest(enemies)
			log("WARN", if anyone then "autokill: every enemy is dead or immune" else "autokill: no enemies in list")
			notify(if anyone then "autokill: everyone is spawn-protected right now" else "autokill: no enemies", 3, "warn")
			return false
		end
		ak.fighter = best
		ak.char = LP.Character 
		local prof = Combat.akSetup(best)
		
		
		local sky = cfg.voidHeights[tostring(game.PlaceId)]
		ak.restY, ak.restKind = Combat.voidY(), "void"
		if ak.restY == nil and cfg.defenseMode == "Sky" and Combat.skyOk(sky) then
			ak.restY, ak.restKind = sky, "sky"
		end
		ak.voidBlockedLogged = nil
		ak.burstFrom, ak.burstPulses, ak.nextAngle = nil, nil, nil
		ak.originAt, ak.originLast, ak.originSettled, ak.hopSettled = nil, nil, false, nil
		ak.snapPhase, ak.snapPhaseAt, ak.snapStrikes, ak.refusedSince = nil, nil, 0, nil
		ak.desyncKind, ak.buriedTop = nil, nil
		ak.highSpot, ak.underCol, ak.underSlab, ak.highRoof = nil, nil, nil, nil
		ak.mode, ak.modeWhy = Combat.akPickMode(best, prof)
		ak.comboClass = Combat.comboClass(prof)
		log("INFO", ("[autokill:mode] %s · %s"):format(ak.mode, ak.modeWhy))
		local now = os.clock()
		ak.startedAt = now
		
		local runFor = if cfg.autokillUntilDead or (tonumber(cfg.autokillDuration) or 0) >= 61 then 1e6 else cfg.autokillDuration
		ak.until_ = now + runFor
		ak.maxUntil = now + runFor * 2 
		ak.phaseUntil = now + cfg.voidBurst
		ak.angle = math.random() * math.pi * 2
		ak.lastTick = now
		ak.hits = 0
		ak.hitBase = S.shotStats.hitTarget
		ak.statBase = table.clone(S.shotStats)
		ak.targetHp0 = Game.fighterHealth(best)
		ak.lastHp = ak.targetHp0
		ak.lastProgressAt = now
		ak.myHpLast = myHp
		ak.myHpAt = now
		ak.immuneSince = nil
		ak.emptySince = nil
		ak.chained = 0
		ak.firingFrames, ak.frames = 0, 0
		ak.firing = false
		ak.state = "snap"
		local name = Game.fighterName(best)
		log("INFO", ("autokill: snap → %s (%.0fm) weapon %s (%s) r %.1f h %.1f mode %s%s"):format(name, bestD, prof.name, if prof.melee then "melee" elseif prof.pellets > 1 then "shotgun" else "gun", ak.radius, ak.height, ak.mode, if cfg.autokillAdaptive then " adaptive" else ""))
		notify("AUTOKILL → " .. name, 2, "rage")
		Combat.updateAutokill(enemies)
		return true
	end
	
	function Combat.retargetAutokill(enemies: { any }, why: string): boolean
		if not cfg.autokillChain then
			return false
		end
		local now = os.clock()
		if now > (ak.maxUntil or ak.until_) then
			return false
		end
		local nextF, d = Combat.pickAutokillTarget(enemies, ak.fighter)
		if not nextF then
			return false
		end
		if Game.weaponProfile().item == nil then
			return false
		end
		Combat.akSetup(nextF)
		ak.fighter = nextF
		ak.targetHp0 = Game.fighterHealth(nextF)
		ak.lastHp = ak.targetHp0
		ak.lastProgressAt = now
		ak.originAt, ak.originLast, ak.originSettled = nil, nil, false
		ak.snapPhase, ak.snapPhaseAt, ak.refusedSince, ak.nextAngle = nil, nil, nil, nil
		ak.immuneSince = nil
		ak.until_ = math.min(math.max(ak.until_, now + math.min(cfg.autokillDuration, 2.5)), ak.maxUntil or ak.until_)
		ak.chained = (ak.chained or 0) + 1
		ak.state = "snap"
		local name = Game.fighterName(nextF)
		log("INFO", ("autokill: %s → next target %s (%.0fm)"):format(why, name, d))
		notify("AUTOKILL → " .. name, 1.5, "rage")
		return true
	end

	function Combat.stopAutokill(reason: string)
		if ak.state == "idle" or ak.state == "done" then
			return
		end
		ak.state = "return"
		ak.firing = false
		ak.hiding, ak.hvh, ak.faceSince = false, nil, nil
		ak.glueFrames, ak.glueState, ak.parkAnchor = 0, nil, nil
		if Combat.hvh then
			pcall(Combat.hvh.unglue, "autokill stopped")
		end
		ak.buriedTop = nil
		Combat.releaseFire()
		
		
		Combat.body.release("autokill", not cfg.autokillReturn)
		ak.state = "done"
		ak.doneAt = os.clock()
		ak.reason = reason
		S.lastAutokillEnd = os.clock()
		local b = ak.statBase or S.shotStats
		local ss = S.shotStats
		local hpNow = ak.fighter and Game.fighterHealth(ak.fighter)
		log("INFO", ("autokill: done (%s) — %.1fs · trigger down %d/%d frames (%s) · redirected %d · hit %d · blocked %d · air %d · confirmed %d · dropped %d · target hp %s → %s"):format(
			reason, os.clock() - (ak.startedAt or os.clock()), ak.firingFrames or 0, ak.frames or 0, Input.fireMethodUsed,
			ss.redirected - (b.redirected or 0), ss.hitTarget - (b.hitTarget or 0), ss.hitOther - (b.hitOther or 0), ss.miss - (b.miss or 0), ss.confirmed - (b.confirmed or 0), ss.dropped - (b.dropped or 0),
			tostring(ak.targetHp0 and math.floor(ak.targetHp0)), tostring(hpNow and math.floor(hpNow))
		))
		notify(("autokill done · %s · %d hits"):format(reason, ak.hits or 0), 2.5, "rage")
		ak.fighter = nil
	end

	function Combat.updateAutokill(enemies: { any })
		local now = os.clock()
		if ak.state == "done" then
			if now - (ak.doneAt or 0) > 1.2 then
				ak.state = "idle"
			end
			return
		end
		if ak.state == "idle" then
			
			if cfg.autokill and cfg.autokillAuto and Combat.rageOn() and not S.menuOpen and not S.calibrating and now - (S.lastAutokillEnd or 0) > cfg.autokillCooldown and now >= (S.autokillCooldownUntil or 0) and now - (ak.autoTryAt or 0) > 0.15 then
				ak.autoTryAt = now
				
				local gs0 = S.gameState
				local myHp = Game.myHealth()
				
				if gs0 and gs0.alive ~= false and gs0.item ~= nil and not gs0.locked and not (myHp ~= nil and myHp <= 0) then
					local pick, d = Combat.pickAutokillTarget(enemies, nil)
					if pick and d <= cfg.autokillAutoRange then
						Combat.startAutokill(enemies)
					end
				end
			end
			return
		end
		if not Combat.rageOn() then
			Combat.stopAutokill("rage off")
			return
		end
		local f = ak.fighter
		local head = f and Game.fighterHead(f)
		local hp = f and Game.fighterHealth(f)
		if not head or (hp ~= nil and hp <= 0) or (f and Target.isDead(f)) then
			local why = if hp ~= nil and hp <= 0 then "target dead" else "target lost"
			if Combat.retargetAutokill(enemies, why) then
				f = ak.fighter
				head = Game.fighterHead(f)
				hp = Game.fighterHealth(f)
			else
				Combat.stopAutokill(why)
				return
			end
		end
		
		
		if hp ~= nil then
			if ak.lastHp == nil or hp < ak.lastHp - 0.5 then
				ak.lastProgressAt = now
				if cfg.autokillAdaptive and now > ak.until_ - 0.6 then
					ak.until_ = math.min(ak.until_ + 1.2, ak.maxUntil or ak.until_)
				end
			end
			ak.lastHp = hp
		end
		
		
		
		if ak.hiding or Combat.cannotFireFor(S.gameState) > 0 then
			ak.lastProgressAt = now
		end
		if cfg.autokillAdaptive and ak.state == "orbit" and now - (ak.lastProgressAt or now) > 2.5 and now - (ak.snapAt or now) > 1.2 then
			if not Combat.retargetAutokill(enemies, "no progress") then
				Combat.stopAutokill("no progress")
				return
			end
		end
		
		
		local _, akModel = Game.fighterBody(f)
		
		if akModel and Resolver.away(akModel) and ak.mode ~= "Glue" then
			ak.awaySince = ak.awaySince or now
			if now - ak.awaySince > 1 then
				ak.awaySince = nil
				Combat.akSkip[f] = now + 3
				if not Combat.retargetAutokill(enemies, "target warped away") then
					Combat.stopAutokill("target warped away")
					return
				end
				f = ak.fighter
				head = f and Game.fighterHead(f)
				if not head then
					return
				end
			end
		else
			ak.awaySince = nil
		end
		if now > ak.until_ then
			Combat.stopAutokill(if (ak.chained or 0) > 0 then ("timeout · %d chained"):format(ak.chained) else "timeout")
			return
		end
		if S.menuOpen then
			Combat.stopAutokill("menu")
			return
		end
		
		
		
		if ak.char ~= nil and LP.Character ~= ak.char then
			Combat.stopAutokill("respawned")
			return
		end
		
		local immune = cfg.immuneCheck and Game.fighterImmune(f)
		if immune then
			ak.immuneSince = ak.immuneSince or now
			if now - ak.immuneSince > 1.2 then
				if not Combat.retargetAutokill(enemies, "target immune") then
					Combat.stopAutokill("target immune")
					return
				end
				immune = false
			end
		else
			ak.immuneSince = nil
		end
		local myHp, myMax = Game.myHealth()
		if myHp == nil and ak.myHpLast ~= nil then
			Combat.stopAutokill("died") 
			return
		end
		if myHp and myMax and myMax > 0 then
			if myHp <= 0 then
				Combat.stopAutokill("died")
				return
			end
			if myHp / myMax < cfg.autokillAbortHp / 100 then
				Combat.stopAutokill(("low hp %d%%"):format(math.floor(myHp / myMax * 100)))
				S.autokillCooldownUntil = now + 3 
				return
			end
			
			if cfg.autokillAdaptive and ak.myHpLast and myHp < ak.myHpLast - 12 then
				ak.forceHop = true
			end
			if now - (ak.myHpAt or 0) > 0.5 then
				ak.myHpLast, ak.myHpAt = myHp, now
			end
		end
		
		local gsNow = S.gameState
		if gsNow and gsNow.ammo ~= nil and gsNow.ammo <= 0 then
			ak.emptySince = ak.emptySince or now
			if now - ak.emptySince > 3 then
				Combat.stopAutokill("no ammo")
				return
			end
		else
			ak.emptySince = nil
		end
		
		local profNow = Game.weaponProfile()
		if profNow.item and Combat.comboClass(profNow) ~= ak.comboClass and now - (ak.modeAt or 0) > 0.3 then
			ak.modeAt = now
			Combat.akSetup(f)
			local old = ak.mode
			ak.mode, ak.modeWhy = Combat.akPickMode(f, profNow)
			ak.comboClass = Combat.comboClass(profNow)
			if ak.mode ~= old then
				ak.desyncKind, ak.desyncRel, ak.highSpot, ak.underSpot = nil, nil, nil, nil
				log("INFO", ("[autokill:mode] swap to %s -> %s · %s"):format(profNow.name, ak.mode, ak.modeWhy))
			end
		end
		local dt = math.clamp(now - (ak.lastTick or now), 0, 0.1)
		ak.lastTick = now
		local _, model = Game.fighterBody(f)
		ak.hits = math.max(0, S.shotStats.hitTarget - (ak.hitBase or 0))
		
		
		ak.refGround = S.safe.groundY(head.Position)
		
		ak.buriedTop = S.bounds.buriedTop(model)
		if ak.buriedTop then
			ak.refGround = ak.buriedTop
		end
		
		
		if ak.refGround == nil then
			local troot = Game.fighterBody(f)
			ak.refGround = (if troot then troot.Position.Y else head.Position.Y) - 3
		end
		ak.targetVoid = S.bounds.isVoidFighter(f)
		
		
		ak.transloc = cfg.antiTransloc and Resolver.translocated(model) or false
		if ak.transloc then
			ak.refGround = ak.refGround or (head.Position.Y - 3)
			ak.targetVoid = true
		end
		
		if Combat.akBladeClose(f, ak.mode) then
			log("INFO", ("[ragebot:blade] %s has a blade out -> High (was %s)"):format(Game.fighterName(f), ak.mode))
			if ak.mode == "Glue" then
				Combat.hvh.unglue("blade out")
			end
			ak.mode, ak.modeWhy = "High", (ak.modeWhy or "") .. " · blade out"
		end

		
		
		local behind = cfg.autoBackstab and ak.behind == true and Combat.behindAngle(f) or nil
		
		
		if ak.state ~= "snap" and Combat.akBusyPark(head, now) then
			
		elseif ak.mode == "Origin" or ak.mode == "Snap" or ak.mode == "Under" or ak.mode == "High" or ak.mode == "Glue" then
			if ak.mode == "Glue" then
				if Combat.hvh.glueOk() then
					Combat.akGlueStep(head, model, f, now)
				else
					Combat.hvh.unglue("glue unavailable")
					Combat.akOriginStep(head, model, f, now)
				end
			elseif ak.mode == "Snap" then
				Combat.akSnapStep(head, model, f, now)
			elseif ak.mode == "Under" or ak.mode == "High" then
				Combat.akDesyncStep(head, model, f, now)
			else
				Combat.akOriginStep(head, model, f, now)
			end
			if ak.state == "snap" then
				ak.snapAt = now
				ak.state = "orbit"
			end
		elseif ak.state == "snap" then
			if behind then
				ak.angle = behind
			elseif ak.nextAngle then
				ak.angle = ak.nextAngle 
			elseif cfg.autokillAdaptive then
				ak.angle = Combat.safestAngle(head, model, enemies)
			end
			ak.nextAngle = nil
			ak.holdCF = Combat.orbitPoint(head, model, 0)
			ak.holdOffset = ak.holdCF.Position - head.Position
			Combat.akRequest(ak.holdCF.Position, head.Position, nil, true)
			ak.snapAt = now
			ak.hopAt = now
			ak.steerAt = now
			ak.state = "orbit"
			ak.burstFrom, ak.burstPulses = nil, S.pulses or 0
		elseif ak.state == "orbit" then
			local move = Combat.akMove()
			if move == "Hop" or move == "Hold" then
				
				
				
				
				
				local settle = Combat.settleSec()
				local hopEvery = math.max(cfg.autokillHopMs / 1000, settle + 0.3)
				local fast = Combat.gunCycle() < settle * 0.8
				local sinceHop = now - (ak.hopAt or 0)
				local canHop = Combat.cannotFireFor(S.gameState) > settle + 0.05 or (fast and sinceHop >= math.max(hopEvery, 0.6))
				local hop = (move == "Hop" and sinceHop >= hopEvery and canHop) or (ak.forceHop and sinceHop > settle)
				if hop then
					ak.forceHop = nil
					ak.hopAt = now
					if behind then
						ak.angle = behind
					elseif cfg.autokillAdaptive then
						ak.angle = Combat.safestAngle(head, model, enemies)
					else
						local step = math.pi * (0.45 + math.random() * 0.9)
						ak.angle = (ak.angle or 0) + (if math.random() < 0.5 then step else -step)
					end
					ak.holdCF = Combat.orbitPoint(head, model, 0)
					ak.holdOffset = ak.holdCF.Position - head.Position
				end
				
				local p = head.Position + (ak.holdOffset or Vector3.new(0, ak.height or 2.5, 0))
				Combat.akRequest(p, head.Position, nil, hop)
			elseif ak.mode == "Orbit" then
				
				
				if ak.forceHop then
					
					ak.forceHop = nil
					ak.dir = -(ak.dir or 1)
					ak.angle = (ak.angle or 0) + math.pi * 0.5 * ak.dir
				elseif behind then
					ak.angle = behind
				end
				local window = Combat.cannotFireFor(S.gameState) <= Combat.settleSec() + 0.05
				local spot = Combat.orbitJitterPoint(head, model, if behind then 0 else dt, now, window)
				Combat.akRequest(spot, head.Position, head.Position, false, nil, nil)
			else
				
				
				if ak.forceHop then
					ak.forceHop = nil
					ak.dir = -(ak.dir or 1)
					ak.angle = (ak.angle or 0) + math.pi * 0.5 * ak.dir
				elseif behind then
					ak.angle = behind
				elseif cfg.autokillAdaptive and now - (ak.steerAt or 0) > 1 then
					
					ak.steerAt = now
					local want = Combat.safestAngle(head, model, enemies)
					local diff = ((want - (ak.angle or 0) + math.pi) % (2 * math.pi)) - math.pi
					ak.dir = if diff >= 0 then 1 else -1
				end
				
				
				local window = Combat.cannotFireFor(S.gameState) <= Combat.settleSec() + 0.05
				local cap = if window then math.min(cfg.autokillMaxSpeed, Combat.ORBIT_FIRE_SPEED) else math.max(cfg.autokillMaxSpeed, 20)
				local desired = Combat.orbitPoint(head, model, if behind then 0 else dt * (ak.dir or 1), cap)
				Combat.akRequest(desired.Position, head.Position, nil, false, cap)
			end
			
			
			if ak.mode == "Void" then
				if ak.burstFrom == nil and (S.pulses or 0) > (ak.burstPulses or math.huge) then
					ak.burstFrom = now
				end
				local over = if ak.burstFrom then now - ak.burstFrom >= cfg.voidBurst else now - (ak.snapAt or now) >= cfg.voidBurst + 1.5
				
				if not over and now - (ak.snapAt or now) > 0.15 and Combat.hurtHide(now, f) then
					over = true
				end
				if over then
					
					
					ak.state = "void"
					ak.phaseUntil = now + cfg.voidRest
					ak.voidEnteredAt = now
					ak.restSpot = nil
				end
			end
		elseif ak.state == "void" then
			local jump = now - (ak.voidEnteredAt or now) < 0.05
			if not ak.restSpot then
				local c = Combat.pickHide(head.Position, enemies)
				ak.restSpot = c and c.pos or nil
				ak.restKind = c and c.kind or nil
			end
			if ak.restSpot then
				Combat.akRequest(ak.restSpot, head.Position, nil, jump, nil, if ak.restKind == "transloc" then "transloc" else "far")
			end
			
			
			if ak.phaseUntil - now <= Combat.echoLead() then
				if ak.nextAngle == nil then
					ak.nextAngle = if behind then behind elseif cfg.autokillAdaptive then Combat.safestAngle(head, model, enemies) else (ak.angle or 0)
				end
				local keep = ak.angle
				ak.angle = ak.nextAngle
				local cf = Combat.orbitPoint(head, model, 0)
				ak.angle = keep
				S.preFaceFrom = cf.Position + Vector3.new(0, 1.85, 0)
				S.preFace = true
			end
			
			local left = Combat.cannotFireFor(S.gameState)
			local finish = left <= Combat.fireLead() and now - (ak.voidEnteredAt or now) > Combat.settleSec() and Combat.killable(f)
			if now > ak.phaseUntil or finish then
				ak.state = "snap"
			end
		end
		
		
		if ak.state == "orbit" and ak.snapPhase ~= "rest" then
			if Combat.body.holds("autokill") then
				ak.refusedSince = nil
			else
				ak.refusedSince = ak.refusedSince or now
				if now - ak.refusedSince > 1 then
					ak.refusedSince = nil
					
					if ak.fighter ~= nil then
						Combat.akSkip[ak.fighter] = now + 5
					end
					if not Combat.retargetAutokill(enemies, "no safe spot") then
						Combat.stopAutokill("no safe spot near the target")
						return
					end
				end
			end
		end
		
		
		local me = Game.myRoot()
		if me and cfg.autokillVisible and Combat.body.holds("autokill") and not Combat.body.csyncHold then
			Game.setCamRotation(Combat.lookAtSafe(me.Position, head.Position))
		end
		
		
		local settledOk = Combat.body.settledFor("autokill")
		local losOk = true
		if ak.mode == "Origin" and cfg.boundsGuard then
			local part = S.silentPart
			
			
			local from = Game.shotOriginPos()
			if typeof(part) == "Instance" and part.Parent and from then
				
				losOk = (S.wallPushUnder and S.wallPushOrigin ~= nil and S.wallPushModel == model) or S.bounds.serverLos(from, model, part)
			end
		end
		
		local synced = ak.state == "orbit" and not ak.hiding and Combat.syncReady(ak.fighter, math.max(ak.snapAt or 0, ak.faceSince or 0))
		local hopOk = ak.mode ~= "Origin" or ak.hopSettled ~= false
		
		
		
		
		local why: string? = nil
		if ak.state ~= "orbit" then
			why = if ak.state == "void" then "resting" else "moving in"
		elseif ak.hiding then
			why = "hiding"
		elseif not settledOk then
			why = "settling"
		elseif not losOk then
			why = "no line"
		elseif immune then
			why = "immune"
		elseif not hopOk then
			why = "hop"
		elseif not synced then
			why = "syncing"
		end
		if why == "syncing" or why == "hop" then
			ak.starveSince = ak.starveSince or now
			local starveCap = math.clamp(Combat.settleSec() + 0.15, 0.25, 0.6)
			
			if ak.mode ~= "Glue" and Combat.cannotFireFor(S.gameState) <= Combat.fireLead() and S.targetVisible ~= false then
				starveCap = math.min(starveCap, 0.35)
			end
			if now - ak.starveSince >= starveCap then
				why = nil
				ak.forcedFrames = (ak.forcedFrames or 0) + 1
			end
		elseif why == nil then
			ak.starveSince = nil
		end
		
		if why == nil then
			local left, busyWhy = Combat.cannotFireFor(S.gameState)
			if left > Combat.fireLead() then
				why = busyWhy or "gun busy"
			end
		end
		ak.waitWhy = why
		ak.firing = why == nil
		if why and why ~= ak.lastWaitLogged then
			ak.lastWaitLogged = why
			log("DEBUG", ("[autokill:wait] %s · %s"):format(why, Game.fighterName(f)))
		elseif why == nil and ak.lastWaitLogged then
			log("DEBUG", ("[autokill:fire] %s"):format(Game.fighterName(f)))
			ak.lastWaitLogged = nil
		end
		
		ak.step = if why == nil then "firing" elseif why == "hop" then "settling" elseif why == "syncing" then "aiming" elseif why == "immune" then "target immune" else why
		
		if ak.mode == "Glue" and Combat.hvh.glueOk() then
			ak.firing = false
			why = if ak.glueState == "glued" then nil else (ak.glueState or "parked")
			ak.waitWhy = why
			ak.step = if why == nil then "glued" else why
		end
		ak.frames = (ak.frames or 0) + 1
		
		if ak.firing or why == nil then
			ak.firingFrames = (ak.firingFrames or 0) + 1
		else
			ak.whyFrames = ak.whyFrames or {}
			ak.whyFrames[why] = (ak.whyFrames[why] or 0) + 1
		end
	end

	
	
	
	
	
	
	do
		local H: any = { glued = {}, gluedTo = nil, send = { ok = 0, miss = 0, path = "own", off = false }, tokens = {}, enemy = setmetatable({}, { __mode = "k" }), side = { Above = { n = 0, hit = 0 }, Below = { n = 0, hit = 0 } } }
		Combat.hvh = H
		H.VOID = CFrame.new(math.random(-90000, -10000), 90000, math.random(-90000, 10000))
		function H.token(name: string): any
			local t = H.tokens[name]
			if t == nil then
				local ok, v = pcall(function()
					return Game.Enums:ToEnum(name)
				end)
				t = if ok then v else false
				H.tokens[name] = t
			end
			return if t == false then nil else t
		end
		function H.remote(): Instance?
			local r = S.h.useItemRemote
			if not (typeof(r) == "Instance" and r.Parent) and S.h.resolveUseItemRemote then
				r = S.h.resolveUseItemRemote()
				S.h.useItemRemote = r
			end
			return r
		end
		
		function H.directOk(): boolean
			return not H.send.off and H.remote() ~= nil and H.token("StartShooting") ~= nil
		end
		function H.fire(item: any, token: any, payload: any): boolean
			local r = H.remote()
			local data = type(item) == "table" and rawget(item, "Data")
			local oid = type(data) == "table" and rawget(data, "ObjectID")
			if not (r and oid and token) then
				return false
			end
			local path = if cfg.directPath == "Trampoline" then "tramp" elseif cfg.directPath == "Own thread" then "own" else H.send.path
			if path == "tramp" then
				local ok = Game.asShotCode(function()
					r:FireServer(oid, token, payload, nil)
				end)
				return ok == true
			end
			return (pcall(function()
				r:FireServer(oid, token, payload, nil)
			end))
		end
		function H.noteDirectVerdict(verdict: string)
			local s = H.send
			if verdict ~= "NO-REPLY" then
				s.ok += 1
				s.miss = 0
				return
			end
			s.miss += 1
			if s.miss >= 6 and s.ok == 0 and cfg.directPath == "Auto" then
				s.miss = 0
				if s.path == "own" then
					s.path = "tramp"
					log("WARN", "[direct] 6 direct sends got no reply from our own thread — trying the trampoline")
				else
					s.off = true
					log("WARN", "[direct:off] no server answers to direct sends either way — back to the game's own input for this session")
				end
			end
		end
		local function enc(cf: CFrame): any
			return S.h.encodeCFLike({}, cf)
		end
		
		function H.camData(from: Vector3, part: BasePart, aim: Vector3): any
			local look = CFrame.lookAt(from, aim)
			return { ["\0"] = enc(look), ["\1"] = enc(look), ["\2"] = part, ["\3"] = enc(part.CFrame:ToObjectSpace(CFrame.new(aim))) }
		end
		
		function H.camKicia(part: BasePart, above: boolean, oy: number, oz: number): any
			local pitch = if above then -math.pi / 2 else math.pi / 2
			local o = { ["\0"] = -9e37, ["\1"] = 0, ["\2"] = 0, ["\3"] = pitch, ["\4"] = oy, ["\5"] = oz }
			local e = { ["\0"] = 0, ["\1"] = if above then -90000000 else 90000000, ["\2"] = 0, ["\3"] = pitch, ["\4"] = oy, ["\5"] = oz }
			return { ["\0"] = o, ["\1"] = e, ["\2"] = part, ["\3"] = { ["\0"] = 0, ["\1"] = 1, ["\2"] = 0, ["\3"] = 0, ["\4"] = 0, ["\5"] = 0 } }
		end
		
		
		function H.shoot(item: any, part: BasePart, from: Vector3, aim: Vector3, above: boolean?): boolean
			if not (H.directOk() and type(item) == "table" and type(item.Info) == "table" and item.Info.Type == "Gun" and part and part.Parent) then
				return false
			end
			local block = Combat.shootBlocked({ autokill = true, gunOnly = true, skipHide = true })
			if block then
				Combat.noteShootHold("glue: " .. block)
				return false
			end
			local stamp = tonumber(rawget(item, "_shoot_cooldown"))
			if stamp and tick() < stamp then
				return false
			end
			if Combat.fireGate(item) ~= "pass" then
				return false
			end
			local info = item.Info
			local scoped = info.AimScopePercent ~= nil
			local aimed = true
			if scoped then
				aimed = S.h.realFullyAiming and S.h.realFullyAiming(item) == true or false
			end
			local cam
			if cfg.directPayload == "Kicia" then
				local _, oy, oz = part.CFrame:ToOrientation()
				cam = H.camKicia(part, above ~= false, oy, oz)
			else
				cam = H.camData(from, part, aim)
				local p, y = CFrame.lookAt(from, aim):ToOrientation()
				pcall(Combat.sendRotation, Vector2.new(p, y))
			end
			local ok = H.fire(item, H.token("StartShooting"), { ["\1"] = cam, ["\2"] = aimed })
			if not ok then
				return false
			end
			rawset(item, "_shoot_cooldown", tick() + (tonumber(info.ShootCooldown) or 0.1) * (if cfg.rapidFire then Combat.rapidMult(tostring(item.Name)) else 1))
			pcall(Combat.fireDone, item, "pass")
			S.pulses = (S.pulses or 0) + 1
			local model = part.Parent
			pcall(S.shots.claim, { weapon = tostring(item.Name), spoofed = true, direct = true, glue = H.gluedTo ~= nil, target = model and model.Name, part = part.Name, partInst = part, aim = aim, model = model, dist = (aim - from).Magnitude, projectile = info.IsProjectile == true })
			return true
		end
		
		H.atk = 0
		function H.swing(item: any, part: BasePart, from: Vector3): boolean
			if not (H.directOk() and cfg.directMelee and type(item) == "table" and type(item.Info) == "table" and item.Info.Type == "Melee" and part) then
				return false
			end
			local stamp = tonumber(rawget(item, "_attack_cooldown"))
			if stamp and tick() < stamp then
				return false
			end
			H.atk = H.atk % 2 + 1
			local anim = H.token("Attack" .. H.atk) or H.token("Attack1")
			if not anim then
				return false
			end
			local ok = H.fire(item, H.token("StartShooting"), { ["\1"] = H.camData(from, part, part.Position), ["\2"] = anim })
			if ok then
				rawset(item, "_attack_cooldown", tick() + (tonumber(item.Info.AttackCooldown) or 0.5) * (cfg.rapidMelee and cfg.rapidMeleeMult or 1))
			end
			return ok
		end

		
		function H.glueOk(): boolean
			return cfg.hvhGlue == true and type(EXEC.sethiddenproperty) == "function" and H.directOk()
		end
		function H.pickSide(f: any): string
			local want = cfg.hvhGlueSide
			if want == "Above" or want == "Below" then
				return want
			end
			local eq = Game.enemyEquipped(f)
			if type(eq) == "table" and tostring(eq.Name):find("Shield", 1, true) then
				return "Below"
			end
			local a, b = H.side.Above, H.side.Below
			if a.n >= 5 and b.n >= 5 and b.hit / b.n > a.hit / a.n + 0.1 then
				return "Below"
			end
			return "Above"
		end
		
		function H.glue(f: any, side: string): (Vector3?, BasePart?, Vector3?)
			local hb = Game.hitboxPart(f, "Head")
			local root = S.myRootPart
			if not (hb and hb.Parent and root and root.Parent) then
				return nil, nil, nil
			end
			local st = H.glued[hb]
			local real = if st then st.real else hb.Position
			if not st then
				local weld = hb:FindFirstChildOfClass("WeldConstraint")
				local p1 = weld and weld.Part1
				local anchor = p1 or (hb.Parent and hb.Parent:IsA("Model") and hb.Parent.PrimaryPart) or nil
				
				
				st = { anchored = hb.Anchored, weld = weld, p1 = p1, anchor = anchor, rel = if anchor then anchor.CFrame:ToObjectSpace(hb.CFrame) else nil, real = hb.Position, cf = hb.CFrame }
				H.glued[hb] = st
				pcall(function()
					if weld and weld.Part1 then
						weld.Part1 = nil
					end
					hb.Anchored = true
				end)
			end
			pcall(function()
				hb.CFrame = CFrame.new(H.VOID.Position)
			end)
			if H.gluedTo ~= hb then
				pcall(EXEC.sethiddenproperty, root, "PhysicsRepRootPart", hb)
				H.gluedTo, H.gluedAt, H.gluedSide = hb, os.clock(), side
				log("DEBUG", ("[glue] on %s (%s)"):format(Game.fighterName(f), side))
			end
			local off = if side == "Below" then Vector3.new(0, cfg.glueBelowY, cfg.glueZ) else Vector3.new(0, cfg.glueAboveY, cfg.glueZ)
			return H.VOID.Position + off, hb, real
		end
		function H.unglue(why: string?)
			local root = S.myRootPart
			if H.gluedTo ~= nil and root then
				pcall(EXEC.sethiddenproperty, root, "PhysicsRepRootPart", nil)
			end
			for hb, st in pairs(H.glued) do
				pcall(function()
					if st.anchor and st.anchor.Parent and st.rel then
						hb.CFrame = st.anchor.CFrame * st.rel
					else
						hb.CFrame = st.cf
					end
					if st.weld and st.p1 then
						st.weld.Part1 = st.p1
					end
					hb.Anchored = st.anchored
				end)
				H.glued[hb] = nil
			end
			if H.gluedTo ~= nil and why then
				log("DEBUG", ("[glue] off (%s)"):format(why))
			end
			H.gluedTo = nil
		end

		
		function H.noteEnemyShot(fighter: any, item: any)
			if type(fighter) ~= "table" then
				return
			end
			local e = H.enemy[fighter] or {}
			H.enemy[fighter] = e
			e.lastShot, e.item = os.clock(), item
		end
		function H.noteHurt(amount: number)
			local me = S.myRootPart
			if not me then
				return
			end
			local best, bd = nil, math.huge
			for _, f in ipairs(Game.targets()) do
				local r = Game.fighterBody(f)
				if r then
					local d = (r.Position - me.Position).Magnitude
					if d < bd then
						best, bd = f, d
					end
				end
			end
			if best then
				local e = H.enemy[best] or {}
				H.enemy[best] = e
				e.lastShot = os.clock()
				
				if bd <= cfg.gluebotArrivalDist then
					e.pb = (e.pb or 0) + 1
				end
			end
		end
		function H.readyIn(f: any): number?
			local e = H.enemy[f]
			if not (e and e.lastShot) then
				return nil
			end
			local item = Game.enemyEquipped(f) or e.item
			local name = type(item) == "table" and tostring(item.Name) or nil
			local orig = name and S.statOriginals[name]
			local info = type(item) == "table" and item.Info or nil
			local cd = tonumber(orig and (orig.ShootCooldown or orig.AttackCooldown)) or tonumber(info and (info.ShootCooldown or info.AttackCooldown)) or 0.6
			return math.max(0, e.lastShot + cd - os.clock())
		end
		
		function H.trackEnemies(targets: { any })
			for _, f in ipairs(targets) do
				if not f.IsBot then
					local root = Game.fighterBody(f)
					if root then
						local e = H.enemy[f] or {}
						H.enemy[f] = e
						local w = Resolver.warp and Resolver.warp[select(2, Game.fighterBody(f))]
						local p = (w and w.rawPos) or root.Position
						e.frames = (e.frames or 0) + 1
						if Resolver.fakePos(p) or Combat.beyondBound(p) then
							e.away = (e.away or 0) + 1
						end
						if e.frames > 600 then
							e.frames, e.away = e.frames * 0.5, (e.away or 0) * 0.5
						end
					end
				end
			end
		end
		function H.override(f: any): string?
			local plr = f and f.Player
			local list = cfg.gluebotList
			return typeof(plr) == "Instance" and type(list) == "table" and list[plr.Name] or nil
		end
		function H.isGluebot(f: any): boolean
			local ov = H.override(f)
			if ov == "Always" then
				return true
			elseif ov == "Never" then
				return false
			end
			local e = H.enemy[f]
			if not e then
				return false
			end
			local awayPct = if (e.frames or 0) >= 60 then (e.away or 0) / e.frames * 100 else 0
			local flagged = awayPct >= cfg.gluebotAwayPct or (e.pb or 0) >= cfg.gluebotArrivals
			if flagged and not e.flagLogged then
				e.flagLogged = true
				log("INFO", ("[enemy] %s flagged glue-bot · away %d%% · point-blank hits %d"):format(Game.fighterName(f), math.floor(awayPct + 0.5), e.pb or 0))
			end
			return flagged
		end
		function H.counterFor(f: any): boolean
			return cfg.gluebotCounter == true and H.override(f) ~= "Never" and H.glueOk()
		end
		
		function H.anyReadyBefore(myLeft: number): boolean
			for _, f in ipairs(Game.targets()) do
				local r = H.readyIn(f)
				if r == nil or r + cfg.counterMargin / 1000 < myLeft then
					return true
				end
			end
			return false
		end

		
		function H.sendRateTick()
			local want = cfg.hvhSendRate == true and Combat.rageOn() and not S.featuresPaused and type(EXEC.setfflag) == "function"
			if want and H.rateOrig == nil then
				local ok, v = pcall(EXEC.getfflag, "DFIntS2PhysicsSenderRate")
				H.rateOrig = if ok and v ~= nil then tostring(v) else "15"
				pcall(EXEC.setfflag, "DFIntS2PhysicsSenderRate", tostring(cfg.hvhSendRateValue))
				log("INFO", ("[hvh] physics send rate %s -> %d"):format(H.rateOrig, cfg.hvhSendRateValue))
			elseif not want and H.rateOrig ~= nil then
				H.restoreSendRate()
			end
		end
		
		
		function H.counterTick()
			if not (cfg.gluebotCounter and cfg.counterDeflect) or S.featuresPaused or not S.charAlive or S.menuOpen then
				return
			end
			local prof = Game.weaponProfile()
			if not (prof.item and tostring(prof.name):find("Katana", 1, true)) then
				return
			end
			local now = os.clock()
			if now - (H.deflectAt or -10) < 4.2 then
				return
			end
			for _, f in ipairs(Game.targets()) do
				if H.isGluebot(f) then
					local r = H.readyIn(f)
					if r ~= nil and r <= 0.25 + cfg.counterMargin / 1000 then
						H.deflectAt = now
						pcall(Input.gameInput, "StartAiming")
						task.delay(0.05, function()
							pcall(Input.gameInput, "FinishAiming")
						end)
						log("INFO", ("[counter] deflect: %s's gun back in %.2f s"):format(Game.fighterName(f), r))
						return
					end
				end
			end
		end
		
		function H.guard()
			if H.gluedTo == nil then
				return
			end
			local owner = H.glueOwner or "autokill"
			local active = if owner == "meleeRage" then (cfg.meleeRage and Combat.mr.fighter ~= nil) else (ak.state ~= "idle" and ak.state ~= "done" and ak.mode == "Glue")
			if not active or S.menuOpen or S.featuresPaused or not S.charAlive or Combat.body.owner ~= owner then
