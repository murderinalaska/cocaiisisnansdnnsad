	Game.hpMemo, Game.hpMemoMax, Game.hpMemoFrame = setmetatable({}, { __mode = "k" }), setmetatable({}, { __mode = "k" }), -1
	function Game.fighterHealth(fighter: any): (number?, number?)
		if fighter == nil then
			return nil, nil
		end
		if Game.hpMemoFrame ~= Game.frameId then
			Game.hpMemoFrame = Game.frameId
			table.clear(Game.hpMemo)
			table.clear(Game.hpMemoMax)
		end
		local hp = Game.hpMemo[fighter]
		if hp ~= nil then
			if hp == false then
				return nil, nil
			end
			return hp, Game.hpMemoMax[fighter]
		end
		local h, m = Game.readHealth(fighter)
		Game.hpMemo[fighter] = if h == nil then false else h
		Game.hpMemoMax[fighter] = m
		return h, m
	end
	function Game.readHealth(fighter: any): (number?, number?)
		local ent = fighter and fighter.Entity
		if type(ent) ~= "table" then
			return nil, nil
		end
		local hum = ent.Humanoid
		if hum and hum.MaxHealth > 0 then
			return hum.Health, hum.MaxHealth
		end
		local model = ent.Model
		hum = model and model:FindFirstChildOfClass("Humanoid")
		if hum and hum.MaxHealth > 0 then
			return hum.Health, hum.MaxHealth
		end
		
		local bot = fighter.Bot
		if type(bot) == "table" and type(bot.GetHealth) == "function" then
			local ok, hp = pcall(bot.GetHealth, bot)
			local okM, mx = pcall(bot.GetMaxHealth, bot)
			if ok and type(hp) == "number" then
				return hp, if okM and type(mx) == "number" and mx > 0 then mx else math.max(hp, 1)
			end
		end
		return nil, nil
	end

	Game.SPOOF_POOL = { "Alex", "Jordan", "Riley", "Casey", "Morgan", "Quinn", "Avery", "Parker", "Drew", "Skyler" }
	function Game.cleanSpoof(s: string, maxLen: number): string
		s = tostring(s):gsub("[%c<>&]", ""):gsub("^%s+", ""):gsub("%s+$", "")
		if #s > maxLen then
			s = s:sub(1, maxLen)
		end
		return s
	end
	
	function Game.spoofedName(fighter: any): string?
		local on = cfg.nameSpoof == true or cfg.streamerMode == true
		if not on or type(fighter) ~= "table" then
			return nil
		end
		if fighter.IsLocalPlayer or fighter.Player == LP then
			return nil
		end
		local mode = if cfg.streamerMode == true then "Hide" else (cfg.nameSpoofMode or "Custom")
		if mode == "Hide" then
			return ""
		end
		if mode == "Random" then
			local plr = fighter.Player
			local key = if typeof(plr) == "Instance" then tostring(plr.UserId) else "bot"
			local n = 0
			for i = 1, #key do
				n += string.byte(key, i)
			end
			local pool = Game.SPOOF_POOL
			return pool[(n % #pool) + 1]
		end
		if mode == "Swap" then
			local plr = fighter.Player
			local list = Players:GetPlayers()
			if typeof(plr) ~= "Instance" or #list < 2 then
				return "Player"
			end
			local idx = 1
			for i, p in ipairs(list) do
				if p == plr then
					idx = i
					break
				end
			end
			local other = list[(idx % #list) + 1]
			if other == LP or other == plr then
				other = list[((idx + 1) % #list) + 1]
			end
			if not other or other == plr then
				return "Player"
			end
			return if other.DisplayName ~= "" then other.DisplayName else other.Name
		end
		local custom = Game.cleanSpoof(cfg.nameSpoofText or "Player", 24)
		return if custom ~= "" then custom else "Player"
	end
	function Game.spoofedWeapon(realName: string): string
		if cfg.weaponSpoof ~= true then
			return realName
		end
		local mode = cfg.weaponSpoofMode or "Hide"
		if mode == "Hide" then
			return ""
		end
		if mode == "Generic" then
			return "Gun"
		end
		local custom = Game.cleanSpoof(cfg.weaponSpoofText or "Gun", 16)
		return if custom ~= "" then custom else "Gun"
	end
	function Game.fighterName(fighter: any): string
		local spoof = Game.spoofedName(fighter)
		if spoof ~= nil then
			return if spoof == "" then "" else spoof
		end
		local plr = fighter and fighter.Player
		if typeof(plr) == "Instance" then
			return plr.DisplayName or plr.Name
		end
		local _, model = Game.fighterBody(fighter)
		if fighter and fighter.IsBot then
			return (if model then model.Name else "Bot") .. " [BOT]"
		end
		return if model then model.Name else "Enemy"
	end

	
	
	
