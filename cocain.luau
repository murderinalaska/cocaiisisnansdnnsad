		local NC_CAST = { Raycast = true, Blockcast = true, Spherecast = true }
		local NC_REMOTE = { FireServer = true, InvokeServer = true }
		local NC_VR = { GetUserCFrameEnabled = true, GetUserCFrame = true }
		local nc = function(self, ...)
			if S.alive then
				local method = EXEC.getnamecallmethod()
				local want = false
				if NC_CAST[method] then
					want = S.ncCast ~= false or S.cfgOverrideSilent == true
				elseif NC_REMOTE[method] then
					local hh = S.h
					if self == hh.useItemRemote then
						
						local C = S.shotCounters
						if C then
							C.useItem += 1
						end
						S.lastUseItemAt = os.clock()
					end
					
					
					local owned = hh.ncOwned
					want = S.cfg.remoteSpy == true
						or (owned ~= nil and owned[self] == true and (S.ncRemote ~= false or S.cfg.oobBlock == true))
						or (hh.oobRemote == nil and S.cfg.oobBlock == true)
				elseif NC_VR[method] then
					want = S.deviceVR == true
				elseif method == "GetAttribute" then
					local test = S.ncSelfTest
					want = test ~= nil and self == test.inst
				end
				if want then
					local ok, handled, res = pcall(ncLogic, self, method, ...)
					if ok then
						if handled then
							return res
						end
					elseif S.hookErr then
						
						task.defer(S.hookErr, "namecall hook", handled)
					end
					
					return callOld(method, self, ...)
				end
			end
			return oldNc(self, ...)
		end
		
		
		
		if EXEC.ncYields == false and type(EXEC.getrawmetatable) == "function" then
			local mt = EXEC.getrawmetatable(game)
			local oldPlain: any = nil
			if type(mt) == "table" then
				if type(EXEC.setreadonly) == "function" then
					pcall(EXEC.setreadonly, mt, false)
				end
				oldPlain = rawget(mt, "__namecall")
				if type(oldPlain) ~= "function" then
					local okOld, v = pcall(function()
						return mt.__namecall
					end)
					oldPlain = if okOld then v else nil
				end
				if type(oldPlain) == "function" then
					rawset(mt, "__namecall", nc)
				end
				if type(EXEC.setreadonly) == "function" then
					pcall(EXEC.setreadonly, mt, true)
				end
			end
			if type(oldPlain) == "function" then
				oldNc = oldPlain
				S.hooks.ncMode = "raw"
				log("INFO", "hooks: __namecall plain closure (newcclosure cannot yield on this executor)")
			else
				
				log("WARN", "hooks: __namecall skipped — this executor cannot host a yielding namecall hook")
			end
		else
			oldNc = EXEC.hookmetamethod(game, "__namecall", nc)
			S.hooks.ncMode = "hookmetamethod"
		end
		if type(oldNc) ~= "function" then
			log("WARN", "hooks: __namecall not installed")
			return
		end
		installed.namecall = true
		S.hookOrig.namecall = oldNc 
		pcall(h.refreshOwned)
		
		
		
		h.fsLogic = function(oldFs: any, self: any, ...): (boolean, any)
			if self == S.h.useItemRemote then
				local C = S.shotCounters
				if C then
					C.useItem += 1
				end
				S.lastUseItemAt = os.clock()
			end
			fsDirect = oldFs
			local ok, handled, res = pcall(ncLogic, self, "FireServer", ...)
			fsDirect = nil
			if not ok then
				if S.hookErr then
					task.defer(S.hookErr, "FireServer hook", handled)
				end
				return false, nil
			end
			return handled == true, res
		end
		for _, cls in ipairs({ "RemoteEvent", "UnreliableRemoteEvent" }) do
			local okI, inst = pcall(Instance.new, cls)
			local fs = okI and inst.FireServer
			if type(fs) == "function" then
				local oldFs: any
				oldFs = hook(fs, function(self, ...)
					local st = getgenv().CocaineState
					local hh = st and st.alive and st.h
					if hh and hh.fsLogic and not (EXEC.checkcaller and EXEC.checkcaller()) then
						local handled, res = hh.fsLogic(oldFs, self, ...)
						if handled then
							return res
						end
					end
					return oldFs(self, ...)
				end, "remote")
				if oldFs ~= Hooks.passThrough then
					installed["fs" .. cls] = true
				end
			end
			if okI then
				inst:Destroy()
			end
		end
		log("INFO", ("hooks: __namecall (raycast redirect, equip block, remote spy, OOB report) · restore %s"):format(Game.pilot.get("namecall")))
		task.delay(1, function()
			if S.alive then
				pcall(Hooks.ncIntegrity)
			end
		end)
	end
	
	
	function Hooks.ncIntegrity(): boolean
		if installed.namecall ~= true then
			return false
		end
		local P = Game.pilot
		S.ncIntegrity = S.ncIntegrity or {}
		for _ = 1, 3 do
			local mode = P.get("namecall")
			if mode == "off" then
				return false
			end
			local f = Instance.new("Folder")
			f:SetAttribute("c0caine", 42)
			local test: any = { inst = f }
			S.ncSelfTest = test
			local ok, v = pcall(function()
				return f:GetAttribute("c0caine")
			end)
			S.ncSelfTest = nil
			pcall(f.Destroy, f)
			if test.dot == nil then
				
				S.ncIntegrity[mode] = "n/a"
				return true
			end
			local pass = ok and v == 42
			S.ncIntegrity[mode] = pass
			if pass then
				P.ok("namecall")
				log("INFO", ("hooks: namecall method integrity ok (%s)"):format(mode))
				return true
			end
			local why = if ok then ("GetAttribute gave %s"):format(tostring(v)) else tostring(v):sub(1, 90)
			log("WARN", ("hooks: namecall method integrity FAILED with %s (%s)"):format(mode, why))
			local nxt = P.fail("namecall", "integrity test: " .. why, 1)
			if nxt == "off" then
				Hooks.namecallOff("method integrity test failed")
				return false
			elseif nxt == nil then
				return false
			end
		end
		return false
	end
	
	function Hooks.namecallOff(why: string): boolean
		local orig = S.hookOrig.namecall
		if installed.namecall ~= true or type(orig) ~= "function" then
			if installed.namecall ~= true then
				installed.namecall = "off"
			end
			return false
		end
		local ok = false
		if S.hooks.ncMode == "raw" and type(EXEC.getrawmetatable) == "function" then
			local okMt, mt = pcall(EXEC.getrawmetatable, game)
			if okMt and type(mt) == "table" then
				if type(EXEC.setreadonly) == "function" then
					pcall(EXEC.setreadonly, mt, false)
				end
				ok = pcall(rawset, mt, "__namecall", orig)
				if type(EXEC.setreadonly) == "function" then
					pcall(EXEC.setreadonly, mt, true)
				end
			end
		elseif type(EXEC.hookmetamethod) == "function" then
			ok = pcall(EXEC.hookmetamethod, game, "__namecall", orig)
		end
		installed.namecall = "off"
		log("WARN", ("hooks: __namecall given back (%s)%s"):format(tostring(why), if ok then "" else " — the restore failed"))
		return ok
	end

	
	
	
	
	function Hooks.installOob()
		if installed.oob and installed.oobKill then
			return
		end
		local mods = ReplicatedStorage:FindFirstChild("Modules")
		local OOB = Game.requireIfLoaded(mods and mods:FindFirstChild("OutOfBoundsMachine"))
		if type(OOB) ~= "table" then
			return 
		end
		if not installed.oob then
			local fn = classMethod(OOB, "IsOutOfBounds")
			if type(fn) ~= "function" then
				log("WARN", "hooks: OutOfBoundsMachine.IsOutOfBounds not found — OOB guard is remote-swallow only")
			else
				local old: any
				local hooked
				old, hooked = hook(fn, function(self, ...)
					
					if S.alive and S.cfg.oobBlock and not S.featuresPaused then
						S.oobSuppressed = (S.oobSuppressed or 0) + 1
						return nil
					end
					return old(self, ...)
				end)
				if hooked then
					S.hookOrig.oobIsOutOfBounds = old 
					installed.oob = true 
					log("INFO", "hooks: OutOfBoundsMachine.IsOutOfBounds (OOB guard)")
				end
			end
		end
		
		
		if not installed.oobKill then
			local ck = classMethod(OOB, "_CheckKill")
			if type(ck) == "function" then
				local oldCk: any
				local hookedCk
				oldCk, hookedCk = hook(ck, function(self, ...)
					if S.alive and S.cfg.oobBlock and not S.featuresPaused then
						if type(self) == "table" and rawget(self, "_oob_details") ~= nil then
							rawset(self, "_oob_details", nil)
							S.oobSuppressed = (S.oobSuppressed or 0) + 1
						end
						return nil
					end
					return oldCk(self, ...)
				end)
				if hookedCk then
					installed.oobKill = true
				end
			end
		end
	end

	
	
	
	
	function Hooks.installAntiFlash()
		if installed.antiFlash then
			return
		end
		local mod = LP:FindFirstChild("PlayerScripts")
		mod = mod and mod:FindFirstChild("Modules")
		mod = mod and mod:FindFirstChild("Items")
		mod = mod and mod:FindFirstChild("Flashbang")
		if not mod then
