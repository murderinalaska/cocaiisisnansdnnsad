	function Vis.gameShotRestore()
		if next(Vis.gameShotOrig) == nil then
			return
		end
		for pe, o in pairs(Vis.gameShotOrig) do
			if pe.Parent then
				pcall(function()
					pe.Transparency = o.t
					pe.LightEmission = o.l
				end)
			end
		end
		table.clear(Vis.gameShotOrig)
	end
	function Vis.gameShotFxTick()
		if not cfg.noGameShotFx then
			Vis.gameShotRestore()
			return
		end
		
		
		if Game.frameId % 30 ~= 0 then
			return
		end
		local root = workspace:FindFirstChild("ViewModels")
		if not root then
			return
		end
		for _, d in ipairs(root:GetDescendants()) do
			if d.Name == "_muzzle" and d:IsA("Attachment") then
				for _, c in ipairs(d:GetChildren()) do
					if c:IsA("ParticleEmitter") and c.Name:sub(1, 7) ~= "Cocaine" and Vis.gameShotOrig[c] == nil then
						local pe = c :: any
						Vis.gameShotOrig[pe] = { t = pe.Transparency, l = pe.LightEmission }
						pcall(function()
							pe.Transparency = NumberSequence.new(1)
							pe.LightEmission = 0
						end)
					end
				end
			end
		end
		
		
		for pe in pairs(Vis.gameShotOrig) do
			if not pe:IsDescendantOf(game) then
				Vis.gameShotOrig[pe] = nil
			end
		end
	end
	
	
	
