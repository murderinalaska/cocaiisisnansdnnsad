		for _, hl in pairs(Vis.vmGlows) do
			pcall(hl.Destroy, hl)
		end
		table.clear(Vis.vmGlows)
	end
	
	function Vis.vmMotion()
		if not cfg.vmNoSway then
			return
		end
		local lf = Game.localFighter()
		local items = lf and type(lf.Items) == "table" and lf.Items
		if type(items) ~= "table" then
			return
		end
		for _, item in pairs(items) do
			local vm = type(item) == "table" and rawget(item, "ViewModel")
			if type(vm) == "table" then
				for name, value in pairs(Vis.VM_SPRINGS) do
					local spring = rawget(vm, name)
					if type(spring) == "table" then
						pcall(function()
							spring.Value = value
							
							
							
							if rawget(spring, "Target") ~= nil then
								spring.Target = value
							end
						end)
					end
				end
			end
		end
	end
	local CHAMS_BIND = "cocaine_chams"
	Vis.chamsBound = false
	function Vis.underViewmodel(inst: Instance): boolean
		local root = workspace:FindFirstChild("ViewModels")
		if root and inst:IsDescendantOf(root) then
			return true
		end
		local cam = workspace.CurrentCamera
		return cam ~= nil and inst:IsDescendantOf(cam)
	end
	
	
	function Vis.chamsHold()
		Vis.vmMotion()
		if not (cfg.vmChams or cfg.selfChams) then
			return
		end
		local matVm, reflVm = Vis.matOf(cfg.vmMaterial), Vis.reflOf(cfg.vmMaterial)
		local colVm = rgb(cfg.colVm)
		local matSelf, reflSelf = Vis.matOf(cfg.selfMaterial), Vis.reflOf(cfg.selfMaterial)
		local colSelf = rgb(cfg.colSelf)
		for p, st in pairs(Vis.chamsStore) do
			if p.Parent == nil then
				Vis.chamsStore[p] = nil
			elseif not (st.owner == "self" and Vis.underViewmodel(p)) then
				local vm = st.owner == "vm"
				local mat = if vm then matVm else matSelf
				local col = if vm then colVm else colSelf
				local refl = if vm then reflVm else reflSelf
				if p.Material ~= mat then
					p.Material = mat
				end
				if p.Color ~= col then
					p.Color = col
				end
				if p.Reflectance ~= refl then
					p.Reflectance = refl
				end
				if st.owner == "vm" and st.TextureID ~= nil and st.TextureID ~= "" and p:IsA("MeshPart") and (p :: any).TextureID ~= "" then
					pcall(function()
						(p :: any).TextureID = ""
					end)
				end
				for _, ch in ipairs(p:GetChildren()) do
					if ch:IsA("SurfaceAppearance") then
						st.appear = st.appear or {}
						st.appear[ch] = true
						ch.Parent = nil
					end
				end
			end
		end
		if cfg.selfChams then
			for ch, st in pairs(Vis.clothStore) do
				if ch.Parent and (ch :: any)[st.prop] ~= "" then
					(ch :: any)[st.prop] = ""
				end
			end
		end
	end
	function Vis.chamsBind(on: boolean)
		if on == Vis.chamsBound then
			return
		end
		Vis.chamsBound = on
		if on then
			RunService:BindToRenderStep(CHAMS_BIND, Enum.RenderPriority.Last.Value, function()
				local ok, err = pcall(Vis.chamsHold)
				if not ok then
					S.hookErr("chams", err)
				end
			end)
		else
			pcall(RunService.UnbindFromRenderStep, RunService, CHAMS_BIND)
		end
	end
	function Vis.chamsTick()
		
		
		
		local now = os.clock()
		local turningOff = (not cfg.vmChams and Vis.chamsOn.vm) or (not cfg.selfChams and Vis.chamsOn.self)
		if not turningOff and now - Vis.chamsAt < 0.2 then
			Vis.chamsBind(cfg.vmChams == true or cfg.selfChams == true or cfg.vmNoSway == true)
			return
		end
		Vis.chamsAt = now
		if cfg.vmChams then
			Vis.chamsOn.vm = true
			local mat, refl = Vis.matOf(cfg.vmMaterial), Vis.reflOf(cfg.vmMaterial)
			local col = rgb(cfg.colVm)
			local ltm = if cfg.vmAlpha > 0 and not cfg.hideViewmodel and not cfg.thirdPerson then cfg.vmAlpha else nil
			
			local arms = cfg.vmChamsArms == true
			for _, m in ipairs(Game.viewmodelModels()) do
				local weapon = Game.viewmodelWeapon(m)
				if weapon then
					for _, p in ipairs(Game.modelParts(weapon, 0.5)) do
						if p.Parent ~= nil and p:IsA("BasePart") and p.Transparency < 1 then
							Vis.chamsPart(p, "vm", mat, col, ltm, refl)
						end
					end
					if cfg.vmOutline then
						Vis.vmGlow(weapon, col)
					end
				end
				if arms and m:IsA("Model") then
					for _, c in ipairs(m:GetChildren()) do
						local nm = c.Name
						if nm:sub(1, 7) == "LeftArm" or nm:sub(1, 8) == "RightArm" then
							if c:IsA("BasePart") and c.Transparency < 1 then
								Vis.chamsPart(c, "vm", mat, col, ltm, refl)
							end
							for _, p in ipairs(Game.modelParts(c, 0.5)) do
								if p:IsA("BasePart") and p.Transparency < 1 then
									Vis.chamsPart(p, "vm", mat, col, ltm, refl)
								end
							end
						end
					end
				end
			end
			if not cfg.vmOutline then
				Vis.vmGlowDrop()
			end
		elseif Vis.chamsOn.vm then
			Vis.chamsOn.vm = false
			Vis.chamsRestore("vm")
			Vis.vmGlowDrop()
		end
		if cfg.selfChams then
			Vis.chamsOn.self = true
			local lf = Game.localFighter()
			local model = nil
			if lf then
				local _, m = Game.fighterBody(lf)
				model = m
			end
			if model then
				Vis.selfChams(model)
			end
		elseif Vis.chamsOn.self then
			Vis.chamsOn.self = false
			Vis.chamsRestore("self")
		end
		Vis.chamsBind(cfg.vmChams == true or cfg.selfChams == true or cfg.vmNoSway == true)
	end
	
	
	
	
	
	Vis.clothStore = S.keep()
	Vis.CLOTH_PROPS = { Shirt = "ShirtTemplate", Pants = "PantsTemplate", ShirtGraphic = "Graphic" }
	function Vis.selfSkip(p: BasePart): boolean
		local n = p.Name
		if p.Transparency >= 1 or n == "HumanoidRootPart" or n == "FakeMass" or n:sub(1, 6) == "Hitbox" or n:sub(1, 14) == "PhysicalHitbox" then
			return true
		end
		
		
		if Vis.underViewmodel(p) or n == "ItemVisual" or n:sub(1, 7) == "LeftArm" or n:sub(1, 8) == "RightArm" then
			return true
		end
		local tool = p:FindFirstAncestorOfClass("Tool")
		return tool ~= nil
	end
	function Vis.selfChams(model: Model)
		local mat, refl = Vis.matOf(cfg.selfMaterial), Vis.reflOf(cfg.selfMaterial)
		local col = rgb(cfg.colSelf)
		for _, d in ipairs(Game.modelParts(model, 0.5)) do
			if d.Parent ~= nil and d:IsA("BasePart") and not Vis.selfSkip(d) then
				Vis.chamsPart(d, "self", mat, col, nil, refl)
			end
		end
		for _, ch in ipairs(model:GetChildren()) do
			local prop = Vis.CLOTH_PROPS[ch.ClassName]
			if prop then
				if Vis.clothStore[ch] == nil then
					Vis.clothStore[ch] = { prop = prop, v = (ch :: any)[prop] }
				end
				if (ch :: any)[prop] ~= "" then
					(ch :: any)[prop] = ""
				end
			end
		end
		local hl = Vis.selfGlow
		
		if S.tpActive ~= true then
			if hl then
				pcall(hl.Destroy, hl)
				Vis.selfGlow = nil
			end
			return
		end
		if not (hl and hl.Parent == model) then
			if hl then
				pcall(hl.Destroy, hl)
			end
			hl = Instance.new("Highlight")
			hl.Name = "CocaineSelfGlow"
			hl.FillTransparency = 1
			hl.DepthMode = Enum.HighlightDepthMode.Occluded
			hl.Adornee = model
			hl.Parent = model
			Vis.selfGlow = hl
		end
		Vis.fxSet(hl, "OutlineColor", col)
		Vis.fxSet(hl, "OutlineTransparency", 0.35)
	end

	
	
	
	
	Vis.halo = nil 
	Vis.HALO_N = 24
	function Vis.haloDrop()
		if Vis.halo then
			local m = Vis.halo.model
