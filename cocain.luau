		Vis.fxInst.CocaineFx = p
		return p
	end

	
	
	
	Vis.FX_NEUTRAL = {
		CocaineGrade = { Brightness = 0, Contrast = 0, Saturation = 0, TintColor = Color3.new(1, 1, 1) },
		CocaineBloom = { Intensity = 0 },
		CocaineRays = { Intensity = 0 },
		CocaineDof = { FarIntensity = 0, NearIntensity = 0 },
	}
	Vis.fxAlpha = 1
	function Vis.fxEase(inst: any, prop: string, v: any, neutral: any?): boolean
		local sh = Vis.fxShadow[inst]
		if not sh then
			sh = {}
			Vis.fxShadow[inst] = sh
		end
		local cur = sh[prop]
		if cur == nil then
			cur = if neutral ~= nil then neutral else v
		end
		local n = Vis.wStep(prop, cur, v, Vis.fxAlpha)
		if n ~= sh[prop] then
			sh[prop] = n
			inst[prop] = n
		end
		return n == v
	end
	
	function Vis.fxRun(on: boolean, class: string, name: string, props: { [string]: any })
		local neutral = Vis.FX_NEUTRAL[name]
		if on then
			local inst = Vis.fxGet(class, name)
			for k, v in pairs(props) do
				Vis.fxEase(inst, k, v, neutral[k])
			end
			return
		end
		local inst = Vis.fxInst[name]
		if not inst then
			return
		end
		local settled = true
		for k, v in pairs(neutral) do
			if not Vis.fxEase(inst, k, v, nil) then
				settled = false
			end
		end
		if settled then
			Vis.fxDrop(name)
		end
	end
	Vis.fxProps = { grade = {}, bloom = {}, rays = {}, dof = {} }
	function Vis.postApply()
		local now = os.clock()
		local dt = math.clamp(now - (Vis.fxAt or now - 1 / 15), 0, 0.3)
		Vis.fxAt = now
		Vis.fxAlpha = 1 - math.exp(-dt / Vis.worldTau)
		local P = Vis.fxProps
		local g = P.grade
		
		
		
		
		local sharpen = if cfg.sharpenOn then math.clamp(cfg.sharpenAmount, 0, 100) / 100 else 0
		local cb = Vis.CB[cfg.colorBlind]
		local tint = rgb(cfg.gradeTint)
		if cb then
			tint = Color3.new(tint.R * cb.tint.R, tint.G * cb.tint.G, tint.B * cb.tint.B)
		end
		g.Brightness = cfg.gradeBrightness - 0.05 * sharpen
		g.Contrast = cfg.gradeContrast + 0.22 * sharpen
		g.Saturation = cfg.gradeSaturation + (if cb then cb.sat else 0) + 0.08 * sharpen
		g.TintColor = tint
		Vis.fxRun(cfg.worldGrade == true or sharpen > 0 or cb ~= nil, "ColorCorrectionEffect", "CocaineGrade", g)
		local b = P.bloom
		b.Intensity, b.Size, b.Threshold = cfg.bloomIntensity, cfg.bloomSize, cfg.bloomThreshold
		Vis.fxRun(cfg.worldBloom == true, "BloomEffect", "CocaineBloom", b)
		local r = P.rays
		r.Intensity, r.Spread = cfg.sunRaysIntensity, cfg.sunRaysSpread
		Vis.fxRun(cfg.worldSunRays == true, "SunRaysEffect", "CocaineRays", r)
		local d = P.dof
		d.FocusDistance, d.InFocusRadius, d.FarIntensity, d.NearIntensity = cfg.dofFocus, math.clamp(cfg.dofFocus * 0.5, 5, 50), cfg.dofBlur, 0
		Vis.fxRun(cfg.worldDof == true, "DepthOfFieldEffect", "CocaineDof", d)
	end

	
	
