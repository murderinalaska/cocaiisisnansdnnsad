	local function badgeFor(plr, on, kind)
		local g = badges[plr]
		local char = on and plr.Character
		local root = char and (char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart)
		if not root then
			if g then
				g:Destroy()
				badges[plr] = nil
			end
			return
		end
		kind = if kind == "nightly" then "nightly" else "max"
		if g and g.Parent and g.Adornee == root and g:GetAttribute("Kind") == kind then
			return
		end
		if g then
			g:Destroy()
		end
		g = Instance.new("BillboardGui")
		g:SetAttribute("Kind", kind)
		g.Name = "CocaineMaxBadge"
		g.Size = UDim2.fromOffset(64, 30)
		g.StudsOffsetWorldSpace = Vector3.new(0, BADGE_LIFT, 0)
		g.AlwaysOnTop = true
		g.LightInfluence = 0
		g.MaxDistance = 250
		g.Adornee = root
		
		
		local stB = findGlobal("CocaineState")
		local ext = type(stB) == "table" and type(stB.ext) == "table" and stB.ext or nil
		local build = ext and (if kind == "nightly" then ext.nightlyBadge else ext.maxBadge)
		local chip = type(build) == "function" and select(2, pcall(build, g, 20, true)) or nil
		if typeof(chip) ~= "Instance" and kind == "nightly" then
			chip = nightlyPlate(g)
		end
		if typeof(chip) == "Instance" then
			chip.AnchorPoint = Vector2.new(0.5, 0.5)
			chip.Position = UDim2.fromScale(0.5, 0.5)
			
			g.Size = UDim2.fromOffset(chip.Size.X.Offset + 16, 32)
		else
			
			local plate = Instance.new("Frame")
			plate.Size = UDim2.fromOffset(44, 20)
			plate.AnchorPoint = Vector2.new(0.5, 0.5)
			plate.Position = UDim2.fromScale(0.5, 0.5)
			plate.BackgroundColor3 = Color3.new(1, 1, 1)
			plate.BorderSizePixel = 0
			plate.Parent = g
			local cr = Instance.new("UICorner")
			cr.CornerRadius = UDim.new(0, 5)
			cr.Parent = plate
			local gr = Instance.new("UIGradient")
			gr.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 214, 214)),
				ColorSequenceKeypoint.new(0.52, Color3.fromRGB(255, 42, 42)),
				ColorSequenceKeypoint.new(1, Color3.fromRGB(139, 0, 0)),
			})
			gr.Rotation = 90
