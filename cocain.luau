	Combat.PARK_BOUND = 4194304
	
	Combat.parkHopState = {}
	function Combat.parkHopUpdate(key: string, me: Vector3, now: number): Vector3?
		local c = Combat.parkHopState[key]
		local hopEvery = if cfg.parkHopEveryFrame then 1 / math.clamp(cfg.defenseHopHz, 4, 12) else 8
		if not c or now - c.at >= hopEvery then
			local p = Combat.parkSpot(me, cfg.parkHopEveryFrame)
			if p then
				Combat.parkHopState[key] = { pos = p, at = now, anchor = (c and c.anchor) or p }
				return p
			end
		end
		return c and c.pos
	end
	function Combat.parkHopAnchor(key: string): Vector3?
		local c = Combat.parkHopState[key]
		return c and (c.anchor or c.pos)
	end
	function Combat.parkSpot(me: Vector3, fresh: boolean?): Vector3?
		local now = os.clock()
		local fc = Combat.farCache
		if not fresh and fc and fc.park and fc.pos and now - fc.at < 8 then
			return fc.pos
		end
		local lo = math.max(cfg.parkMinDist, Combat.PARK_BOUND * 1.05)
		local hi = math.max(cfg.parkMaxDist, lo)
		local y = math.max(me.Y + math.random() * 400 - 100, S.fpdh() + 400)
		local last = Combat.farLast
		for _ = 1, 8 do
			local d = lo + (hi - lo) * math.random()
			local s = if math.random() < 0.5 then d else -d
			local o = (math.random() * 2 - 1) * d
			local p = if math.random() < 0.5 then Vector3.new(s, y, o) else Vector3.new(o, y, s)
			if not (last and (p - last).Magnitude < Combat.FAR_GAP) and S.safe.check(p, Combat.farReq) then
				Combat.farCache = { key = "park", park = true, at = now, pos = p }
				Combat.farLast = p
				return p
			end
		end
		return nil
	end
	
	
	function Combat.awayTime(sec: number): number
		local j = math.clamp(cfg.parkAwayJitter, 0, 90) / 100
		return math.max(0.05, sec * (1 + (math.random() * 2 - 1) * j))
	end
	
