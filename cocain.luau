local function sanitize(cfg: any)
	
	
	if (tonumber(cfg.cfgRev) or 0) < 9 then
		if cfg.meleeRageRange == 40 then
			cfg.meleeRageRange = 80
		end
		cfg.cfgRev = 9
	end
	
	if (tonumber(cfg.cfgRev) or 0) < 10 then
		if cfg.autokillDuration == 3 then
			cfg.autokillDuration = 6
		end
		cfg.cfgRev = 10
	end
	
	
	if (tonumber(cfg.cfgRev) or 0) < 11 then
		if (tonumber(cfg.voidSpamDist) or 0) <= 90000 then
			cfg.voidSpamDist = 10000000
		end
		cfg.cfgRev = 11
	end
	
	if (tonumber(cfg.cfgRev) or 0) < 12 then
		local was = cfg.csync == true
		cfg.rageCsync = was
		cfg.posDesync = was
		if cfg.csyncMode == "Flicker" or cfg.csyncMode == "Full" then
			cfg.posDesyncMode = cfg.csyncMode
		end
		if type(cfg.csyncDist) == "number" then
			cfg.posDesyncDist = cfg.csyncDist
		end
		cfg.espTeammates = false
		
		cfg.teamPerf = true
		if cfg.espChamsBlend == nil then
			cfg.espChamsBlend = true
		end
		if type(cfg.hudPos) == "table" and type(cfg.hudPos.voidspam) == "table" and cfg.hudPos.combatBar == nil then
			cfg.hudPos.combatBar = cfg.hudPos.voidspam
			cfg.hudPos.voidspam = nil
		end
		if type(cfg.binds) == "table" and type(cfg.binds.csync) == "table" then
			if cfg.binds.rageCsync == nil then
				cfg.binds.rageCsync = cfg.binds.csync
			end
			if cfg.binds.posDesync == nil then
				cfg.binds.posDesync = cfg.binds.csync
			end
			cfg.binds.csync = nil
		end
		cfg.cfgRev = 12
	end
	if (tonumber(cfg.cfgRev) or 0) < 13 then
		cfg.cfgRev = 13
	end
	
