					if real[wa] == nil or cur ~= real[wa] then
						real[ka] = if cur == nil then false else cur
					end
					pcall(plr.SetAttribute, plr, attr, want)
					real[wa] = want
				end
				if lsv then
					local v = lsv.Value
					if tostring(v) ~= tostring(want) then
						if real[wl] == nil or tostring(v) ~= tostring(real[wl]) then
							real[kl] = v
						end
						pcall(function()
							lsv.Value = if lsv:IsA("StringValue") then tostring(want) else want
						end)
						real[wl] = want
					end
				end
			elseif real and (real[ka] ~= nil or real[kl] ~= nil) then
				
				if real[ka] ~= nil then
					pcall(plr.SetAttribute, plr, attr, if real[ka] == false then nil else real[ka])
				end
				if lsv and real[kl] ~= nil then
					pcall(function()
						lsv.Value = real[kl]
					end)
				end
				real[ka], real[kl], real[wa], real[wl] = nil, nil, nil, nil
			end
		end
	end

	
	
	
	
	
	
	local ID = { util = nil, orig = nil, spoofs = keep(), roleReal = keep(), colored = keep(), renamed = keep() }
	local GLYPH_VERIFIED, GLYPH_PREMIUM = utf8.char(57344), utf8.char(57345)
	local ROLE_ATTR = { roblox = "IsRobloxEmployee", influencer = "IsInfluencer" }
	local TEAM_ROLE = nil
	pcall(function()
		TEAM_ROLE = tonumber(require(game:GetService("ReplicatedStorage").Modules.CONSTANTS).TEAM_GROUP_ROLE_ID)
	end)
	local function idUtil()
		if ID.util == nil then
			local ok, m = pcall(function()
				return require(game:GetService("ReplicatedStorage").Modules.Utility)
			end)
			ID.util = if ok and type(m) == "table" and type(m.GetName) == "function" then m else false
		end
		return ID.util or nil
	end
	local function idInstall()
		local U = idUtil()
		if not U or ID.orig then
			return
		end
		local orig = U.GetName
		ID.orig = orig
		U.GetName = function(self, plr, name, noPremium, ...)
			local sp = typeof(plr) == "Instance" and ID.spoofs[plr] or nil
			if not sp then
				return orig(self, plr, name, noPremium, ...)
			end
			local n = if type(sp.displayName) == "string" and sp.displayName ~= "" then sp.displayName
				elseif sp.username and name == plr.Name then sp.username
				else name
			local mark
			if sp.verified then
				mark = " " .. GLYPH_VERIFIED
			elseif sp.premium and not noPremium then
				mark = " " .. GLYPH_PREMIUM
			else
				mark = orig(self, plr, "", noPremium, ...) 
			end
			return tostring(n) .. tostring(mark or "")
		end
	end
	local function idUninstall()
		local U = idUtil()
		if U and ID.orig and U.GetName ~= ID.orig then
			U.GetName = ID.orig
		end
		ID.orig = nil
	end
	
	for _, env in ipairs({ G, _G }) do
		pcall(rawset, env, "CocaineSpoofReal", function(plr, key)
			local r = ID.roleReal[plr]
			if r and r[key] ~= nil then
				return if r[key] == false then nil else r[key]
			end
			return plr:GetAttribute(key)
		end)
	end
	local function setRoleAttr(plr, key, value)
		local r = ID.roleReal[plr]
		if value == nil then
			if r and r[key] ~= nil then
				pcall(plr.SetAttribute, plr, key, if r[key] == false then nil else r[key])
				r[key] = nil
			end
			return
		end
		if not r then
			r = {}
			ID.roleReal[plr] = r
		end
		if r[key] == nil then
			local cur = plr:GetAttribute(key)
			r[key] = if cur == nil then false else cur
		end
		if plr:GetAttribute(key) ~= value then
			pcall(plr.SetAttribute, plr, key, value)
		end
	end
	local function applyRole(plr, role)
		for k, attr in pairs(ROLE_ATTR) do
			setRoleAttr(plr, attr, if role == k then true else nil)
		end
		if role == "developer" and TEAM_ROLE then
			local r = ID.roleReal[plr]
			local base = if r and r.GroupRoleIDs ~= nil then r.GroupRoleIDs else plr:GetAttribute("GroupRoleIDs")
			local ids = {}
			if type(base) == "string" then
				local ok, t = pcall(HttpService.JSONDecode, HttpService, base)
				if ok and type(t) == "table" then
					ids = t
				end
			end
			if not table.find(ids, TEAM_ROLE) then
				table.insert(ids, TEAM_ROLE)
			end
			setRoleAttr(plr, "GroupRoleIDs", HttpService:JSONEncode(ids))
		else
			setRoleAttr(plr, "GroupRoleIDs", nil)
		end
	end
	
	
	
	
	local nameLabels = keep()
	local function trackLabel(d)
		if d:IsA("TextLabel") or d:IsA("TextButton") then
			nameLabels[d] = true
		end
	end
	local pg = LP:FindFirstChildOfClass("PlayerGui")
	local function trackListLabel(d)
		if not (d:IsA("TextLabel") or d:IsA("TextButton")) then
			return
		end
		local a = d.Parent
		while a and a ~= pg do
			if a.Name:find("PlayerList", 1, true) or a.Name:find("Scoreboard", 1, true) then
				nameLabels[d] = true
				return
			end
			a = a.Parent
		end
	end
	if pg then
		for _, d in ipairs(pg:GetDescendants()) do
			trackListLabel(d)
		end
		pg.DescendantAdded:Connect(function(d)
			if alive() then
				trackListLabel(d)
			end
		end)
	end
	local function idPass()
		local active = next(ID.spoofs) ~= nil
		if not active and next(ID.renamed) == nil and next(ID.colored) == nil then
			return
		end
		local list = {}
		for plr, sp in pairs(ID.spoofs) do
			if plr.Parent then
				local color = if type(sp.nameColor) == "string" and #sp.nameColor == 6 then Color3.fromHex(sp.nameColor) else nil
				table.insert(list, { real = plr.DisplayName, fake = sp.displayName, color = color, realUser = plr.Name, fakeUser = sp.username })
				local char = plr.Character
				local root = char and (char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart)
				if root then
					local tag = root:FindFirstChild("NametagGui")
					if tag then
						for _, d in ipairs(tag:GetDescendants()) do
							trackLabel(d)
						end
					end
					
					
					
					local nd = tag and tag:FindFirstChild("Elements") and tag.Elements:FindFirstChild("NameDisplay")
					local dn = nd and nd:FindFirstChild("DisplayName")
					local U = ID.orig and idUtil()
					if dn and dn:IsA("TextLabel") and sp.displayName and U then
						local okN, want = pcall(U.GetName, U, plr, plr.DisplayName)
						if okN and type(want) == "string" and dn.Text ~= want and not dn.Text:find(sp.displayName, 1, true) then
							ID.renamed[dn] = ID.renamed[dn] or dn.Text
							dn.Text = want
						end
					end
				end
			end
		end
		for l in pairs(nameLabels) do
			if l.Parent then
				local t = l.Text
				local hit = nil
				for _, e in ipairs(list) do
					if t ~= "" and (t == e.real or t:sub(1, #e.real + 1) == e.real .. " ") and e.fake then
						
						ID.renamed[l] = ID.renamed[l] or t
						l.Text = e.fake .. t:sub(#e.real + 1)
						t = l.Text
					end
					
					if e.fakeUser and t ~= "" and (t == "@" .. e.realUser or t == e.realUser) then
						ID.renamed[l] = ID.renamed[l] or t
						l.Text = (if t:sub(1, 1) == "@" then "@" else "") .. e.fakeUser
						t = l.Text
					end
					local shown = e.fake or e.real
					if t ~= "" and (t == shown or t:sub(1, #shown + 1) == shown .. " ") then
						hit = e
						break
					end
				end
				if hit and hit.color then
					if ID.colored[l] == nil then
						ID.colored[l] = l.TextColor3
					end
					if l.TextColor3 ~= hit.color then
						l.TextColor3 = hit.color
					end
				elseif ID.colored[l] ~= nil then
					l.TextColor3 = ID.colored[l]
					ID.colored[l] = nil
				end
			else
				nameLabels[l] = nil
			end
		end
		if not active then
			for l, t in pairs(ID.renamed) do
				if l.Parent then
					pcall(function()
						l.Text = t
					end)
				end
				ID.renamed[l] = nil
			end
		end
	end
	local function applyIdentity(plr, spoof)
		local want = nil
		if type(spoof) == "table" and (spoof.displayName or spoof.username or spoof.nameColor or spoof.verified or spoof.premium or spoof.role) then
			local user = type(spoof.username) == "string" and spoof.username:gsub("[^%w_]", ""):sub(1, 20) or ""
			want = {
				username = if #user >= 3 then user else nil,
				displayName = type(spoof.displayName) == "string" and spoof.displayName:gsub("[%c<>&]", "") or nil,
				nameColor = spoof.nameColor,
				verified = spoof.verified == true,
				premium = spoof.premium == true,
				role = spoof.role,
			}
			if want.displayName == "" then
				want.displayName = nil
			end
			idInstall()
		end
		ID.spoofs[plr] = want
		applyRole(plr, want and want.role or nil)
	end
