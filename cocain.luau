	function Vis.sxRootGet(): ScreenGui?
		local g = Vis.sxRoot
		if g and g.Parent then
			return g
		end
		g = Instance.new("ScreenGui")
		g.Name = "CocaineScreenFx"
		g.IgnoreGuiInset = true
		g.ResetOnSpawn = false
		
		g.DisplayOrder = 400
		
		if not Game.parentGui(g) then
			local pg = LP:FindFirstChildOfClass("PlayerGui")
			if not (pg and pcall(function()
				g.Parent = pg
			end)) then
				g:Destroy()
				Vis.sxRoot = nil
				return nil
			end
		end
		Vis.sxRoot = g
		return g
	end
	
	function Vis.sxEdge(g: ScreenGui, name: string, color: Color3, rot: number, size: UDim2, pos: UDim2): Frame
		local f = Instance.new("Frame")
		f.Name = name
		f.BorderSizePixel = 0
		f.BackgroundColor3 = color
		f.BackgroundTransparency = 1
		f.Size = size
		f.Position = pos
		f.ZIndex = 1
		local gr = Instance.new("UIGradient")
		gr.Rotation = rot
		
		
		
		
		gr.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(0.12, 0.10),
			NumberSequenceKeypoint.new(0.26, 0.26),
			NumberSequenceKeypoint.new(0.42, 0.45),
			NumberSequenceKeypoint.new(0.58, 0.63),
			NumberSequenceKeypoint.new(0.78, 0.85),
			NumberSequenceKeypoint.new(1, 1),
		})
		gr.Parent = f
		f.Parent = g
		return f
	end
	
	function Vis.sxSplit(g: ScreenGui, name: string, color: Color3): Frame
		local f = Instance.new("Frame")
		f.Name = name
		f.BorderSizePixel = 0
		f.BackgroundColor3 = color
		f.BackgroundTransparency = 1
		
		f.Size = UDim2.new(1, 8, 1, 0)
		f.Position = UDim2.new(0, -4, 0, 0)
		f.ZIndex = 1
		local gr = Instance.new("UIGradient")
		gr.Rotation = 90
		gr.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(0.5, 1),
			NumberSequenceKeypoint.new(1, 0),
		})
		gr.Parent = f
		f.Parent = g
		return f
	end
	
	
	
