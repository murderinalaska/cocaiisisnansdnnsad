	function Vis.materialLabel(v: any): string
		return Vis.MAT_LABELS[v] or tostring(v)
	end
	function Vis.matOf(v: any): Enum.Material
		return Vis.MATERIALS[v] or Enum.Material.ForceField
	end
	function Vis.reflOf(v: any): number
		return Vis.MAT_REFL[v] or 0
	end
	Vis.chamsStore = S.keep()
	function Vis.chamsPart(p: BasePart, owner: string, mat: Enum.Material, col: Color3, ltm: number?, refl: number?)
		local st = Vis.chamsStore[p]
		if not st then
			st = { owner = owner, Material = p.Material, Color = p.Color, Reflectance = p.Reflectance, LTM = p.LocalTransparencyModifier, kids = {}, appear = {} }
			if p:IsA("MeshPart") then
				st.TextureID = (p :: any).TextureID
			end
			for _, ch in ipairs(p:GetChildren()) do
				if ch:IsA("Decal") or ch:IsA("Texture") then
					st.kids[ch] = ch.Transparency
				elseif ch:IsA("SurfaceAppearance") then
					st.appear[ch] = true
				end
			end
			Vis.chamsStore[p] = st
		end
		if st.owner ~= owner then
			return
		end
		if p.Material ~= mat then
			p.Material = mat
		end
		if p.Color ~= col then
			p.Color = col
		end
		local r = refl or 0
		if p.Reflectance ~= r then
			p.Reflectance = r
		end
		
		
		if owner == "vm" and st.TextureID ~= nil and st.TextureID ~= "" and p:IsA("MeshPart") and (p :: any).TextureID ~= "" then
			pcall(function()
				(p :: any).TextureID = ""
			end)
		end
		for ch in pairs(st.kids) do
			if ch.Parent == p and ch.Transparency < 1 then
				ch.Transparency = 1
			end
		end
		
		
		st.appear = st.appear or {}
		for _, ch in ipairs(p:GetChildren()) do
			if ch:IsA("SurfaceAppearance") then
				st.appear[ch] = true
				ch.Parent = nil
			end
		end
		if ltm and p.LocalTransparencyModifier < ltm then
			p.LocalTransparencyModifier = ltm
			st.ltmWrote = true 
		end
	end
	function Vis.chamsRestore(owner: string?)
		if owner == nil or owner == "self" then
			for ch, st in pairs(Vis.clothStore or {}) do
				pcall(function()
					if ch.Parent then
						(ch :: any)[st.prop] = st.v
					end
				end)
				Vis.clothStore[ch] = nil
			end
			if Vis.selfGlow then
				pcall(Vis.selfGlow.Destroy, Vis.selfGlow)
				Vis.selfGlow = nil
			end
		end
		for p, st in pairs(Vis.chamsStore) do
			if owner == nil or st.owner == owner then
				pcall(function()
					if p.Parent then
						p.Material = st.Material
						p.Color = st.Color
						if st.Reflectance ~= nil then
							p.Reflectance = st.Reflectance
						end
						if st.TextureID ~= nil then
							(p :: any).TextureID = st.TextureID
						end
						
						
						
						
						if st.ltmWrote and not cfg.hideViewmodel and not cfg.hideHands then
							p.LocalTransparencyModifier = st.LTM
						end
						for ch, tr in pairs(st.kids) do
							if ch.Parent == p then
								ch.Transparency = tr
							end
						end
						for sa in pairs(st.appear or {}) do
							if sa.Parent == nil then
								sa.Parent = p
							end
						end
					end
				end)
				Vis.chamsStore[p] = nil
			end
		end
	end
