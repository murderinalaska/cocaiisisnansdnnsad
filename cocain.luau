	function Vis.screenFxApply()
		local wantV = cfg.vignetteOn == true
		local wantA = cfg.aberrationOn == true
		local wantG = cfg.grainOn == true
		local wantF = (Vis.sxFlash or 0) > 0.01
		if not (wantV or wantA or wantG or wantF) then
			if Vis.sxRoot then
				Vis.sxRoot:Destroy()
			end
			Vis.sxRoot, Vis.sx = nil, {}
			return
		end
		local g = Vis.sxRootGet()
		if not g then
			return
		end
		local S1 = Vis.sx
		if wantF then
			local fl = S1.flash
			if not (fl and fl.Parent) then
				fl = Instance.new("Frame")
				fl.Name = "CocaineStormFlash"
				fl.BorderSizePixel = 0
				fl.BackgroundColor3 = Color3.fromRGB(226, 236, 255)
				fl.Size = UDim2.fromScale(1, 1)
				fl.ZIndex = 1
				fl.Parent = g
				S1.flash = fl
			end
			fl.BackgroundTransparency = 1 - math.clamp(Vis.sxFlash, 0, 1)
		end
		if wantV then
			local a = 0.62 * math.clamp(cfg.vignetteAmount, 0, 100) / 100
			local edges = S1.vig
			if not edges then
				local black = Color3.new(0, 0, 0)
				
				
				
				edges = {
					Vis.sxEdge(g, "CocaineVigTop", black, 0, UDim2.new(1, 0, 0.26, 0), UDim2.new(0, 0, 0, 0)),
					Vis.sxEdge(g, "CocaineVigBottom", black, 180, UDim2.new(1, 0, 0.26, 0), UDim2.new(0, 0, 0.74, 0)),
					Vis.sxEdge(g, "CocaineVigLeft", black, 90, UDim2.new(0.2, 0, 0.48, 0), UDim2.new(0, 0, 0.26, 0)),
					Vis.sxEdge(g, "CocaineVigRight", black, 270, UDim2.new(0.2, 0, 0.48, 0), UDim2.new(0.8, 0, 0.26, 0)),
				}
				S1.vig = edges
			end
			for _, e in ipairs(edges) do
				e.BackgroundTransparency = 1 - a
			end
		elseif S1.vig then
			for _, e in ipairs(S1.vig) do
				e:Destroy()
			end
			S1.vig = nil
		end
		if wantA then
			local a = 0.34 * math.clamp(cfg.aberrationAmount, 0, 100) / 100
			
			
			local off = math.floor(0.5 + 3 * math.clamp(cfg.aberrationAmount, 0, 100) / 100)
			local pair = S1.ab
			if not pair then
				pair = {
					Vis.sxSplit(g, "CocaineAbRed", Color3.fromRGB(255, 64, 64)),
					Vis.sxSplit(g, "CocaineAbCyan", Color3.fromRGB(64, 255, 255)),
				}
				S1.ab = pair
			end
			pair[1].BackgroundTransparency = 1 - a
			pair[2].BackgroundTransparency = 1 - a
			pair[1].Position = UDim2.new(0, -4 - off, 0, 0)
			pair[2].Position = UDim2.new(0, -4 + off, 0, 0)
		elseif S1.ab then
			for _, e in ipairs(S1.ab) do
				e:Destroy()
			end
			S1.ab = nil
		end
		if wantG then
			local im = S1.grain
			if not (im and im.Parent) then
				im = Instance.new("ImageLabel")
				im.Name = "CocaineGrain"
				im.BackgroundTransparency = 1
				im.Image = Vis.dotTexture()
				im.ScaleType = Enum.ScaleType.Tile
				im.TileSize = UDim2.new(0, 3, 0, 3)
				im.Size = UDim2.fromScale(1.05, 1.05)
				im.ZIndex = 1
				im.Parent = g
				S1.grain = im
			end
			im.ImageTransparency = 1 - 0.45 * math.clamp(cfg.grainAmount, 0, 100) / 100
			
			
			local tx = math.random(0, 2)
			local ty = math.random(0, 2)
			im.Position = UDim2.new(0, -tx, 0, -ty)
		elseif S1.grain then
			S1.grain:Destroy()
			S1.grain = nil
		end
	end
