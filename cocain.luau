	Game.pilot = { layers = {}, events = {} }
	do
		local P = Game.pilot
		P.CHAINS = {
			send = { "trampoline", "identity", "bare" }, 
			rotation = { "script", "rewrite" }, 
			fire = { "game", "vim", "executor" }, 
			wrapper = { "cclosure", "raw", "restore" }, 
			payload = { "claim", "rotation" }, 
			namecall = { "setnc", "index", "off" }, 
			actions = { "game", "vim", "executor" }, 
			shield = { "full", "safe" }, 
		}
		P.ORDER = { "send", "rotation", "fire", "wrapper", "payload", "namecall", "actions", "shield" }
		
		P.LEARN_TTL = 3 * 86400
		local CAN = {
			trampoline = function()
				return EXEC.caps.trampoline
			end,
			identity = function()
				return EXEC.caps.identity
			end,
			executor = function()
				return EXEC.caps.mouse
			end,
			cclosure = function()
				return not EXEC.isVolt and type(EXEC.newcclosure) == "function"
			end,
			setnc = function()
				return type(EXEC.setnamecallmethod) == "function"
			end,
		}
		function P.available(opt: string): boolean
			local f = CAN[opt]
			if not f then
				return true
			end
			local ok, yes = pcall(f)
			return ok and yes == true
		end
		local function learned(): any
			local mine = cfg.compatLearned[EXECUTOR_NAME]
			if type(mine) ~= "table" then
				mine = {}
				cfg.compatLearned[EXECUTOR_NAME] = mine
			end
			return mine
		end
		function P.layer(name: string): any
			local L = P.layers[name]
			if L then
				return L
			end
			local chain = P.CHAINS[name]
			L = { name = name, chain = chain, i = 1, stats = {}, why = "default", switches = 0 }
			while L.i < #chain and not P.available(chain[L.i]) do
				L.i += 1
			end
			local rec = learned()[name]
			if type(rec) == "table" then
				local idx = table.find(chain, rec.o)
				if os.time() - rec.at >= P.LEARN_TTL then
					learned()[name] = nil 
				elseif idx and P.available(rec.o) then
					L.i, L.why = idx, "learned"
				end
			end
			P.layers[name] = L
			return L
		end
		function P.get(name: string): string
			local L = P.layers[name] or P.layer(name)
			return L.chain[L.i]
		end
		local function stat(L: any, opt: string): any
			local s = L.stats[opt]
			if not s then
				s = { ok = 0, fail = 0, run = 0 }
				L.stats[opt] = s
			end
			return s
		end
		function P.ok(name: string, opt: string?)
			local L = P.layer(name)
			local s = stat(L, opt or L.chain[L.i])
			s.ok += 1
			s.run = 0
		end
		function P.switched(L: any, from: string, to: string, why: string)
			learned()[L.name] = { o = to, at = os.time() }
			saveConfigSoon()
			log("WARN", ("compat: %s %s → %s (%s) on %s"):format(L.name, tostring(from), tostring(to), tostring(why), EXECUTOR_NAME))
			table.insert(P.events, { t = os.time(), layer = L.name, from = from, to = to, why = why })
			if #P.events > 40 then
				table.remove(P.events, 1)
			end
			local cb = S.pilotEvent 
			if type(cb) == "function" then
				pcall(cb, L.name, from, to, why)
			end
		end
		
		function P.set(name: string, opt: string, why: string): boolean
			local L = P.layer(name)
			local idx = table.find(L.chain, opt)
			if not idx or idx == L.i or not P.available(opt) then
				return false
			end
			local from = L.chain[L.i]
			L.i, L.why = idx, why
			L.switches += 1
			P.switched(L, from, opt, why)
			return true
		end
		
		
		function P.fail(name: string, why: string, need: number?): string?
			local L = P.layer(name)
			local cur = L.chain[L.i]
			local s = stat(L, cur)
			s.fail += 1
			s.run += 1
			s.why = why
			if s.run < (need or 3) then
				return nil
			end
			local nxt = L.i + 1
			while nxt <= #L.chain and not P.available(L.chain[nxt]) do
				nxt += 1
			end
			if nxt > #L.chain then
				return nil
			end
			L.i, L.why = nxt, why
			L.switches += 1
			s.run = 0
			P.switched(L, cur, L.chain[nxt], why)
			return L.chain[nxt]
		end
		function P.summary(): any
			local out = {}
			for _, name in ipairs(P.ORDER) do
				local L = P.layer(name)
				local cur = L.chain[L.i]
				local s = L.stats[cur]
				out[name] = { o = cur, why = L.why, sw = L.switches, ok = if s then s.ok else 0, fail = if s then s.fail else 0 }
			end
			return out
		end
		
		function P.line(): string
			local parts = {}
			for _, name in ipairs(P.ORDER) do
				local L = P.layer(name)
				table.insert(parts, name .. "=" .. L.chain[L.i] .. (if L.why ~= "default" then "*" else ""))
			end
			return table.concat(parts, " ")
		end
	end
