	function HUD.notesTick(now: number)
		local N = HUD.notes
		if not N then
			return
		end
		local list = S.hitNotes
		if HUD.editMode and #list == 0 then
			list = { { t = now - 1, text = '<font color="#c89bff">hit</font> Target in the head <b>-54</b>' } }
		end
		for i = #list, 1, -1 do
			if now - list[i].t > HUD.NOTE_LIFE and not HUD.editMode then
				table.remove(list, i)
			end
		end
		for i, row in ipairs(N.rows) do
			local note = list[i]
			local l = row.label
			if note and cfg.hitNotify ~= false then
				local age = now - note.t
				local aIn = math.clamp(age / 0.15, 0, 1)
				local aOut = if HUD.editMode then 1 else math.clamp((HUD.NOTE_LIFE - age) / 0.5, 0, 1)
				local a = math.min(aIn, aOut)
				if not l.Visible then
					l.Visible = true
				end
				if row.text ~= note.text then
					row.text = note.text
					l.Text = note.text
				end
				l.TextTransparency = 1 - a
				l.TextStrokeTransparency = 1 - a * 0.4
				local ease = 1 - (1 - aIn) ^ 3
				l.Position = UDim2.fromOffset(math.floor((1 - ease) * 24 + 0.5), (i - 1) * 19)
			elseif l.Visible then
				l.Visible = false
				row.text = nil
			end
		end
	end
	function HUD.targetFighter(): any
		if ak.state ~= "idle" and ak.state ~= "done" and ak.fighter then
			return ak.fighter
