	Input.gameInputOk = 0
	Input.gameInputFail = 0
	function Input.gameInput(name: string): boolean
		local mc = Input.mechanics()
		if type(mc) ~= "table" or type(mc.EquippedItemInput) ~= "function" then
			return false
		end
		if name == "StartShooting" then
			
			S.ourShotUntil = os.clock() + 0.15
			S.spoofUntil = math.max(S.spoofUntil or 0, os.clock() + 0.6)
			S.firing = true
			local press = S.shotPress
			if press then
				pcall(press, "auto")
			end
		end
		local ok, err = Game.asShotCode(mc.EquippedItemInput, mc, name)
		if ok then
			Input.gameInputOk += 1
		else
			Input.gameInputFail += 1
			S.hookErr("game input " .. name, err)
		end
		return ok
	end
	
	
	function Input.simulate(name: string, holdSec: number?): boolean
		local mc = Input.mechanics()
		if type(mc) ~= "table" or type(mc.SimulateInputBegan) ~= "function" then
			return false
		end
		local ok, err = Game.asShotCode(mc.SimulateInputBegan, mc, name, false)
		if not ok then
			S.hookErr("simulate " .. name, err)
			return false
		end
		task.delay(holdSec or 0.06, function()
			if S.alive and type(mc.SimulateInputEnded) == "function" then
				Game.asShotCode(mc.SimulateInputEnded, mc, name)
			end
		end)
		return true
	end
	
	
	
	Input.SLOT_INPUT = { "EquipPrimary", "EquipSecondary", "EquipMelee", "EquipUtility" }
	Input.KEY_DEFAULTS = { Reload = Enum.KeyCode.R, QuickMelee = Enum.KeyCode.F, EquipPrimary = Enum.KeyCode.One, EquipSecondary = Enum.KeyCode.Two, EquipMelee = Enum.KeyCode.Three, EquipUtility = Enum.KeyCode.Four }
	Input.DIGIT_VK = { Zero = 0x30, One = 0x31, Two = 0x32, Three = 0x33, Four = 0x34, Five = 0x35 }
	
	function Input.keyFor(name: string): any
		local IL = Input.inputLib
		if IL == nil then
			local mods = ReplicatedStorage:FindFirstChild("Modules")
			IL = Game.requireIfLoaded(mods and mods:FindFirstChild("InputLibrary")) or false
			Input.inputLib = IL
		end
		if IL and type(IL.GetInputs) == "function" then
			local ok, list = pcall(IL.GetInputs, IL, name)
			if ok and type(list) == "table" then
				for _, v in ipairs(list) do
					if typeof(v) == "EnumItem" and (v.EnumType == Enum.KeyCode or v.EnumType == Enum.UserInputType) then
						return v
					end
				end
			end
		end
		return Input.KEY_DEFAULTS[name]
	end
	
	function Input.pressKey(key: any, via: string, holdSec: number?): boolean
		if typeof(key) ~= "EnumItem" then
			return false
		end
		local hold = holdSec or 0.06
		if key.EnumType == Enum.UserInputType then
			local btn = if key == Enum.UserInputType.MouseButton2 then 1 else 0
			local press = if via == "vim" then vimMouse else execMouse
			if not press(true, btn) then
				return false
			end
			task.delay(hold, function()
				press(false, btn)
			end)
			return true
		end
		if via == "vim" then
			if not VIM then
				return false
			end
			if not pcall(VIM.SendKeyEvent, VIM, true, key, false, game) then
				return false
			end
			task.delay(hold, function()
				pcall(VIM.SendKeyEvent, VIM, false, key, false, game)
			end)
			return true
		end
		local vk = Input.DIGIT_VK[key.Name] or Input.vk(key.Name)
		if not (vk and EXEC.keypress and EXEC.keyrelease) or not pcall(EXEC.keypress, vk) then
			return false
		end
		task.delay(hold, function()
			pcall(EXEC.keyrelease, vk)
		end)
		return true
	end
	function Input.action(name: string, holdSec: number?): boolean
		local mode = Game.pilot.get("actions")
		local ok = false
		if mode == "game" then
			local slot = table.find(Input.SLOT_INPUT, name)
			local lf = Game.localFighter()
			if name == "Reload" then
				ok = Input.gameInput("StartReloading")
			elseif slot and lf and type(lf.EquipItem) == "function" then
				
				ok = Game.asShotCode(lf.EquipItem, lf, slot) == true
			else
				ok = Input.simulate(name, holdSec)
			end
		else
			ok = Input.pressKey(Input.keyFor(name), mode, holdSec)
		end
		if ok then
			Input.confirm(name, mode)
		end
		return ok
	end
	
	
	Input.pendingConfirm = nil
	function Input.confirm(name: string, mode: string)
		if Input.pendingConfirm ~= nil then
			return
		end
		local gs = S.gameState
		local item = gs and gs.item
		if name == "Reload" and type(item) == "table" and type(gs.ammo) == "number" then
			Input.pendingConfirm = { name = name, mode = mode, item = item, ammo = gs.ammo, due = os.clock() + 4.5 }
		elseif table.find(Input.SLOT_INPUT, name) then
			Input.pendingConfirm = { name = name, mode = mode, item = item, due = os.clock() + 0.9 }
		end
	end
	function Input.confirmTick()
		local pc = Input.pendingConfirm
		if pc == nil then
			return
		end
		local gs = S.gameState
		local done
		if pc.name == "Reload" then
			if not gs or gs.item ~= pc.item then
				Input.pendingConfirm = nil 
				return
			end
			done = type(gs.ammo) == "number" and gs.ammo > pc.ammo
		else
			done = gs ~= nil and gs.item ~= pc.item
		end
		if done then
			Input.pendingConfirm = nil
			Game.pilot.ok("actions")
			return
		end
		if os.clock() < pc.due then
			return
		end
		Input.pendingConfirm = nil
		if (S.pingMs or 0) > 600 or not (gs and gs.alive) then
			return
		end
		local nxt = Game.pilot.fail("actions", pc.name .. " did nothing (" .. pc.mode .. ")", 2)
		if nxt then
			notify(("%s wasn't registering — switched to %s input"):format(pc.name, nxt), 4, "warn")
		end
	end
	
	
	
	
	
	
	local adsHeld = false
	Input.adsViaMouse = false 
	Input.holds = { ads = {}, rmb = {} }
	Input.HOLD_TTL = 0.5
	Input.holdItem = nil
	Input.releases = {} 
	local function adsRaw(on: boolean)
		adsHeld = on
		if on then
			
			if Game.pilot.get("actions") == "game" and Input.gameInput("StartAiming") then
				Input.adsViaMouse = false
			else
				Input.adsViaMouse = true
				Input.holds.rmb.ads = math.huge 
			end
		else
			local viaMouse = Input.adsViaMouse
			Input.adsViaMouse = false
			
			
			if viaMouse or not Input.gameInput("FinishAiming") then
				Input.holds.rmb.ads = nil
			end
		end
	end
	function Input.hold(kind: string, owner: string, on: boolean)
		local t = Input.holds[kind]
		if t then
			t[owner] = if on then os.clock() else nil
		end
	end
	
	function Input.playerHoldsAim(): boolean
		if rmbHeld then
			return false
		end
		local ok, down = pcall(UIS.IsMouseButtonPressed, UIS, Enum.UserInputType.MouseButton2)
		return ok and down == true
	end
	function Input.applyHolds()
		local wantAds = next(Input.holds.ads) ~= nil
		if wantAds ~= adsHeld then
			if not wantAds and not Input.adsViaMouse and Input.playerHoldsAim() then
				adsHeld = false 
			else
				adsRaw(wantAds)
			end
		end
		local wantRmb = next(Input.holds.rmb) ~= nil
		if wantRmb ~= rmbHeld then
			Input.setRightMouse(wantRmb)
		end
	end
	function Input.releaseAll(why: string)
		local any = next(Input.holds.ads) ~= nil or next(Input.holds.rmb) ~= nil or adsHeld or rmbHeld
		table.clear(Input.holds.ads)
		table.clear(Input.holds.rmb)
		Input.applyHolds()
		if any then
			Input.releases[why] = (Input.releases[why] or 0) + 1
			log("DEBUG", "input: every hold released (" .. tostring(why) .. ")")
		end
	end
	
	function Input.reconcileStep(dt: number?)
		local gs = S.gameState
		if S.menuOpen then
			Input.releaseAll("menu")
			return
		end
		if gs and not gs.alive then
			Input.releaseAll("death")
			return
		end
		local item = gs and gs.item
		if item ~= Input.holdItem then
			local had = Input.holdItem ~= nil
			Input.holdItem = item
			if had then
				Input.releaseAll("weapon swap")
				return
			end
		end
		local now = os.clock()
		
		local ttl = math.max(Input.HOLD_TTL, (dt or 0) * 4)
		for _, t in pairs(Input.holds) do
			for owner, at in pairs(t) do
				if now - at > ttl then
					t[owner] = nil
					Input.releases.expired = (Input.releases.expired or 0) + 1
				end
			end
		end
		Input.applyHolds()
	end
	
	function Input.setAds(on: boolean, force: boolean?)
		if on then
			local was = adsHeld
			Input.hold("ads", "api", true)
			Input.applyHolds()
			if force and was then
				Input.adsPush()
			end
		else
			table.clear(Input.holds.ads)
			Input.applyHolds()
		end
	end
	
	function Input.adsPush()
		if adsHeld and not Input.adsViaMouse then
			Input.gameInput("StartAiming")
		end
	end
	function Input.adsHeld(): boolean
		return adsHeld
	end
	
	local fireMethodHeld = "game"
	function Input.setFire(down: boolean, method: string?)
		if down then
			S.spoofUntil = os.clock() + 0.6 
		end
		if down == fireHeld and (not down or method == nil or method == fireMethodHeld) then
			return
		end
		if fireHeld and down then
			
			Input.setFire(false)
		end
		fireHeld = down
		local m = if down then (method or "game") else fireMethodHeld
		if down then
			fireMethodHeld = m
		end
		local ok = false
		if m == "game" then
			ok = Input.gameInput(if down then "StartShooting" else "FinishShooting")
			if not ok and down then
				ok = vimMouse(down)
				if ok then
					fireMethodHeld = "vim"
					m = "vim"
				end
			end
		elseif m == "executor" then
			ok = execMouse(down)
		elseif m == "vim" then
			ok = vimMouse(down)
			if not ok and down then
				ok = execMouse(down)
				if ok then
					fireMethodHeld = "executor"
					m = "executor"
				end
			end
		else
			ok = true
		end
		if down then
			Input.fireMethodUsed = if ok then m else m .. " (failed)"
		end
	end
	function Input.fireHeld(): boolean
		return fireHeld
	end

	
	local capturing = false
	function Input.captureKey(done: (any) -> ())
		if capturing then
			return
		end
		capturing = true
		local conn: RBXScriptConnection? = nil
		local hb: RBXScriptConnection? = nil
		local started = os.clock()
		local function finish(name: any)
			if not capturing then
				return
			end
			capturing = false
			Input.cancelCapture = nil
			if conn then
				conn:Disconnect()
			end
			if hb then
				hb:Disconnect()
			end
			done(name)
		end
		
		Input.cancelCapture = function()
			finish(false)
		end
		conn = UIS.InputBegan:Connect(function(input)
			if input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.Backspace then
				finish(nil)
				return
			end
			if os.clock() - started < 0.2 and input.UserInputType == Enum.UserInputType.MouseButton1 then
				return 
			end
			local nm = Input.inputName(input)
			if nm then
				finish(nm)
			end
		end)
		
		local m4Was, m5Was = nil, nil
		hb = RunService.Heartbeat:Connect(function()
			local inp = Input.sideInput()
			local m4 = inp ~= nil and inp.m4 == true
			local m5 = inp ~= nil and inp.m5 == true
			if m4Was == nil then
				m4Was, m5Was = m4, m5
				return
			end
			if m4 and not m4Was then
				finish("M4")
			elseif m5 and not m5Was then
				finish("M5")
			elseif os.clock() - started > 8 then
				finish(false)
			end
			m4Was, m5Was = m4, m5
		end)
	end
	function Input.capturing(): boolean
		return capturing
	end

	
	
	local bindHoldBase: { [string]: any } = {}
	local bindTouched: { [string]: boolean } = {}
	Input.bindTouched = bindTouched
	Input.pressedNow = {}
	
	function Input.releaseHolds()
		for cfgKey, b in pairs(cfg.binds) do
			if type(b) == "table" and b.mode == "Hold" and type(b.key) == "string" and b.key ~= "" and not Input.isKeyDown(b.key) then
				local action = S.bindActions[cfgKey]
				if action then
					if keyPrev[b.key] == true then
						action(false)
					end
				elseif bindHoldBase[cfgKey] ~= nil then
					cfg[cfgKey] = bindHoldBase[cfgKey]
					bindHoldBase[cfgKey] = nil
				end
			end
		end
	end
	function Input.bindEdge(name: string): (boolean, boolean)
		local down = Input.isKeyDown(name)
		local was = keyPrev[name] == true
		Input.pressedNow[name] = down
		return down and not was, (not down) and was
	end
	function Input.runBinds()
		local pressedNow = Input.pressedNow
		table.clear(pressedNow)
		local edge = Input.bindEdge
		
		
		local typing = false
		pcall(function()
			typing = UIS:GetFocusedTextBox() ~= nil
		end)
		if S.menuOpen or capturing or typing then
			
			Input.releaseHolds()
			for _, b in pairs(cfg.binds) do
				if type(b) == "table" and type(b.key) == "string" and b.key ~= "" then
					pressedNow[b.key] = Input.isKeyDown(b.key)
				end
			end
			for k, v in pairs(pressedNow) do
				keyPrev[k] = v
			end
			return
		end
		for cfgKey, b in pairs(cfg.binds) do
			if type(b) == "table" then
				local mode = b.mode or "Toggle"
				local action = S.bindActions[cfgKey]
				if mode == "Always" then
					if action then
						if not bindTouched[cfgKey] then
							bindTouched[cfgKey] = true
							action(true)
						end
					elseif cfg[cfgKey] ~= true then
						cfg[cfgKey] = true
					end
				elseif mode == "Never" then
					if action then
						if not bindTouched[cfgKey] then
							bindTouched[cfgKey] = true
							action(false)
						end
					elseif cfg[cfgKey] ~= false then
						cfg[cfgKey] = false
					end
				elseif type(b.key) == "string" and b.key ~= "" then
					local pressed, released = edge(b.key)
					if mode == "Toggle" and pressed then
						if action then
							action(nil)
						else
							cfg[cfgKey] = not cfg[cfgKey]
							
							local core = cfgKey == "autoShoot" or cfgKey == "silentAim" or cfgKey == "aimbot" or cfgKey == "esp"
							if cfg[cfgKey] then
								notify(("%s ON"):format(Input.bindLabels[cfgKey] or cfgKey), 2, "ok")
							else
								notify(("%s OFF — %s turns it back on"):format(Input.bindLabels[cfgKey] or cfgKey, Input.keyLabel(b.key)), if core then 4 else 2, if core then "warn" else "info")
							end
							saveConfig()
						end
					elseif mode == "Hold" then
						if pressed then
							if action then
								action(true)
							else
								bindHoldBase[cfgKey] = cfg[cfgKey]
								cfg[cfgKey] = true
							end
						elseif released then
							if action then
								action(false)
							elseif bindHoldBase[cfgKey] ~= nil then
								cfg[cfgKey] = bindHoldBase[cfgKey]
								bindHoldBase[cfgKey] = nil
							end
						end
					end
				end
			end
		end
		for k, v in pairs(pressedNow) do
			keyPrev[k] = v
		end
	end

