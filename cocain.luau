	Game.intelCache = setmetatable({}, { __mode = "k" })
	function Game.espIntel(fighter: any): (string?, string?, string?)
		local c = Game.intelCache[fighter]
		local now = os.clock()
		if c and now - c.at < 0.4 then
			return c.rank, c.ammo, c.streak
		end
		local rank, ammo, streak = nil, nil, nil
		local plr = fighter and fighter.Player
		if typeof(plr) == "Instance" then
			for _, key in ipairs({ "DisplayLevel", "Level", "ELO", "Elo" }) do
				local ok, v = pcall(plr.GetAttribute, plr, key)
				if ok and v ~= nil and v ~= "" then
					rank = tostring(v)
					break
				end
			end
			for _, key in ipairs({ "Killstreak", "KillStreak", "Streak" }) do
				local ok, v = pcall(plr.GetAttribute, plr, key)
				if ok and type(v) == "number" and v > 1 then
					streak = tostring(math.floor(v))
					break
				end
			end
		end
		local item = Game.enemyEquipped(fighter)
		if item and type(item.Get) == "function" then
			local okA, a = pcall(item.Get, item, "Ammo")
			local okR, r = pcall(item.Get, item, "ReserveAmmo")
			if okA and type(a) == "number" then
				ammo = if okR and type(r) == "number" then ("%d/%d"):format(math.floor(a), math.floor(r)) else tostring(math.floor(a))
			end
		end
		if not c then
			c = {}
			Game.intelCache[fighter] = c
		end
		c.at, c.rank, c.ammo, c.streak = now, rank, ammo, streak
		return rank, ammo, streak
	end
