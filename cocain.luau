	Vis.MATERIALS, Vis.MAT_REFL, Vis.MAT_LABELS, Vis.MAT_ORDER = {}, {}, {}, {}
	for _, d in ipairs(Vis.MAT_DEFS) do
		local name = d.mat or d.v
		local okM, mat = pcall(function()
			return (Enum.Material :: any):FromName(name)
		end)
		if not (okM and typeof(mat) == "EnumItem") then
			okM, mat = pcall(function()
