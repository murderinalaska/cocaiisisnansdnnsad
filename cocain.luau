	function Vis.haloBuild()
		local model = Instance.new("Model")
		model.Name = "CocaineHalo"
		local ring = table.create(Vis.HALO_N)
		for i = 1, Vis.HALO_N do
			local p = Instance.new("Part")
			p.Name = "Bead"
			p.Shape = Enum.PartType.Ball
			p.Material = Enum.Material.Neon
			p.Anchored = true
			p.CanCollide = false
			p.CanQuery = false
			p.CanTouch = false
			p.CastShadow = false
			p.Locked = true
			p.Size = Vector3.one * 0.3
			p.Parent = model
			ring[i] = p
		end
		local light = Instance.new("PointLight")
		light.Range = 8
		light.Brightness = 1.6
		light.Shadows = false
		light.Parent = ring[1]
		model.Parent = workspace
		Vis.halo = { model = model, ring = ring, light = light }
	end
	function Vis.haloTick()
		if not cfg.haloOn then
			Vis.haloDrop()
			return
		end
		local char = LP.Character
		local head = char and char:FindFirstChild("Head")
		local anchor: BasePart? = if head and head:IsA("BasePart") then head else Game.myRoot()
		if not anchor then
			Vis.haloDrop()
			return
		end
		if not (Vis.halo and Vis.halo.model.Parent ~= nil) then
			Vis.haloBuild()
		end
		local h = Vis.halo
		if not h then
			return
		end
		local col = rgb(cfg.colHalo)
		local glow = cfg.haloGlow ~= false
		local mat = if glow then Enum.Material.Neon else Enum.Material.SmoothPlastic
		local radius = 1.35 * (cfg.haloSize or 1)
		
		local top = anchor.CFrame * Vector3.new(0, anchor.Size.Y * 0.5 + (cfg.haloHeight or 1.2), 0)
		local spin = os.clock() * math.rad(cfg.haloSpin or 0)
		local n = #h.ring
		for i, p in ipairs(h.ring) do
			local a = (i / n) * math.pi * 2 + spin
			p.CFrame = CFrame.new(top + Vector3.new(math.cos(a) * radius, 0, math.sin(a) * radius))
			if p.Color ~= col then
				p.Color = col
			end
			if p.Material ~= mat then
				p.Material = mat
			end
		end
		if h.light.Color ~= col then
			h.light.Color = col
		end
