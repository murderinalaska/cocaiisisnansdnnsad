					part.Color = orig.color
					part.Transparency = orig.trans
					if orig.variant ~= nil then
						part.MaterialVariant = orig.variant
					end
					if orig.texId ~= nil then
						(part :: any).TextureID = orig.texId
					end
					if orig.appear then
						for sa in pairs(orig.appear) do
							if sa.Parent == nil then
								sa.Parent = part
							end
						end
					end
					
					
					if orig.decals then
						for d, t in pairs(orig.decals) do
							if d.Parent then
								d.Transparency = t
							end
						end
					end
				end)
			end
		end
