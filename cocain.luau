	function Vis.textureScan()
		if not (cfg.worldNoTextures or cfg.worldTextureTint) then
			if next(Vis.texOrig) then
				Vis.worldExtrasRestore()
			end
			return
		end
		local now = os.clock()
		if now - Vis.texLastScan < 2 then
			return
		end
		Vis.texLastScan = now
		local tint = rgb(cfg.colWorldTint)
		local chars = {}
		for _, plr in Players:GetPlayers() do
			if plr.Character then
				chars[plr.Character] = true
			end
		end
		
		
		local cam = workspace.CurrentCamera
		local viewModels = workspace:FindFirstChild("ViewModels")
		for _, inst in workspace:GetDescendants() do
			if inst:IsA("BasePart")
				and not inst:IsA("Terrain")
				and not chars[inst:FindFirstAncestorOfClass("Model")]
				and not (cam and inst:IsDescendantOf(cam))
				and not (viewModels and inst:IsDescendantOf(viewModels)) then
				local orig = Vis.texOrig[inst]
				if not orig then
					orig = { material = inst.Material, color = inst.Color, trans = inst.Transparency }
					Vis.texOrig[inst] = orig
				end
				if cfg.worldNoTextures then
					
					Vis.setIfDiff(inst, "Material", Enum.Material.SmoothPlastic)
					
					
					if orig.variant == nil then
						orig.variant = inst.MaterialVariant
					end
					if inst.MaterialVariant ~= "" then
						inst.MaterialVariant = ""
					end
					if inst:IsA("MeshPart") then
						if orig.texId == nil then
							orig.texId = (inst :: any).TextureID
						end
						if (inst :: any).TextureID ~= "" then
							pcall(function()
								(inst :: any).TextureID = ""
							end)
						end
					end
					for _, d in inst:GetDescendants() do
						if d:IsA("Decal") or d:IsA("Texture") then
							orig.decals = orig.decals or {}
							if orig.decals[d] == nil then
								orig.decals[d] = d.Transparency
							end
							Vis.setIfDiff(d, "Transparency", 1)
						end
					end
					for _, d in inst:GetChildren() do
						if d:IsA("SurfaceAppearance") then
							orig.appear = orig.appear or {}
							orig.appear[d] = true
							pcall(function()
								d.Parent = nil
							end)
						end
					end
				elseif orig.variant ~= nil then
					
					pcall(function()
						inst.Material = orig.material
						inst.MaterialVariant = orig.variant
						if orig.texId ~= nil then
							(inst :: any).TextureID = orig.texId
						end
						for sa in pairs(orig.appear or {}) do
							if sa.Parent == nil then
								sa.Parent = inst
							end
						end
						for d, t in pairs(orig.decals or {}) do
							if d.Parent then
								d.Transparency = t
							end
						end
					end)
					orig.variant, orig.texId, orig.appear, orig.decals = nil, nil, nil, nil
				end
				if cfg.worldTextureTint then
					Vis.setIfDiff(inst, "Color", orig.color:Lerp(tint, 0.35))
				elseif cfg.worldNoTextures then
					Vis.setIfDiff(inst, "Color", orig.color)
				end
			end
		end
	end
	
	
	
	
	function Vis.mbObjects(cam: any, focal: number)
		local list = Vis.mbList
		table.clear(list)
		
		local okV, vms = pcall(Game.viewmodelModels)
		if okV and type(vms) == "table" then
			for i = 1, math.min(#vms, 4) do
				local part = Vis.mbAnchor(vms[i])
				if part and part.Parent then
					table.insert(list, part)
				end
			end
		end
		
		local n = 0
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= LP and n < 12 then
				local ch = plr.Character
				local root = ch and ch:FindFirstChild("HumanoidRootPart")
				if root and root.Parent then
					n += 1
					table.insert(list, root)
				end
			end
		end
		for _, part in ipairs(list) do
			local st = Vis.mbTrails[part]
			local okV2, vel = pcall(function()
				return S.resolver.fixVel(part)
			end)
			local pxPerSec = if okV2 and typeof(vel) == "Vector3" then Vis.mbScreenPx(cam, part.Position, vel, focal) else 0
			if pxPerSec < Vis.mbTrailOn then
				if st and st.trail.Enabled then
					Vis.fxSet(st.trail, "Enabled", false)
				end
			else
				st = st or Vis.mbStreak(part)
				if st then
					local k = math.clamp(pxPerSec / 1400, 0.1, 1)
					
					
					
					
					
					Vis.fxSet(st.trail, "Lifetime", 0.05 + 0.2 * k)
					local w = 0.35 + 1.15 * k
					if st.w ~= w then
						st.w = w
						st.trail.WidthScale = NumberSequence.new(w)
					end
					Vis.fxSet(st.trail, "Enabled", true)
				end
			end
		end
		
		
		
		if Game.frameId % 240 == 0 then
			for part, st in pairs(Vis.mbTrails) do
				if typeof(part) ~= "Instance" or not part.Parent then
					Vis.mbKill(part, st)
					Vis.mbTrails[part] = nil
				end
			end
		end
	end

	
	
	function Vis.motionBlurTick()
		if not cfg.worldMotionBlur or cfg.lowSpec then
			Vis.motionLast, Vis.motionAt = nil, nil
			Vis.motionBlurSize, Vis.mbPx = 0, 0
			Vis.mbCamVel = Vector3.zero
			Vis.fxDrop("CocaineMotionBlur")
			Vis.mbTrailRestore()
			return
		end
		local cam = workspace.CurrentCamera
		if not cam then
			return
		end
		local cf = cam.CFrame
		local last = Vis.motionLast
		local now = os.clock()
		local dt = now - (Vis.motionAt or now)
		Vis.motionLast, Vis.motionAt = cf, now
		local shutter = math.clamp(tonumber(cfg.worldMotionBlurShutter) or 180, 0, 360)
		local usable = last ~= nil and dt > 0 and dt < 0.25
		
		
		
		local camVel = Vector3.zero
		if usable then
			local moved = cf.Position - last.Position
			if moved.Magnitude < 80 then 
				camVel = moved / dt
			end
		end
		Vis.mbCamVel = camVel
		
		
		local exposure = if usable and shutter > 0 then math.min(dt, 0.1) * (shutter / 360) else 0
		local focal = Vis.mbFocal(cam)
		local px = 0
		if exposure > 0 and last then
			
			
			local angPx = 0
			local okR, rel = pcall(function()
				return last:ToObjectSpace(cf)
			end)
			if okR then
				local rx, ry, rz = rel:ToOrientation()
				angPx = ((math.abs(rx) + math.abs(ry) + math.abs(rz)) / dt) * focal
			end
			
			
			local fwd = cf.LookVector
			local perp = camVel - fwd * camVel:Dot(fwd)
			local linPx = (perp.Magnitude / Vis.mbRefDepth) * focal
			px = (angPx + linPx) * exposure
		end
		Vis.mbPx = px
		
		
		local size = if px >= Vis.mbFloor then math.min(px * Vis.mbPxToSize * (cfg.worldMotionBlurScale or 1), Vis.mbMaxSize) else 0
		local k = 1 - math.exp(-math.clamp(dt, 0, 0.1) / 0.06)
		Vis.motionBlurSize = Vis.motionBlurSize + (size - Vis.motionBlurSize) * k
		if cfg.worldMotionBlurObjects and exposure > 0 then
			Vis.mbObjects(cam, focal)
		else
			Vis.mbTrailRestore()
		end
		if Vis.motionBlurSize < 0.05 then
			
			
			local blur = Vis.fxInst and Vis.fxInst.CocaineMotionBlur
			if blur then
				Vis.fxSet(blur, "Enabled", false)
			end
			return
		end
		local blur = Vis.fxGet("BlurEffect", "CocaineMotionBlur")
		Vis.fxSet(blur, "Enabled", true)
		Vis.fxSet(blur, "Size", Vis.motionBlurSize)
	end
	function Vis.worldExtrasTick()
		if Game.frameId % 120 == 0 then
			Vis.textureScan()
		end
		if Game.frameId % 2 == 0 or cfg.worldMotionBlur then
			Vis.motionBlurTick()
		end
	end
