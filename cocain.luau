	}
	Combat.body = Body
	S.body = Body
	S.charAlive = true
	local Safe = S.safe
	local function finiteVec3(v: Vector3): boolean
		return typeof(v) == "Vector3" and v == v and v.Magnitude < 3e7
	end
	local function finiteCF(cf: CFrame): boolean
		local p = cf.Position
		local m = p.Magnitude
		return m == m and m < 3e7 and cf.LookVector.Magnitude > 0.5 
	end
	Combat.finiteVec3 = finiteVec3
	function Body.pivot(cf: CFrame): boolean
		if typeof(cf) ~= "CFrame" or not finiteCF(cf) then
			local who = if Body.owner then (" (" .. Body.owner .. ")") else ""
			S.hookErr("body", "refused a non-finite CFrame" .. who)
			return false
		end
		local char = LP.Character
		local root = char and char.PrimaryPart
		if not root then
			return false
		end
		char:PivotTo(cf)
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
		return true
	end
	
	
	
	
	
	
	
	
	
	function Body.request(owner: string, spot: Vector3, aim: Vector3?, opts: any?): boolean
		if not finiteVec3(spot) then
			return false
		end
		if aim ~= nil and not finiteVec3(aim) then
			aim = nil
		end
		if os.clock() < (Body.blocked[owner] or 0) then
			return false
		end
		
		
		if owner ~= "defense" and Body.owner == "defense" and Combat.hunted() then
			return false
		end
		local r = Body.req[owner]
		if not r then
			r = {}
			Body.req[owner] = r
		end
		r.spot, r.aim, r.opts, r.frame = spot, aim, opts or Body.EMPTY, Game.frameId
		return true
	end
	
	
	function Body.release(owner: string, stay: boolean?)
		local r = Body.req[owner]
		if r then
			r.frame = -1
		end
		if Body.owner == owner then
			Body.ending = { owner = owner, stay = stay == true }
		end
	end
	function Body.holds(owner: string): boolean
		return Body.owner == owner
	end
	
	
	Body.CSYNC_OWNERS = { autokill = true, peek = true, meleeRage = true, defense = true, dodge = true }
	function Body.csyncOwner(owner: string, o: any): boolean
		if not (Combat.cs.on and Body.CSYNC_OWNERS[owner] == true) then
			return false
		end
		if o ~= nil and o.glue == true then
			return true
		end
		if o ~= nil and o.far == true and Combat.parkCsyncOn() then
			return true
		end
		return Combat.rageCsyncOn() or (owner == "autokill" and (ak.mode == "Orbit" or ak.mode == "Glue") and Combat.orbitDesyncOn())
	end
	
	function Body.csyncEnd()
		Combat.cs.target = nil
		Combat.cs.far, Combat.cs.glue = nil, nil
		S.csyncHead = nil
		Body.csyncHold = false
	end
	
	function Body.settledFor(owner: string): boolean
		return Body.owner == owner and os.clock() - Body.jumpAt >= Combat.settleSec()
	end
	function Body.maxHold(owner: string): number
		if owner == "defense" then
			
			return if cfg.voidSpam then math.huge else cfg.defenseMaxHide
		end
		return Body.MAX_HOLD[owner] or 10
	end
	function Body.captureHome(char: Model)
		Body.home = char:GetPivot()
		Body.lastHome, Body.lastHomeChar = Body.home, char
		Body.homeChar = char
		local cam = workspace.CurrentCamera
		Body.homeCam = cam and cam.CFrame or nil
		Body.homeRot = nil
		pcall(function()
			Body.homeRot = CameraController.Rotation
		end)
		Body.camTurned = false
		Body.realMoved, Body.realLast = false, nil
		Body.takes += 1
	end
	
	function Body.finish(why: string, move: boolean)
		local char = LP.Character
		
		
		
		if Body.csyncHold then
			Body.csyncEnd()
			if not Body.realMoved then
				move = false
			end
		end
		if move and Body.home and char and char == Body.homeChar and char.PrimaryPart then
			Body.pivot(Body.home)
			Combat.markTeleport()
		end
		if move and Body.camTurned and Body.homeRot then
			pcall(function()
				Game.asGame(CameraController.SetRotation, CameraController, Body.homeRot)
			end)
		end
		local was = Body.owner
		Body.owner, Body.home, Body.homeChar, Body.homeCam, Body.homeRot = nil, nil, nil, nil, nil
		Body.camTurned, Body.last, Body.lastKey, Body.idle, Body.ending = false, nil, nil, 0, nil
		Body.realMoved, Body.realLast = false, nil
		S.teleported = false
		S.pinCF = nil
		Combat.noclip.release()
		Combat.padClear()
		if was then
			log("INFO", ("body: %s → you (%s)"):format(was, why))
		end
	end
	function Body.goHome(why: string)
		Body.finish(why, true)
	end
	
	function Body.reset(why: string)
		for _, r in pairs(Body.req) do
			r.frame = -1
		end
		if Body.owner then
			Body.finish(why, false)
		end
	end
	
	
	function Body.leave(why: string)
		if not Body.owner then
			return
		end
		local char = LP.Character
		local root = char and char.PrimaryPart
		
		
		local ref = if Body.realMoved then Body.realLast else nil
		if not root or char ~= Body.homeChar or (ref ~= nil and (root.Position - ref).Magnitude > 45) then
			Body.reset(why)
		elseif Body.realMoved then
			Body.goHome(why)
		else
			Body.reset(why) 
		end
	end
	
	function Body.jump(owner: string, cf: CFrame): boolean
		if Body.owner ~= nil or S.calibrating or Combat.oobProbing or S.featuresPaused then
			return false
		end
		if not Safe.standable(cf.Position) then
			Safe.note(owner .. ": nowhere to stand")
			return false
		end
		if Body.pivot(cf) then
			Combat.markTeleport()
			return true
		end
		return false
	end
	
	
	function Body.pick(now: number, frame: number): (string?, Vector3?, any)
		local order = Body.order
		table.clear(order)
		for owner, r in pairs(Body.req) do
			if r.frame == frame then
				table.insert(order, owner)
			end
		end
		if #order > 1 then
			
			local function prio(o: string): number
				local rq = Body.req[o]
				return (Body.PRIO[o] or 0) + (if rq and rq.opts and rq.opts.urgent then 25 else 0)
			end
			table.sort(order, function(a, b)
				return prio(a) > prio(b)
			end)
		end
		for _, owner in ipairs(order) do
			local rq = Body.req[owner]
			if Body.owner == owner and now - Body.ownerSince > Body.maxHold(owner) then
				Body.blocked[owner] = now + 2
				log("INFO", ("body: %s held %.1f s — its limit"):format(owner, now - Body.ownerSince))
			else
				local o = rq.opts
				local ok, why = Safe.check(rq.spot, o)
				local s = rq.spot
				if not ok then
					s = Safe.fix(rq.spot, o)
					
					if s and not Safe.check(s, o) then
						s = nil
					end
					if not s and Body.owner == owner and Body.last and Safe.check(Body.last, o) then
						s = Body.last 
					end
					if not s then
						Safe.note(owner .. ": " .. tostring(why))
					end
				end
				if s then
					return owner, s, rq
				end
			end
		end
		return nil, nil, nil
	end
	function Body.commit()
		if S.calibrating or Combat.oobProbing then
			return 
		end
		
		if S.featuresPaused then
			Body.leave("lobby")
			return
		end
		local now = os.clock()
		local frame = Game.frameId
		local char = LP.Character
		local root = char and char.PrimaryPart
		local gs = S.gameState
		if not S.charAlive and gs and gs.alive == true and now - (S.diedAt or 0) > 2 then
			S.charAlive = true 
		end
		if not S.charAlive or (gs and gs.alive == false) then
			if S.charAlive then
				pcall(Combat.noteDeath, "dead") 
			end
			
			
			if root and char == Body.lastHomeChar and Body.lastHome and now - (Body.rescueAt or 0) > 1 and Combat.outOfMap(root.Position) > 20000 then
				Body.rescueAt = now
				log("INFO", ("[body:rescue] round over %s st out — back to your spot"):format(Game.studs(Combat.outOfMap(root.Position))))
				Body.pivot(Body.lastHome)
			end
			Body.reset("dead") 
			return
		end
		if root then
			Combat.lastAlivePos = root.Position 
		end
		Combat.deathLogged = false
		
		
		if not Body.owner and root and char == Body.lastHomeChar and Body.lastHome and Combat.outOfMap(root.Position) > 20000 then
			Body.farIdleSince = Body.farIdleSince or now
			if now - Body.farIdleSince > 0.4 and now - (Body.rescueAt or 0) > 1 then
				Body.rescueAt = now
				log("INFO", ("[body:rescue] left %s st out with nobody holding it — back to your spot"):format(Game.studs(Combat.outOfMap(root.Position))))
				Body.pivot(Body.lastHome)
				Combat.markTeleport()
			end
		else
			Body.farIdleSince = nil
		end
		if Body.owner then
			if not (char and root) or char ~= Body.homeChar then
				Body.reset("character changed")
			elseif Body.last and not Body.csyncHold and (root.Position - Body.last).Magnitude > 45 then
				
				
				if Body.owner == "defense" and Combat.def.kind == "far" then
					pcall(Combat.noteFarYank, Body.last)
				end
				Body.reset("the game moved you")
			end
		end
		
		
		local hpNow = Game.myHealth()
		local owner0 = Body.owner
		
		if hpNow and Body.hpLast and hpNow < Body.hpLast - 6 then
			S.hurtAt, S.hurtAmount = now, Body.hpLast - hpNow
			if Combat.hvh then
				pcall(Combat.hvh.noteHurt, Body.hpLast - hpNow)
			end
		end
		if hpNow and hpNow ~= Body.hpLast then
			Combat.noteHp(now, hpNow, owner0)
		end
		
		if owner0 and ((owner0 == "defense" and not Combat.voidSpamOn()) or owner0 == "peek") and hpNow and Body.hpLast and hpNow < Body.hpLast - 6 then
			Body.blocked[owner0] = now + 0.8
			log("INFO", ("[body:home:damaged] %s spot took %.0f (%.0f → %.0f)"):format(owner0, Body.hpLast - hpNow, Body.hpLast, hpNow))
			Body.goHome("damaged")
		end
		Body.hpLast = hpNow
		local win, spot, r = Body.pick(now, frame)
		if not win then
			if Body.owner then
				local e = Body.ending
				if e and e.owner == Body.owner and e.stay and root and Safe.standable(root.Position) then
					Body.finish(e.owner .. " ended here", false)
				elseif (e and e.owner == Body.owner) or Body.idle >= 1 then
					Body.goHome(if e then e.owner .. " ended" else Body.owner .. " let go")
				else
					Body.idle += 1
				end
			end
			return
		end
		if not (char and root) then
			return
		end
		Body.idle = 0
		Body.ending = nil
		local o = r.opts
		if Body.owner ~= win then
			if Body.owner == nil then
				Body.captureHome(char)
			end
			log("DEBUG", ("body: %s → %s"):format(Body.owner or "you", win))
			Body.owner = win
			Body.ownerSince = now
			Body.lastKey = nil
		end
		local key = if spot == r.spot then (o.key or spot) else spot
		local jump = o.jump == true or Body.lastKey == nil or (key - Body.lastKey).Magnitude > (o.jumpDist or 1.5)
		Body.lastKey = key
		local aim = r.aim or (spot + root.CFrame.LookVector * Vector3.new(1, 0, 1))
		
		if Body.csyncOwner(win, o) then
			
			
			if Body.realMoved and Body.home and char == Body.homeChar then
				Body.pivot(Body.home)
				log("DEBUG", ("[body:home] real body back home for %s's CSYNC hold (it was %s st out)"):format(win, if Body.realLast then Game.studs((Body.realLast - Body.home.Position).Magnitude) else "?"))
				Body.realMoved, Body.realLast = false, nil
			end
			Combat.cs.target = Combat.lookAtSafe(spot, aim)
			Combat.cs.far, Combat.cs.glue = o.far == true, o.glue == true
			S.csyncHead = spot + Vector3.new(0, 1.75, 0)
			Body.csyncHold = true
			if Combat.pad then
				Combat.padClear()
			end
			if jump then
				Combat.markTeleport()
				Body.jumpAt = now
			end
			Body.last = spot
			Body.committedAt = now
			S.teleported = true 
			S.pinCF = nil 
			return
		end
		
		if Body.csyncHold then
			Body.csyncEnd()
		end
		if cfg.noclipRage then
			Combat.noclip.rage((o.hold or 0.4) + 0.2)
		end
		if o.velocity and not jump then
			local delta = spot - root.Position
			if delta.Magnitude > 12 then
				Body.pivot(Combat.lookAtSafe(spot, aim))
				jump = true
			else
				local dt = math.clamp(now - Body.committedAt, 1 / 240, 0.1)
				local v = delta / dt
				if v.Magnitude > o.velocity then
					v = v.Unit * o.velocity
				end
				root.AssemblyLinearVelocity = v
				root.AssemblyAngularVelocity = Vector3.zero
				root.CFrame = Combat.lookAtSafe(root.Position, aim)
			end
		else
			Body.pivot(Combat.lookAtSafe(spot, aim))
		end
		
		if o.far or o.sky or (o.void and not Safe.groundY(spot)) then
			Combat.padAt(spot)
		elseif Combat.pad then
			Combat.padClear()
		end
		if jump then
			Combat.markTeleport()
			Body.jumpAt = now
		end
		Body.last = spot
		Body.realMoved, Body.realLast = true, spot
		Body.committedAt = now
		S.teleported = true
		S.pinCF = if o.pin then Body.homeCam else nil
		if o.turnCam then
			Body.camTurned = true
		end
	end
	
	function Body.watchChar(char: Model?)
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if hum then
			Game.track(hum.Died:Connect(function()
				pcall(Combat.noteDeath, "died")
				S.charAlive = false
				S.diedAt = os.clock()
				Body.reset("died")
			end))
		end
	end
	Game.track(LP.CharacterAdded:Connect(function(c: Model)
		S.charAlive = true
		Body.reset("respawned")
		task.defer(Body.watchChar, c)
	end))
	Body.watchChar(LP.Character)
	end 

	
	
	
	
	function Combat.outOfMap(p: Vector3): number
		local box = S.safe.mapBox()
		if not box then
			return 0
		end
		local c = Vector3.new(math.clamp(p.X, box.min.X, box.max.X), math.clamp(p.Y, box.min.Y, box.max.Y), math.clamp(p.Z, box.min.Z, box.max.Z))
		return (p - c).Magnitude
	end
	
	
	
	
	Combat.FAR_FLOOR = 90000
	function Combat.noteFarYank(spot: Vector3)
		
		if Combat.parkCsyncOn() then
			return
		end
		local out = Combat.outOfMap(spot)
		if out <= Combat.FAR_FLOOR * 1.05 then
			return
		end
		local key = Combat.voidKey()
		if not key then
			return
		end
		local cap = math.max(Combat.FAR_FLOOR, math.floor(out / 4))
		local old = tonumber(cfg.voidFarCap[key])
		if old and old <= cap then
			return
		end
		cfg.voidFarCap[key] = cap
		Combat.farCache, Combat.farLast = nil, nil
		Combat.def.state, Combat.def.spot = "idle", nil
		log("WARN", ("[voidspam:oob] the server pulled you back from %s st out — far hide on this map capped at %s st"):format(Game.studs(out), Game.studs(cap)))
		notify(("Server pulled you back from %s st — hide capped at %s st on this map"):format(Game.studs(out), Game.studs(cap)), 4, "warn")
	end
	Combat.hpLog = {}
	function Combat.noteHp(t: number, hp: number, owner: string?)
		local L = Combat.hpLog
		table.insert(L, { t = t, hp = hp, owner = owner })
		if #L > 16 then
			table.remove(L, 1)
		end
	end
	
	
	
	
	
	Combat.rnd = { n = 0, active = false }
	Combat.tl = { list = {}, max = 40 } 
	Combat.ROUND_DIR = "cocaine/rounds"
	
	function Combat.spotKind(): string
		local B = Combat.body
		local o = B and B.owner
		if not o then
			return "home"
		end
		local H = Combat.hvh
		if H and H.gluedTo ~= nil then
			return "glue"
		end
		if o == "defense" then
			return tostring(Combat.def.kind or "hide")
		end
		if o == "autokill" then
			return "ak:" .. string.lower(tostring(ak.mode or "?"))
		end
		return o
	end
	
	function Combat.nearestFoe(from: Vector3?): (any, number)
		if not from then
			return nil, math.huge
		end
		local best, bd = nil, math.huge
		for _, f in ipairs(Game.targets()) do
			if not f.IsBot then
				local root, model = Game.fighterBody(f)
				local w = model and Resolver.warp[model]
				local p = (w and w.rawPos) or (root and root.Position)
				if p then
					local d = (p - from).Magnitude
					if d == d and d < bd then
						best, bd = f, d
					end
				end
			end
		end
		return best, bd
	end
	
	
	function Combat.tlTick()
		local now = os.clock()
		local T = Combat.tl
		if now - (T.at or 0) < 0.1 or not S.charAlive then
			return
		end
		T.at = now
		local me = S.myRootPart
		local mp = if me and me.Parent then me.Position else nil
		local B = Combat.body
		local server = if B.csyncHold and Combat.cs.target then Combat.cs.target.Position else mp
		local f, d = Combat.nearestFoe(server)
		local H = Combat.hvh
		local item = f and Game.enemyEquipped(f)
		local root = f and Game.fighterBody(f)
		table.insert(T.list, {
			t = now,
			owner = B.owner or "you",
			spot = Combat.spotKind(),
			out = server ~= nil and Combat.beyondBound and Combat.beyondBound(server) or false,
			foe = f and Game.fighterName(f) or nil,
			d = if d < math.huge then d else nil,
			fw = if type(item) == "table" then tostring(item.Name) else nil,
			fv = root and root.AssemblyLinearVelocity.Magnitude or nil,
			ready = if f and H and H.readyIn then H.readyIn(f) else nil,
			hp = Game.myHealth(),
			settling = B.owner ~= nil and not B.settledFor(B.owner),
		})
		if #T.list > T.max then
			table.remove(T.list, 1)
		end
	end
	function Combat.timelineParts(window: number): { string }
		local now = os.clock()
		local parts = {}
		for _, e in ipairs(Combat.tl.list) do
			if now - e.t <= window then
				table.insert(parts, ("-%.1fs %s/%s%s%s%s hp%s%s"):format(
					now - e.t,
					e.owner,
					e.spot,
					if e.out then " OUT" else "",
					if e.foe then (" -> %s %s st"):format(e.foe, if e.d then Game.studs(e.d) else "?") else "",
					if e.fw then (" %s%s"):format(e.fw, if e.fv then (" %.0f st/s"):format(e.fv) else "") .. (if e.ready then (" ready %.2fs"):format(e.ready) else "") else "",
					if e.hp then ("%.0f"):format(e.hp) else "?",
					if e.settling then " settling" else ""
				))
			end
		end
		return parts
	end
	
	function Combat.dumpTimeline()
		local parts = Combat.timelineParts(3)
		for i = 1, #parts, 5 do
			log("INFO", "[death:timeline] " .. table.concat(parts, " | ", i, math.min(i + 4, #parts)))
		end
		local R = Combat.rnd
		if R.cur then
			R.cur.timeline = parts
		end
	end
	function Combat.roundStart(weapon: string)
		local R = Combat.rnd
		if R.active then
			Combat.roundEnd("restart")
		end
		R.n += 1
		R.active = true
		local opp = {}
		for _, f in ipairs(Game.targets()) do
			if not f.IsBot then
				table.insert(opp, Game.fighterName(f))
			end
		end
		R.cur = {
			n = R.n,
			t0 = os.clock(),
			date = os.date("!%Y-%m-%dT%H:%M:%SZ"),
			map = tostring(Combat.voidKey() or game.PlaceId),
			weapons = { weapon },
			opponents = opp,
			kills = {},
			deaths = {},
			shots = {},
			modes = {},
			hidden = 0,
			ping = S.pingMs or 0,
		}
		log("INFO", ("[round:start] #%d map %s | opponents %s | weapon %s | ping %d"):format(R.n, R.cur.map, if #opp > 0 then table.concat(opp, ", ") else "none yet", weapon, S.pingMs or 0))
	end
	function Combat.roundWeapon(weapon: string)
		local c = Combat.rnd.cur
		if c and not table.find(c.weapons, weapon) then
			table.insert(c.weapons, weapon)
		end
	end
	function Combat.roundKill(name: string)
		local c = Combat.rnd.cur
		if c then
			table.insert(c.kills, { t = os.clock() - c.t0, who = name })
		end
	end
	function Combat.roundDeath(why: string)
		local c = Combat.rnd.cur
		if not c then
			return
		end
		local me = S.myRootPart
		local B = Combat.body
		local server = if B.csyncHold and Combat.cs.target then Combat.cs.target.Position elseif me and me.Parent then me.Position else Combat.lastAlivePos
		local f, d = Combat.nearestFoe(server)
		local H = Combat.hvh
		local item = f and Game.enemyEquipped(f)
		table.insert(c.deaths, {
			t = os.clock() - c.t0,
			why = why,
			owner = B.owner or "you",
			spot = Combat.spotKind(),
			out = server ~= nil and Combat.beyondBound and Combat.beyondBound(server) or false,
			killer = f and Game.fighterName(f) or nil,
			dist = if d < math.huge then math.floor(d * 10 + 0.5) / 10 else nil,
			weapon = if type(item) == "table" then tostring(item.Name) else nil,
			ready = if f and H and H.readyIn then H.readyIn(f) else nil,
			gluebot = if f and H and H.isGluebot then H.isGluebot(f) else nil,
		})
	end
	
	function Combat.roundShot(rec: any, verdict: string)
		local c = Combat.rnd.cur
		if not c or rec.melee or rec.projectile then
			return
		end
		local key = ("%s:%s"):format(rec.spot or rec.bodyAt or "you", verdict)
		c.shots[key] = (c.shots[key] or 0) + 1
		if rec.mode then
			local m = c.modes[rec.mode] or { n = 0, hit = 0 }
			c.modes[rec.mode] = m
			m.n += 1
			if verdict == "HIT" or rec.killShot == true then
				m.hit += 1
			end
		end
	end
	
	function Combat.enemyProfile(f: any): any
		local H = Combat.hvh
		local e = H and H.enemy[f]
		local _, model = Game.fighterBody(f)
		local w = model and Resolver.warp[model]
		local away = if e and (e.frames or 0) > 0 then (e.away or 0) / e.frames * 100 else 0
		local glue = H and H.isGluebot and H.isGluebot(f) or false
		local warps = w and w.warping == true
		local label = if glue then "glue-bot" elseif warps or away > 5 or (S.counter and S.counter.tag and S.counter.tag(f)) then "ragebot" else "legit"
		local item = Game.enemyEquipped(f)
		return {
			name = Game.fighterName(f),
			label = label,
			away = math.floor(away + 0.5),
			pb = e and e.pb or 0,
			closest = w and w.closeD and math.floor(w.closeD * 10 + 0.5) / 10 or nil,
			weapon = if type(item) == "table" then tostring(item.Name) else nil,
			tag = S.counter and S.counter.tag and S.counter.tag(f) or nil,
		}
	end
	function Combat.roundEnd(reason: string?)
		local R = Combat.rnd
		local c = R.cur
		R.active = false
		R.cur = nil
		if not c then
			return
		end
		local dur = os.clock() - c.t0
		local k, d = c.kills[1], c.deaths[1]
		local result = if k and d then (if math.abs(k.t - d.t) < 1 then "TRADE" elseif k.t < d.t then "WON" else "LOST") elseif k then "WON" elseif d then "LOST" else "NONE"
		local why = reason
		if not why then
			if result == "LOST" and d then
				why = ("died on %s/%s%s to %s%s%s"):format(d.owner, d.spot, if d.out then " (beyond the bound)" else "", tostring(d.killer or "?"), if d.dist then (" at %s st"):format(Game.studs(d.dist)) else "", if d.weapon then (" (%s)"):format(d.weapon) else "")
			elseif result == "WON" and k then
				why = ("killed %s at %.1f s"):format(tostring(k.who), k.t)
			elseif result == "TRADE" then
				why = "kill and death within 1 s"
			else
				why = "no kill, no death"
			end
		end
		local enemies = {}
		for _, f in ipairs(Game.targets()) do
			if not f.IsBot then
				local okP, p = pcall(Combat.enemyProfile, f)
				if okP and p then
					table.insert(enemies, p)
					log("INFO", ("[enemy] %s | %s | away %d%% | point-blank %d | closest %s | %s%s"):format(p.name, p.label, p.away, p.pb, if p.closest then Game.studs(p.closest) .. " st" else "?", tostring(p.weapon or "no weapon seen"), if p.tag then " | " .. p.tag else ""))
				end
			end
		end
		local shotParts = {}
		for key, n in pairs(c.shots) do
			table.insert(shotParts, key .. "=" .. n)
		end
		table.sort(shotParts)
		local modeParts = {}
		for m, s in pairs(c.modes) do
			table.insert(modeParts, ("%s %d/%d"):format(m, s.hit, s.n))
		end
		log("INFO", ("[round:end] #%d %s | %s | %.0f s | shots %s | modes %s | weapons %s"):format(c.n, result, why, dur, if #shotParts > 0 then table.concat(shotParts, " ") else "none", if #modeParts > 0 then table.concat(modeParts, ", ") else "-", table.concat(c.weapons, ", ")))
		if cfg.logDetail == "Verbose" and not d then
			local parts = Combat.timelineParts(3)
			for i = 1, #parts, 5 do
				log("DEBUG", "[round:timeline] " .. table.concat(parts, " | ", i, math.min(i + 4, #parts)))
			end
		end
		if cfg.roundFile and type(EXEC.appendfile) == "function" and type(EXEC.writefile) == "function" then
			pcall(function()
				EXEC.mkdirs(Combat.ROUND_DIR)
				local rec = {
					n = c.n,
					date = c.date,
					map = c.map,
					result = result,
					reason = why,
					dur = math.floor(dur * 10 + 0.5) / 10,
					weapons = c.weapons,
					opponents = c.opponents,
					kills = c.kills,
					deaths = c.deaths,
					shots = c.shots,
					modes = c.modes,
					enemies = enemies,
					timeline = c.timeline,
					ping = c.ping,
					version = S.version,
				}
				local file = ("%s/%s.jsonl"):format(Combat.ROUND_DIR, os.date("!%Y-%m-%d"))
				local line = HttpService:JSONEncode(rec) .. "\n"
				local exists = type(EXEC.isfile) == "function" and select(2, pcall(EXEC.isfile, file)) == true
				if exists then
					EXEC.appendfile(file, line)
				else
					EXEC.writefile(file, line)
				end
			end)
		end
	end
	function Combat.noteDeath(why: string)
		local now = os.clock()
		
		
		if Combat.deathLogged or now - (Combat.deathAt or -10) < 3 then
			return
		end
		Combat.deathLogged = true
		Combat.deathAt = now
		
		if S.lastKillAt and now - S.lastKillAt < 6 then
			log("DEBUG", ("[death] round over (%s, %.1f s after your kill) — not a death"):format(why, now - S.lastKillAt))
			return
		end
		pcall(Combat.roundDeath, why)
		pcall(Combat.dumpTimeline)
		local hp = {}
		for _, e in ipairs(Combat.hpLog) do
			if now - e.t <= 3 then
				table.insert(hp, ("%.0f @-%.2fs%s"):format(e.hp, now - e.t, if e.owner then " " .. e.owner else ""))
			end
		end
		local me = S.myRootPart
		local mp = if me and me.Parent then me.Position else Combat.lastAlivePos
		local where = "no body"
		local out = 0
		if mp then
			local box = S.safe.mapBox()
			if box then
				local c = Vector3.new(math.clamp(mp.X, box.min.X, box.max.X), math.clamp(mp.Y, box.min.Y, box.max.Y), math.clamp(mp.Z, box.min.Z, box.max.Z))
				out = (mp - c).Magnitude
			end
			where = if out > 50 then ("%s st off the map (Y %.0f)"):format(Game.studs(out), mp.Y) else ("on the map (%.0f, %.0f, %.0f)"):format(mp.X, mp.Y, mp.Z)
		end
		local D = Combat.def
		local hide = ""
		if D and D.state == "hide" then
			hide = (" · hiding %.1f s, this spot %.2f s"):format(now - (D.since or now), now - (D.hopAt or now))
		end
		if D and (D.huntHops or 0) > 0 then
			hide ..= (" · %d hunted hops this life"):format(D.huntHops)
		end
		log("INFO", ("[death] %s · body %s · %s%s · hp %s · ping %d"):format(why, Combat.body.owner or "you", where, hide, if #hp > 0 then table.concat(hp, " → ") else "no change seen", S.pingMs or 0))
		
		local seen = {}
		for _, w in pairs(Resolver.warp) do
			if w.fighter ~= nil and w.rawAt and now - w.rawAt < 5 then
				table.insert(seen, w.fighter)
			end
		end
		if #seen == 0 then
			seen = table.clone(S.enemiesNow or {})
		end
		
		local function rawOf(f: any): Vector3?
			local root, model = Game.fighterBody(f)
			local w = if model then Resolver.warp[model] else nil
			return (w and w.rawPos) or (root and root.Position)
		end
		if mp then
			table.sort(seen, function(a, b)
				local pa, pb = rawOf(a), rawOf(b)
				return (if pa then (pa - mp).Magnitude else math.huge) < (if pb then (pb - mp).Magnitude else math.huge)
			end)
		end
		for i = #seen, 7, -1 do
			seen[i] = nil
		end
		local nearest = math.huge
		for _, f in ipairs(seen) do
			local root, model = Game.fighterBody(f)
			local w = if model then Resolver.warp[model] else nil
			if (root and model) or (w and w.rawPos) then
				local raw = if w and w.rawPos and (now - (w.rawAt or 0) < 5 or not root) then w.rawPos else root.Position
				local dist = if mp then Game.studs((raw - mp).Magnitude) .. " st" else "?"
				if mp then
					nearest = math.min(nearest, (raw - mp).Magnitude)
				end
				if w and w.closeD and now - (w.closeAt or 0) <= 3 then
					nearest = math.min(nearest, w.closeD)
				end
				local close = if w and w.closeD and now - (w.closeAt or 0) <= 3 then (" · closest %s st %.2f s ago"):format(Game.studs(w.closeD), now - w.closeAt) else ""
				local state = if Resolver.away(model) then "away" elseif Resolver.warping(model) then "warping" else "on the map"
				local item = Game.enemyEquipped(f)
				local hpE = Game.fighterHealth(f)
				log("INFO", ("[death]   %s: %s from you%s · %s · %s · hp %s"):format(Game.fighterName(f), dist, close, state, if item then tostring(item.Name) else "no weapon seen", if hpE then ("%.0f"):format(hpE) else "?"))
			end
		end
		
		
		
		
		if mp and mp.Y < -1e5 and Combat.farLast then
			pcall(Combat.noteFarYank, Combat.farLast)
		elseif D and D.state == "hide" and D.kind == "far" and out > 20000 and now - (S.hurtAt or -10) > 2 and nearest > 1500 and not Combat.parkCsyncOn() then
			local key = Combat.voidKey()
			if key then
				local cap = if out > 100000 then 90000 else math.max(10000, math.floor(out * 0.5))
				local old = tonumber(cfg.voidFarCap[key])
				if not old or cap < old then
					cfg.voidFarCap[key] = cap
					Combat.farCache = nil
					log("WARN", ("[voidspam:oob] killed %s st out with nobody near (closest %s st) — this map's out-of-bounds rule; far hide here capped at %s st"):format(Game.studs(out), if nearest < math.huge then Game.studs(nearest) else "—", Game.studs(cap)))
					notify(("Far hide killed by this map's bounds at %s st — capped at %s st here"):format(Game.studs(out), Game.studs(cap)), 5, "warn")
				end
			end
		end
		if D then
			D.huntHops = 0
		end
	end

	
	
	
	
	
	
	
	
	Combat.magicJit = { at = 0, off = Vector3.zero }
	function Combat.magicJitterOffset(target: Vector3, origin: Vector3, model: Model?): Vector3
		if not cfg.magicJitter then
			S.magicHopSettled = true
			Combat.magicJit.force = nil
			return Vector3.zero
		end
		local now = os.clock()
		local j = Combat.magicJit
		local settle = Combat.settleSec()
		
		local gap = math.max(1 / math.max(cfg.magicJitterHz, 1), settle + 0.3)
		
		
		
		
		
		local window = S.silentTarget ~= nil and Combat.cannotFireFor(S.gameState) <= settle + 0.05
		local fast = Combat.gunCycle() < settle * 0.8
		local onShot = cfg.magicHopOnShot and not fast and S.lastShotWindowAt ~= nil and now - S.lastShotWindowAt < 0.03 and now - j.at > 0.08
		
		local periodic = (now - j.at >= gap and not window) or (fast and window and now - j.at >= math.max(gap, 0.6)) or (j.force == true and now - j.at > 0.08)
		if periodic or onShot then
			j.at = now
			j.force = nil
			local r = cfg.magicJitterRadius
			Combat.setClearFilter(model)
			for _ = 1, 4 do
				local a = math.random() * 2 * math.pi
				local off = Vector3.new(math.cos(a) * r, -math.random() * math.min(r * 0.3, 0.8), math.sin(a) * r)
				if workspace:Raycast(origin + off, target - (origin + off), clearParams) == nil then
					j.off = off
					break
				end
			end
		end
		local w = if window then 0 else cfg.magicWiggle
		if w == 0 and (j.wig or 0) > 0 then
			j.stillAt = now 
		end
		j.wig = w
		S.magicHopSettled = now - math.max(j.at, j.stillAt or 0) >= settle
		local wig = Vector3.new(math.sin(now * 17) * w, -math.abs(math.sin(now * 23 + 1)) * w * 0.4, math.cos(now * 19) * w)
		return j.off + wig
	end
	
	
	
	Combat.sit = { near = 0, mid = 0, total = 0, aimingAtMe = 0, nearestDist = math.huge, exposed = false, hpFrac = 1, lowAmmo = false, weaponClass = "none", crowd = false, danger = 0, text = "" }
	S.situation = Combat.sit
	
	
	function Combat.weaponClass(prof: any): string
		if not prof or not prof.item then
			return "none"
		end
		return prof.class or "rifle"
	end
	
	function Combat.silentGunOk(prof: any): boolean
		return prof ~= nil and prof.gun == true
	end
	function Combat.updateSituation(enemies: { any }, gs: any)
		local sit = Combat.sit
		
		if sit.frame == Game.frameId then
			return
		end
		sit.frame = Game.frameId
		local me = Game.myRoot()
		local near, mid, aiming, nearest, nearestF = 0, 0, 0, math.huge, nil
		if me then
			for _, f in ipairs(enemies) do
				local r = Game.fighterBody(f)
				if r and not Target.isDead(f) then
					local d = (r.Position - me.Position).Magnitude
					if d < nearest then
						nearest, nearestF = d, f
					end
					if d <= 25 then
						near += 1
					end
					if d <= 80 then
						mid += 1
					end
					if d <= 140 and not f.IsBot and Target.threat(f) > 0.5 then
						aiming += 1
					end
				end
			end
		end
		local blade = S.meleeThreat 
		sit.bladeNear = blade ~= nil
		sit.near, sit.mid, sit.total, sit.aimingAtMe, sit.nearestDist = near, mid, #enemies, aiming, nearest
		
		local exposed = false
		if nearestF and me and nearest < 200 then
			local eHead = Game.fighterHead(nearestF)
			local myHead = S.myHeadPart
			local _, eModel = Game.fighterBody(nearestF)
			if eHead and myHead and myHead.Parent then
				local params = Game.losParams()
				if params then
					
					local hit = workspace:Raycast(eHead.Position, myHead.Position - eHead.Position, params)
					exposed = hit == nil or (eModel ~= nil and hit.Instance:IsDescendantOf(eModel)) or (LP.Character ~= nil and hit.Instance:IsDescendantOf(LP.Character))
				else
					exposed = Game.rayVisible(LP.Character, myHead, eHead.Position)
				end
			end
		end
		sit.exposed = exposed
		local hp, mx = gs and gs.hp, gs and gs.maxHp
		sit.hpFrac = if hp and mx and mx > 0 then math.clamp(hp / mx, 0, 1) else 1
		sit.lowAmmo = gs ~= nil and gs.ammo ~= nil and gs.maxAmmo ~= nil and gs.maxAmmo > 0 and gs.ammo <= math.max(1, math.floor(gs.maxAmmo * 0.25))
		sit.weaponClass = Combat.weaponClass(Game.weaponProfile())
		sit.crowd = near >= 3 or (mid >= 4)
		sit.danger = math.clamp(aiming * 0.35 + near * 0.15 + (1 - sit.hpFrac) * 0.3 + (if sit.lowAmmo then 0.15 else 0) + (if exposed and nearest < 60 then 0.1 else 0) + (if blade then 0.25 else 0), 0, 1)
		
		
		local bladeKey = if blade then blade.weapon .. math.floor(blade.dist + 0.5) else ""
		local key = near * 1000000 + mid * 10000 + aiming * 100 + (if exposed then 1 else 0) + (if sit.lowAmmo then 2 else 0) + (if nearest < math.huge then 4 else 0)
		if key ~= sit._key or bladeKey ~= sit._bladeKey then
			sit._key, sit._bladeKey = key, bladeKey
			local parts = {}
			if near > 0 then
				table.insert(parts, ("%d near"):format(near))
			elseif mid > 0 then
				table.insert(parts, ("%d mid"):format(mid))
			end
			if aiming > 0 then
				table.insert(parts, ("%d aiming at you"):format(aiming))
			end
			if blade then
				table.insert(parts, ("%s %.0f st"):format(blade.weapon, blade.dist))
			end
			if nearest < math.huge then
				table.insert(parts, if exposed then "exposed" else "in cover")
			end
			if sit.lowAmmo then
				table.insert(parts, "low ammo")
			end
			sit.text = if #parts > 0 then table.concat(parts, " · ") else ""
		end
	end

	
	
	function Combat.meleeReach(item: any): number
		local info = type(item) == "table" and item.Info
		local r = type(info) == "table" and tonumber(info.AttackReach) or nil
		return r or 10
	end
	function Combat.targetDistance(): number?
		local tgt = S.silentTarget
		local from = Game.shotOriginPos()
		if not (tgt and from) then
			return nil
		end
		return (tgt - from).Magnitude
	end
	
	
	local quickMeleeAt = 0
	function Combat.quickMeleeItem(): any
		local lf = Game.localFighter()
		if type(lf) ~= "table" or type(lf.Items) ~= "table" then
			return nil
		end
		for _, it in pairs(lf.Items) do
			if type(it) == "table" and type(it.Info) == "table" and it.Info.Type ~= "Gun" and it.Info.AttackReach then
				return it
			end
		end
		return nil
	end
	function Combat.updateQuickMelee(enemies: { any })
		S.quickMeleeReady = false
		if not (cfg.autoQuickMelee and cfg.silentAim) or S.menuOpen or S.hudEdit or S.calibrating then
			return
		end
		if ak.state ~= "idle" and ak.state ~= "done" then
			return
		end
		local prof = Game.weaponProfile()
		if prof.melee or not prof.item then
			return
		end
		local knife = Combat.quickMeleeItem()
		if not knife then
			return 
		end
		local reach = Combat.meleeReach(knife) - 0.5
		local from = Game.shotOriginPos()
		if not from then
			return
		end
		local best, bestD = nil, math.huge
		for _, f in ipairs(enemies) do
			local root, model = Game.fighterBody(f)
			if root and not Target.isDead(f) and not (cfg.immuneCheck and Game.fighterImmune(f)) then
				local part = Game.hitboxPart(f, "Body") or root
				local d = (part.Position - from).Magnitude
				if d < bestD and d <= reach and Game.rayVisible(model, part, from) then
					best, bestD = f, d
				end
			end
		end
		if not best then
			return
		end
		S.quickMeleeReady = true
		local now = os.clock()
		local stamp = knife and tonumber(rawget(knife, "_attack_cooldown"))
		local cdOk = if stamp then tick() >= stamp else now - quickMeleeAt >= (knife and tonumber(knife.Info.AttackCooldown) or 0.6)
		if cdOk and now - quickMeleeAt > 0.25 then
			quickMeleeAt = now
			S.quickMeleeUntil = now + 0.35
			Input.action("QuickMelee")
			log("INFO", ("auto quick melee → %s (%.1f st)"):format(Game.fighterName(best), bestD))
		end
	end

	
	
	
	
	
	Combat.util = { at = 0, busyUntil = 0 }
	function Combat.utilityItem(): any
		local lf = Game.localFighter()
		if type(lf) ~= "table" or type(lf.Items) ~= "table" then
			return nil
		end
		for _, it in pairs(lf.Items) do
			local info = type(it) == "table" and it.Info
			if type(info) == "table" and (info.Class == "Utility" or info.Type == "Throwable") and info.Type ~= "Gun" then
				return it
			end
		end
		return nil
	end
	function Combat.utilityReady(it: any): boolean
		local now = tick()
		for _, k in ipairs({ "_use_cooldown", "_attack_cooldown", "_shoot_cooldown" }) do
			local v = tonumber(rawget(it, k))
			if v and v > now then
				return false
			end
		end
		return true
	end
	Combat.UTIL_KIND = {
		Medkit = "heal", Elixir = "heal",
		["Subspace Tripmine"] = "mine", Satchel = "mine",
		Grenade = "throw", Flashbang = "throw", Molotov = "throw",
	}
	function Combat.updateUtilities(enemies: { any })
		if not cfg.utilAuto or S.menuOpen or S.hudEdit or S.calibrating or S.featuresPaused then
			return
		end
		local now = os.clock()
		local U = Combat.util
		if now < U.busyUntil or now - U.at < 0.5 then
			return
		end
		U.at = now
		local it = Combat.utilityItem()
		if not it or not Combat.utilityReady(it) then
			return
		end
		local name = tostring(it.Name)
		local kind = Combat.UTIL_KIND[name]
		local sit = S.situation
		local why: string? = nil
		local hold = 0.08
		if kind == "heal" and cfg.utilHeal then
			if sit and (sit.hpFrac or 1) * 100 < cfg.utilHealBelow and (S.defenseHiding or not Combat.enemyCanHit(enemies)) then
				why = ("health %d%%"):format(math.floor((sit.hpFrac or 1) * 100))
			end
		elseif kind == "mine" and cfg.utilMine then
			local mt = S.meleeThreat
			if mt and mt.fighter and (mt.dist or 99) < 14 then
				why = "blade closing in"
			end
		elseif kind == "throw" and cfg.utilThrow and S.silentFighter and S.silentPart then
			local from = Game.shotOriginPos()
			local d = from and (S.silentPart.Position - from).Magnitude
			if d and d >= 12 and d <= 45 and not Combat.body.owner and not Game.fighterImmune(S.silentFighter) then
				Combat.aimAt(S.silentTarget)
				hold = math.clamp(d / 45 * 1.2, 0.15, 1.2)
				why = ("target %d st"):format(math.floor(d))
			end
		end
		if not why then
			return
		end
		U.busyUntil = now + hold + 0.4
		S.quickMeleeUntil = now + hold + 0.3 
		S.quickUseUntil = now + hold + 0.5 
		Input.action("QuickUtility", hold)
		log("INFO", ("[utility] %s (%s)"):format(name, why))
	end
	
	
	
	Combat.suspendConn = nil
	function Combat.updateSuspend()
		if not Combat.suspendConn then
			local rs = game:GetService("ReplicatedStorage")
			local mods = rs:FindFirstChild("Modules")
			local IL = Game.requireIfLoaded(mods and mods:FindFirstChild("InputLibrary"))
			if type(IL) == "table" and type(IL.InputIs) == "function" then
				Combat.suspendConn = UIS.InputBegan:Connect(function(input, processed)
					if processed or not S.alive then
						return
					end
					for _, name in ipairs({ "QuickUtility", "QuickMelee", "EquipUtility" }) do
						local ok, is = pcall(IL.InputIs, IL, input, name)
						if ok and is then
							S.quickUseUntil = os.clock() + 1
							return
						end
					end
