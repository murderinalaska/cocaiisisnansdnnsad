	function Combat.hideHunter(enemies: { any }, at: Vector3): (any, number?)
		local best, bestD = nil, Combat.HUNT_R
		for _, f in ipairs(enemies) do
			local root = Game.fighterBody(f)
			if root and root.Parent and not Target.isDead(f) then
				local d = (root.Position - at).Magnitude
				if d < bestD then
					best, bestD = f, d
				end
			end
		end
		return best, if best then bestD else nil
	end
	
