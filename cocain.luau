	local lastIntegrity, lastDeep = 0, 0
	function Self.integrity()
		local now = os.clock()
		if now - lastIntegrity < 10 then
			return
		end
		lastIntegrity = now
		
		
		
		
		
		if S.served then
			local lic = genv().CocaineLicense
			local grace = S.loadClock or now
			if type(lic) ~= "table" then
				if now - grace > 20 then
					log("ERROR", "c0caine: served copy with no licence session — unloading")
					notify("c0caine: run it through the loader — unloading", 6, "error")
					if type(genv().CocaineUnload) == "function" then
						pcall(genv().CocaineUnload)
					end
					return
				end
			else
				local hb = tonumber(genv().CocaineHeartbeat) or grace
				
				
				
				local limit = if genv().CocaineOfflineSince ~= nil then 1800 else 300
				if now - hb > limit then
					log("ERROR", ("c0caine: no live session for %ds — unloading (session lost or copy tampered)"):format(limit))
					notify("c0caine: session lost — unloading", 6, "error")
					if type(genv().CocaineUnload) == "function" then
						pcall(genv().CocaineUnload)
					end
					return
				end
			end
		end
		local issues = {}
		if genv().CocaineState ~= S then
			table.insert(issues, "CocaineState replaced")
			genv().CocaineState = S
		end
		if genv().CocaineCfg ~= cfg then
			local nowCfg = os.clock()
			S.cfgReplaceCount = (S.cfgReplaceCount or 0) + 1
			if S.cfgReplaceCount == 1 or nowCfg - (S.cfgReplaceFirstAt or 0) > 60 then
				S.cfgReplaceCount = 1
				S.cfgReplaceFirstAt = nowCfg
				log("WARN", "integrity: CocaineCfg replaced — restored")
			end
			genv().CocaineCfg = cfg
			if S.cfgReplaceCount >= 3 and nowCfg - (S.cfgReplaceFirstAt or nowCfg) < 60 then
				table.insert(issues, "CocaineCfg replaced")
			end
		end
		for _, k in ipairs({ "redirect", "camCF", "rot", "mouse", "recordShot", "isOurShotRay", "silentWanted", "fakeInventory", "unlockable" }) do
			if type(h[k]) ~= "function" then
				table.insert(issues, "S.h." .. k .. " missing")
			end
		end
		
		
		local deep = now - lastDeep > 60
		if deep then
			
			
			
			lastDeep = now
			
			local before = {}
			for k, v in pairs(cfg) do
				if type(v) ~= "table" then
					before[k] = v
				end
			end
			sanitize(cfg)
			
			
			
			local DERIVED = {
				silentAim = true,
				autokillAuto = true,
				autokill = true,
				autoPeek = true,
				autoShootStop = true,
				autoShootAim = true,
				rapidAdaptive = true,
				unsafeMode = true,
				resolverWarp = true,
				antiTransloc = true,
				deadTargetGuard = true,
				directShots = true,
			}
			local nightlyEd = S.nightly or genv().CocaineEdition == "nightly"
			local moved, derived = {}, {}
			for k, v in pairs(before) do
				if cfg[k] ~= v then
					local isDerived = DERIVED[k] or (k == "rapidThrottle" and not nightlyEd)
					table.insert(if isDerived then derived else moved, ("%s %s→%s"):format(tostring(k), tostring(v), tostring(cfg[k])))
				end
			end
			if #derived > 0 then
				table.sort(derived)
				log("INFO", "[config] derived settings re-synced: " .. table.concat(derived, ", ", 1, math.min(#derived, 6)))
			end
			if #moved > 0 then
				table.sort(moved)
				table.insert(issues, "config out of range → clamped: " .. table.concat(moved, ", ", 1, math.min(#moved, 6)))
			end
		end
		
		
		for _, k in ipairs({ "camera", "namecall", "cosmetics" }) do
			local v = S.hooks.installed[k]
			if v ~= true and v ~= "n/a" and v ~= "off" then
				table.insert(issues, "hook group " .. k .. " not installed → reinstall")
				pcall(Hooks.install)
				break
			end
		end
		local camInstalledAt = tonumber(S.hooks.cameraInstalledAt) or 0
		if deep and not S.menuOpen and not S.teleported and S.autokill.state == "idle" and S.silentTarget == nil and S.hooks.installed.camera == true and os.clock() - camInstalledAt > 90 then
			local function probeCamera(): boolean
				local fl = fakeLock()
				fl.arm()
				local ok, alive = pcall(function()
					local cf = CameraController:GetCameraCFrame()
					return cf.LookVector:Dot((fl.dummy.Position - cf.Position).Unit) > 0.99
				end)
				fl.release()
				return ok and alive
			end
			if not probeCamera() then
				pcall(Hooks.repair, "integrity")
				S.hooks.cameraInstalledAt = os.clock()
				if probeCamera() then
					log("INFO", "integrity: camera hook re-armed")
				else
					table.insert(issues, "camera hook not answering after a reinstall")
				end
			end
		end
		S.integrityIssues = issues
		if #issues > 0 then
			log("ERROR", "integrity: " .. table.concat(issues, "; "))
			notify("integrity: " .. issues[1], 5, "error")
		end
	end

	
	
	
	
	
	S.perfTier = 0
	local perfEma, perfHighSince, perfLowSince = 0, nil, nil
	local PERF_UP = { 5, 8, 12 }
	function Self.perf(frameMs: number)
		perfEma = perfEma + (frameMs - perfEma) * 0.1
		S.perfEma = perfEma
		if cfg.lowSpec then
			S.perfTier = math.max(S.perfTier or 0, 2)
			return
		end
		if not cfg.autoPerf then
			S.perfTier = 0
			return
		end
		local tier = S.perfTier
		local now = os.clock()
		local upAt = PERF_UP[tier + 1]
		if upAt and perfEma > upAt then
			perfHighSince = perfHighSince or now
			if now - perfHighSince > 1.5 then
				S.perfTier = tier + 1
				perfHighSince = nil
				
				local top = {}
				for k, v in pairs(S.stepMs or {}) do
					table.insert(top, { k, v })
				end
				table.sort(top, function(a, b)
					return a[2] > b[2]
				end)
				local parts = {}
				for i = 1, math.min(3, #top) do
					table.insert(parts, ("%s %.1f"):format(top[i][1], top[i][2]))
				end
				log(if Self.perfWarned then "INFO" else "WARN", ("perf: %.1f ms/frame → tier %d · top: %s · %d enemies"):format(perfEma, S.perfTier, table.concat(parts, ", "), #(S.enemiesNow or {})))
				Self.perfWarned = true
			end
		else
			perfHighSince = nil
		end
		local downAt = PERF_UP[tier]
		if tier > 0 and downAt and perfEma < downAt * 0.5 then
			perfLowSince = perfLowSince or now
			if now - perfLowSince > 6 then
				S.perfTier = tier - 1
				perfLowSince = nil
				log("INFO", ("perf: %.1f ms/frame → tier %d"):format(perfEma, S.perfTier))
			end
		else
			perfLowSince = nil
		end
	end
	function Self.perfMode(): boolean
		return cfg.perfMode == true or S.perfTier >= 2
	end
	S.perfMode = Self.perfMode
