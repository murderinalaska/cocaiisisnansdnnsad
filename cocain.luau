	function Menu.rebuild()
		local wasOpen = S.menuOpen
		local tab = Menu.activeTab
		local ok, err = pcall(function()
			Menu.destroy()
			S.menuOpen = false
			Menu.build()
		end)
		if not ok then
			Menu.panic(err)
			
			
			
			pcall(Menu.destroy)
			local ok2, err2 = pcall(Menu.build)
			if not ok2 then
				Menu.panic(err2)
				return
			end
		end
		if tab ~= "" and Menu.pages[tab] then
			Menu.showTab(tab)
		end
		if wasOpen then
			pcall(Menu.set, true)
		end
	end
	function Menu.applyTheme()
		UI.applyTheme()
		local ok, err = pcall(Menu.rebuild)
		if not ok then
			Menu.panic(err)
			return
		end
		if S.hud and S.hud.retheme then
			pcall(S.hud.retheme)
		end
		notify("Theme: " .. UI.themeName(), 2, "ok")
		log("INFO", "theme:", UI.themeName())
	end
	
	
	
