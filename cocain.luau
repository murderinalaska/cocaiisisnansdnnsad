	function Vis.mbFocal(cam: any): number
		local h = 864
		pcall(function()
			local vp = cam.ViewportSize
			if typeof(vp) == "Vector2" and vp.Y > 0 then
				h = vp.Y
			end
		end)
		local fov = 70
		pcall(function()
			fov = tonumber(cam.FieldOfView) or 70
		end)
		return (h * 0.5) / math.tan(math.rad(math.clamp(fov, 1, 170)) * 0.5)
	end

	
	
	function Vis.mbAnchor(inst: any): any
		if typeof(inst) ~= "Instance" then
			return nil
		end
		if inst:IsA("BasePart") then
			return inst
		end
		if not inst:IsA("Model") then
			return nil
		end
		local c = Vis.mbAnchorCache[inst]
		if c then
			if c.part and c.part.Parent == inst then
				return c.part
			end
			if os.clock() - c.at < 2 then
				return nil
			end
		end
		local part = inst.PrimaryPart
		if not part then
			for _, d in ipairs(inst:GetDescendants()) do
				if d:IsA("BasePart") then
					part = d
					break
				end
			end
		end
		Vis.mbAnchorCache[inst] = { part = part, at = os.clock() }
		return part
	end

	
	
	
	
	
	function Vis.mbScreenPx(cam: any, pos: Vector3, vel: Vector3, focal: number): number
		local cc = cam.CFrame
		local depth = (pos - cc.Position):Dot(cc.LookVector)
		if depth < 1 then
			return 0 
		end
		local rel = vel - Vis.mbCamVel
		local fwd = cc.LookVector
		local perp = rel - fwd * rel:Dot(fwd)
		local m = perp.Magnitude
		if m ~= m then
			return 0
		end
		return (m / depth) * focal
	end

	
	
	
	
	function Vis.mbKill(part: any, st: any)
