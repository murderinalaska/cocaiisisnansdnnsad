			tr.Attachment0 = a0
			tr.Attachment1 = a1
			tr.FaceCamera = true
			tr.MinLength = 0
			tr.LightEmission = 0
			tr.Color = ColorSequence.new(Color3.fromRGB(205, 210, 228))
			
			tr.Transparency = NumberSequence.new({
