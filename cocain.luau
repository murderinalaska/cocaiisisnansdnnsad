	HUD.PUSH_GAP = 6
	function HUD.pushApart(rec: any): boolean
		local f = rec.frame
		local p0, s = f.AbsolutePosition, f.AbsoluteSize
		local g = HUD.PUSH_GAP
		local obs = {}
		for _, other in pairs(HUD.panels) do
			local o = other.frame
			if other ~= rec and o.Parent and o.Visible and o.AbsoluteSize.X > 2 and o.AbsoluteSize.Y > 2 then
				table.insert(obs, { o.AbsolutePosition, o.AbsoluteSize })
			end
		end
		local cam = workspace.CurrentCamera
		local vs = if cam then cam.ViewportSize else Vector2.new(1920, 1080)
		local function onScreen(x: number, y: number): (number, number)
			return math.clamp(x, 4, math.max(4, vs.X - s.X - 4)), math.clamp(y, 4, math.max(4, vs.Y - s.Y - 4))
		end
		local function free(x: number, y: number): boolean
			for _, ob in ipairs(obs) do
				local op, osz = ob[1], ob[2]
				if x < op.X + osz.X + g and op.X < x + s.X + g and y < op.Y + osz.Y + g and op.Y < y + s.Y + g then
					return false
				end
			end
			return true
		end
		local bx, by = onScreen(p0.X, p0.Y)
		if not free(bx, by) then
			local best = math.huge
			local fx, fy = bx, by
			local function try(x: number, y: number)
				local cx, cy = onScreen(x, y)
				if free(cx, cy) then
					local d = (cx - p0.X) ^ 2 + (cy - p0.Y) ^ 2
					if d < best then
						best, fx, fy = d, cx, cy
					end
				end
			end
			for _, ob in ipairs(obs) do
				local op, osz = ob[1], ob[2]
				local left, right = op.X - s.X - g, op.X + osz.X + g
				local up, down = op.Y - s.Y - g, op.Y + osz.Y + g
				try(left, p0.Y)
				try(right, p0.Y)
				try(p0.X, up)
				try(p0.X, down)
				try(left, up)
				try(right, up)
				try(left, down)
				try(right, down)
			end
			if best == math.huge then
				return false 
			end
			bx, by = fx, fy
		end
		local dx, dy = math.floor(bx - p0.X + 0.5), math.floor(by - p0.Y + 0.5)
		if dx == 0 and dy == 0 then
			return false
		end
		f.Position = f.Position + UDim2.fromOffset(dx, dy)
		return true
	end
	
	
	function HUD.applyPreset(name: string)
		local preset = HUD.PRESETS[name] or HUD.PRESETS.Standard
		cfg.hudPos = {}
		cfg.hudScale = preset.scale
		for k, v in pairs(preset.show) do
			cfg[k] = v
		end
		saveConfig()
		HUD.retheme()
		
		if S.menu and S.menu.refreshToggles then
			pcall(S.menu.refreshToggles)
		end
		task.delay(0.25, function()
			for key, rec in pairs(HUD.panels) do
				if rec.frame.Parent and rec.frame.Visible and HUD.pushApart(rec) then
					HUD.savePanel(key)
				end
			end
		end)
		notify(("HUD preset: %s"):format(string.lower(name)), 2, "ok")
	end

	
	function HUD.applyScale()
		local v = math.clamp(tonumber(cfg.hudScale) or 1, 0.7, 1.6)
		for _, rec in pairs(HUD.panels) do
			local sc = rec.frame and rec.frame:FindFirstChild("HudScale")
			if sc then
				sc.Scale = v
			end
		end
		task.defer(HUD.snapAll)
	end
