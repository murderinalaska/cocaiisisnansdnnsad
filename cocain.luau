	Vis.blendCache = setmetatable({}, { __mode = "k" })
	Vis.blendParams = nil
	function Vis.chamsRatio(model: Model): number
		local cam = workspace.CurrentCamera
		if not cam then
			return 1
		end
		local cached = Vis.blendCache[model]
		local now = os.clock()
		if cached and now - cached.at < 0.35 then
			return cached.r
		end
		if Vis.blendSpent == Game.frameId then
			return if cached then cached.r else 1
		end
		Vis.blendSpent = Game.frameId
		local root = model:FindFirstChild("HumanoidRootPart")
		if not (root and root:IsA("BasePart")) then
			return 1
		end
		local params = Vis.blendParams
		if not params then
			params = RaycastParams.new()
			params.FilterType = Enum.RaycastFilterType.Exclude
			params.IgnoreWater = true
			Vis.blendParams = params
		end
		local filter = {}
		if LP.Character then
			table.insert(filter, LP.Character)
		end
		local vms = workspace:FindFirstChild("ViewModels")
		if vms then
			table.insert(filter, vms)
		end
		params.FilterDescendantsInstances = filter
		
		
		
		
		local origin = cam.CFrame.Position
		local right, up = cam.CFrame.RightVector, cam.CFrame.UpVector
		local hits, n = 0, 0
		local base = (root :: BasePart).Position
		for iy = 0, 7 do
			for ix = 0, 7 do
				local p = base + right * ((ix / 7 - 0.5) * 2.4) + up * ((iy / 7 - 0.5) * 5)
				local rel = p - origin
				if rel.Magnitude > 2 then
					n += 1
					local hit = workspace:Raycast(origin, rel, params)
					if not hit or hit.Instance:IsDescendantOf(model) then
						hits += 1
					end
				end
			end
		end
		local r = if n == 0 then 1 else hits / n
		Vis.blendCache[model] = { at = now, r = r }
		return r
	end
	function Vis.syncHighlights(list: { any }, vis: { [any]: boolean }, cap: number)
		if not (cfg.esp and cfg.espHighlight) or cap <= 0 then
			if next(highlights) then
				for _, hl in pairs(highlights) do
					pcall(hl.Destroy, hl)
				end
				table.clear(highlights)
			end
			return
		end
		local seen = Vis.hlSeen
		table.clear(seen)
		
		
		
		local occludedOnly = cfg.espChamsOccluded == true
		local depth = Enum.HighlightDepthMode.AlwaysOnTop
		
		local colVis, colFill, colOut = Vis.col("colChamsFill"), Vis.col("colChamsHidden"), Vis.col("colChamsOutline")
		local ft, ot = cfg.espChamsFill, cfg.espChamsOutline
		local n = 0
		
		
		
		
		for _, f in ipairs(list) do
			local _, m = Game.fighterBody(f)
			if m then
				seen[m] = true
			end
		end
		for _, fighter in ipairs(list) do
			if n >= cap then
				break
			end
			local _, model = Game.fighterBody(fighter)
			if model then
				n += 1
				seen[model] = true
				local hl = highlights[model]
				if hl and hl.Parent == nil then
					
					
					
					pcall(hl.Destroy, hl)
					Vis.hlState[hl] = nil
					hl = nil
				end
				if not hl then
					hl = Instance.new("Highlight")
					hl.Name = "CocaineHL"
					hl.Adornee = model
					hl.Parent = model
					highlights[model] = hl
				end
				local st = Vis.hlState[hl]
				if not st then
					st = {}
					Vis.hlState[hl] = st
				end
				local seenVisible = vis[model] == true
				local mate = Game.isTeammate(fighter)
				local ratio = if mate then 1 elseif cfg.espChamsBlend ~= false then Vis.chamsRatio(model) else (if seenVisible then 1 else 0)
				local fill = if mate then Vis.col("colEspTeam") else colFill:Lerp(colVis, ratio)
				local ftNow = ft
				if not mate and ratio > 0.15 and ratio < 0.85 then
					ftNow = math.clamp(ft + 0.12, 0, 0.92)
				end
				local otNow = ot
				if not mate and cfg.espChamsPartial and ratio > 0.2 and ratio < 0.8 then
					otNow = math.clamp(ot * 0.35, 0, 1)
				end
				local wantOn = if mate then cfg.espTeammates == true else not (occludedOnly and ratio > 0.82)
				if not mate and occludedOnly and not cfg.espChamsBlend then
					wantOn = not seenVisible
				end
				if st.depth ~= depth then
					st.depth = depth
					hl.DepthMode = depth
				end
				if st.fill ~= fill then
					st.fill = fill
					hl.FillColor = fill
				end
				if st.outline ~= colOut then
					st.outline = colOut
					hl.OutlineColor = colOut
				end
				if st.ft ~= ftNow then
					st.ft = ftNow
					hl.FillTransparency = ftNow
				end
				if st.ot ~= otNow then
					st.ot = otNow
					hl.OutlineTransparency = otNow
				end
				if st.on ~= wantOn then
					st.on = wantOn
					hl.Enabled = wantOn
				end
			end
		end
		for model, hl in pairs(highlights) do
			if not seen[model] then
				pcall(hl.Destroy, hl)
				highlights[model] = nil
			end
		end
	end

