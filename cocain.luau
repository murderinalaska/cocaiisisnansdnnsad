	function Combat.gunReadyNow(gs: any): boolean
		local item = gs and gs.item
		if not (type(item) == "table" and gs.alive and not gs.locked) or S.menuOpen then
			return false
		end
		local info = item.Info
		if not (type(info) == "table" and info.Type == "Gun") or type(gs.ammo) ~= "number" or gs.ammo <= 0 then
			return false
		end
		if S.reloadUntil and os.clock() < S.reloadUntil then
			return false
		end
		local now = tick()
		local cd, rl = tonumber(rawget(item, "_shoot_cooldown")), tonumber(rawget(item, "_reload_cooldown"))
		if (cd and cd > now + 0.02) or (rl and rl > now) then
			return false
		end
		if type(item.IsEquipping) == "function" then
			local okE, eq = pcall(item.IsEquipping, item)
			if okE and eq == true then
				return false
			end
		end
		return true
	end
	
	function Combat.shotPress(kind: string)
		local H = Combat.health
		local C = S.shotCounters
		C.press += 1
		if H.pending ~= nil or not S.alive or not Combat.gunReadyNow(S.gameState) then
			return
		end
		local gs = S.gameState
		H.pending = {
			t = os.clock(), kind = kind, ammo = gs.ammo, item = gs.item, weapon = gs.weapon, ping = S.pingMs,
			rung = if kind == "auto" then (string.match(tostring(Input.fireMethodUsed), "^%a+") or "game") else "manual",
			send = Game.pilot.get("send"), claims = Shots.n,
			started = C.started, agreed = C.agreed, held = C.held, useItem = C.useItem, packet = C.packet, reply = C.reply,
		}
	end
	S.shotPress = Combat.shotPress
	function Combat.shotHealthTick()
		local H = Combat.health
		local C = S.shotCounters
		
		
		H.startedSeen = H.startedSeen or C.started > 0
		H.useItemSeen = H.useItemSeen or C.useItem > 0
		local p = H.pending
		if p == nil then
			return
		end
		local gs = S.gameState
		if not gs or gs.item ~= p.item or not gs.alive then
			H.pending = nil 
			return
		end
		if C.held > p.held then
			H.pending = nil 
			return
		end
		local moved = type(gs.ammo) == "number" and gs.ammo < p.ammo
		local replied = C.reply > p.reply
		if moved or replied then
			H.pending = nil
			Combat.shotJudged(p, true, if replied then "server reply" else "ammo")
			return
		end
		if os.clock() - p.t < math.clamp((S.pingMs or 100) / 1000 * 2 + 0.45, 0.6, 2.2) then
			return
		end
		H.pending = nil
		if (S.pingMs or 0) > 600 then
			return 
		end
		local stage = "server" 
		local net = S.net
		local sawFire = H.startedSeen and S.hooks.installed.fireGun == true
		local sawSend = H.useItemSeen and S.hooks.installed.namecall == true
		if sawFire and C.started == p.started then
			stage = "input" 
		elseif sawFire and C.agreed == p.agreed then
			stage = "gun refused" 
		elseif sawSend and C.useItem == p.useItem then
			stage = "replicate" 
		elseif sawSend and net and net.gameDataSeen and C.packet == p.packet then
			stage = "packet" 
		elseif not sawFire and not sawSend then
			stage = "unobserved" 
		end
		Combat.shotJudged(p, false, stage)
	end
	function Combat.shotJudged(p: any, ok: boolean, how: string)
		local H = Combat.health
		local P = Game.pilot
		pcall(Combat.traceFinish, p, ok, how)
		if ok then
			H.bad, H.good = 0, H.good + 1
			if p.kind == "manual" then
				H.manualOkAt = os.clock()
				P.ok("wrapper")
				P.ok("payload")
				P.ok("shield")
			else
				P.ok("fire")
				P.ok("send")
			end
			return
		end
		
		
		if p.kind == "auto" then
			local nxt = P.fail("fire", "auto shots died at " .. how, 3)
			if nxt then
				notify(("Auto shoot: shots weren't registering — switched to %s input"):format(nxt), 4, "warn")
				return
			end
			if os.clock() - H.manualOkAt < 60 or P.get("fire") ~= P.CHAINS.fire[#P.CHAINS.fire] then
				return
			end
		end
		H.bad += 1
		log("INFO", ("[shots] %s press did not register (%d in a row, died at %s)"):format(p.kind, H.bad, how))
		if H.bad < 3 then
			return
		end
		H.bad = 0
		local rb = S.hooksRollback
		local did = if type(rb) == "function" then rb(how) else nil
		if did then
			table.insert(H.rollbacks, { t = os.time(), stage = how, did = did })
			log("WARN", ("[shots] 3 presses in a row did not register on %s (died at %s) → %s"):format(EXECUTOR_NAME, how, did))
			notify("Shots weren't registering — " .. did, 6, "warn")
			local cb = S.shotEvent
			if type(cb) == "function" then
				pcall(cb, "rollback", how, did)
			end
		elseif not H.exhausted then
			H.exhausted = true
			log("ERROR", ("[shots] shots still do not register on %s with every hook given back (died at %s)"):format(EXECUTOR_NAME, how))
			notify("Shots still aren't registering with every hook off — tell us your executor", 8, "error")
			local cb = S.shotEvent
			if type(cb) == "function" then
				pcall(cb, "exhausted", how, "every hook given back")
			end
		end
	end
	
	function Combat.traceFinish(p: any, ok: boolean, how: string)
		S.shotTraceN += 1
		if ok and S.shotTraceN > 15 then
			return
		end
		local C = S.shotCounters
		local gate = S.lastGate
		local claim = nil
		local last = Shots.list[#Shots.list]
		if Shots.n > (p.claims or 0) and last then
			claim = { spoofed = last.spoofed == true, unaimed = last.unaimed == true, verdict = last.verdict, part = last.part }
		end
		local installedNow = S.hooks.installed
		table.insert(S.shotTraces, {
			n = S.shotTraceN, t = os.time(), kind = p.kind, ok = ok, died = if ok then nil else how, via = if ok then how else nil,
			weapon = p.weapon, rung = p.rung, send = p.send, ping = if p.ping then math.floor(p.ping) else nil,
			ms = math.floor((os.clock() - p.t) * 1000),
			stages = { started = C.started - p.started, agreed = C.agreed - p.agreed, held = C.held - p.held, useItem = C.useItem - p.useItem, packet = C.packet - p.packet, reply = C.reply - p.reply },
			ammo = { p.ammo, S.gameState and S.gameState.ammo or nil },
			gate = if gate and os.clock() - gate.at < 3 then { how = gate.how, n = gate.n, first = gate.first } else nil,
			claim = claim,
			wrap = S.fireWrap,
			hooks = { fire = tostring(installedNow.fireGun), aim = tostring(installedNow.cameraData), nc = tostring(installedNow.namecall), ncMode = S.hooks.ncMode },
			pilot = Game.pilot.line(),
		})
		if #S.shotTraces > 60 then
			table.remove(S.shotTraces, 1)
		end
	end
	
	function Combat.shotRing(rec: any, verdict: string)
		if not rec.melee and not rec.projectile and rec.rung and rec.rung ~= "manual" then
			local rs = Combat.rungStats[rec.rung]
			if not rs then
				rs = { claims = 0, replies = 0, noReply = 0 }
				Combat.rungStats[rec.rung] = rs
			end
			rs.claims += 1
			if verdict == "NO-REPLY" then
				rs.noReply += 1
			elseif verdict ~= "KILL" then
				rs.replies += 1
			end
		end
		local L = S.shotLog
		table.insert(L, {
			t = os.time(), v = verdict, w = rec.weapon, rtt = rec.rttMs, ping = if S.pingMs then math.floor(S.pingMs) else nil,
			rung = rec.rung, send = Game.pilot.get("send"), sp = rec.spoofed == true, un = rec.unaimed == true,
			hop = if rec.hopAt and rec.t then math.floor((rec.t - rec.hopAt) * 1000) else nil,
			d = if type(rec.dist) == "number" then math.floor(rec.dist) else nil, part = rec.part,
			det = if type(rec.detail) == "string" then string.sub(rec.detail, 1, 60) else nil,
		})
		if #L > 200 then
			table.remove(L, 1)
		end
	end

	
	
	
	
	
	
	
	
	local Net: any = { installed = false, physId = nil, counts = {}, window = {}, windowAt = os.clock(), sent = 0, blocked = 0, delayed = 0, rate = 0, physRate = 0, err = 0, sendFail = 0, blockRun = 0, enabledNow = false, enabledAt = 0 }
	S.net = Net
	Net.available = EXEC.caps.raknet
	if type(EXEC.raknet) == "table" and not Net.available then
		
		local keys = {}
		pcall(function()
			for k in pairs(EXEC.raknet) do
				table.insert(keys, tostring(k))
			end
		end)
		table.sort(keys)
		log("WARN", ("net: %s's raknet library has no add_send_hook / remove_send_hook — network mode unavailable · has: %s"):format(EXECUTOR_NAME, string.sub(table.concat(keys, ", "), 1, 200)))
	end
	Net.RELIABLE_GAME_DATA = 0x83 
	Net.MAX_BLOCK_RUN = 40 
	function Net.enabled(): boolean
		if not Net.available then
			return false
		end
		
		local now = os.clock()
		if now - Net.enabledAt > 0.25 then
			Net.enabledAt = now
			if type(EXEC.raknet.is_enabled) == "function" then
				local ok, en = pcall(EXEC.raknet.is_enabled)
				Net.enabledNow = ok and en == true
			else
				
				Net.enabledNow = Net.installed and now - (Net.lastPacketAt or -math.huge) < 3
			end
		end
		return Net.enabledNow
	end
	function Net.active(): boolean
		local st = S.cfg 
		return S.alive and st.unsafeMode == true and st.unsafeAccepted == true and Net.enabled()
	end
	
	
	
	function Net.choking(): boolean
		local st = S.cfg
		if not st.unsafeFakeLag then
			return false
		end
		if st.unsafeFakeLagOnlyWhenTargeted and not (S.threatOnMe or S.silentTarget ~= nil or S.firing) then
			return false
		end
		local every = math.max(st.unsafeFakeLagEveryMs / 1000, 0.05)
		local choke = math.min(st.unsafeFakeLagChokeMs / 1000, every * 0.5)
		return (os.clock() % every) < choke
	end
	function Net.onPacket(packet: any)
		local id = packet.PacketId
		Net.sent += 1
		local now = os.clock()
		Net.lastPacketAt = now
		if id == Net.RELIABLE_GAME_DATA then
			
			Net.gameDataSeen = true
			local sentAt = S.lastUseItemAt
			if sentAt and sentAt ~= Net.matchedUseItemAt and now - sentAt >= 0 and now - sentAt < 0.25 then
				Net.matchedUseItemAt = sentAt
				local C = S.shotCounters
				if C then
					C.packet += 1
				end
			end
		end
		local c = Net.counts[id]
		if not c then
			c = { n = 0, rel = packet.Reliability, size = packet.Size }
			Net.counts[id] = c
		end
		c.n += 1
		c.size = packet.Size
		
		
		if packet.Reliability == 5 and id ~= Net.RELIABLE_GAME_DATA then
			local w = Net.window
			w[id] = (w[id] or 0) + 1
		end
		if not Net.active() or S.menuOpen then
			return
		end
		if id ~= Net.physId or id == Net.RELIABLE_GAME_DATA then
			return
		end
		local st = S.cfg
		if Net.choking() and Net.blockRun < Net.MAX_BLOCK_RUN then
			packet:Block()
			Net.blocked += 1
			Net.blockRun += 1
			return
		end
		Net.blockRun = 0
		if st.unsafePingBoost and Net.sendFail < 3 then
			
			local bytes = packet.AsString
			local prio, rel, ch = packet.Priority, packet.Reliability, packet.OrderingChannel
			if type(bytes) ~= "string" or #bytes == 0 then
				return 
			end
			packet:Block()
			Net.delayed += 1
			
			
			
			task.delay(st.unsafePingBoostMs / 1000, function()
				local okS, errS = pcall(EXEC.raknet.send, bytes, prio, rel, ch)
				if not okS then
					Net.sendFail += 1
					task.defer(log, "WARN", "net: raknet.send failed:", errS)
					if Net.sendFail >= 3 then
						local live = genv().CocaineState
						if live and live.cfg then
							live.cfg.unsafePingBoost = false
						end
						task.defer(log, "ERROR", "net: ping boost disabled — three re-sends failed (the server would have frozen us)")
					end
				end
			end)
		end
	end
	function Net.install()
		if Net.installed or not Net.available then
			return
		end
		local g = genv()
		if type(g.CocaineNetHook) == "function" then
			
			local okR = pcall(EXEC.raknet.remove_send_hook, g.CocaineNetHook)
			if not okR then
				log("WARN", "net: could not remove the previous send hook — not installing a second one")
				return
			end
			g.CocaineNetHook = nil
		end
		local fn = function(packet)
			local ok, err = pcall(Net.onPacket, packet)
			if not ok then
				Net.err += 1
				if Net.err <= 3 then
					task.defer(log, "WARN", "net hook:", err)
				end
			end
		end
		local ok, err = pcall(EXEC.raknet.add_send_hook, fn)
		if ok then
			g.CocaineNetHook = fn
			Net.installed = true
			Net.installedAt = os.clock()
			log("INFO", "net: RakNet send hook installed (unsafe mode " .. (if cfg.unsafeMode then "ON" else "off") .. ")")
		else
			log("WARN", "net: add_send_hook failed:", err)
		end
	end
	function Net.uninstall()
		local g = genv()
		if type(g.CocaineNetHook) == "function" and Net.available then
			pcall(EXEC.raknet.remove_send_hook, g.CocaineNetHook)
		end
		g.CocaineNetHook = nil
		Net.installed = false
	end
	
	function Net.tick()
		local now = os.clock()
		if now - Net.windowAt < 1 then
			return
		end
		local dt = math.max(now - Net.windowAt, 1e-3)
		Net.windowAt = now
		Net.rate = Net.sent / dt
		Net.sent = 0
		local bestId, bestN = nil, 0
		for id, n in pairs(Net.window) do
			if n > bestN and id ~= Net.RELIABLE_GAME_DATA then
				bestId, bestN = id, n
			end
		end
		
		
		local rate = bestN / dt
		if bestId and rate >= 15 then
			Net.physId = bestId
			Net.physRate = rate
		elseif Net.physId ~= nil and (Net.window[Net.physId] or 0) / dt < 5 then
			Net.physId = nil
			Net.physRate = 0
		end
		table.clear(Net.window)
		if cfg.unsafeMode and cfg.unsafeAccepted and not Net.installed and Net.available then
			Net.install()
		end
		
		if Net.installed and cfg.unsafeMode and not Net.noticeShown and now - (Net.installedAt or now) > 10 and not Net.enabled() then
			Net.noticeShown = true
			notify("Turn on RakNet: " .. Net.whereToEnable() .. " (network mode is on)", 8, "warn")
			log("INFO", "net: the RakNet library is off in the executor — " .. Net.whereToEnable())
		end
	end
	function Net.whereToEnable(): string
		if EXEC.isVolt then
			return "Volt → Settings → Client → RakNet Library"
		elseif string.find(string.lower(EXECUTOR_NAME), "potassium", 1, true) then
			return "Potassium → Settings → RakNet"
		end
		return EXECUTOR_NAME .. "'s settings (RakNet)"
	end
	function Net.summary(): any
		return {
			available = Net.available,
			raknetEnabled = Net.enabled(),
			active = Net.active(),
			installed = Net.installed,
			physId = Net.physId,
			physRate = math.floor(Net.physRate + 0.5),
			rate = math.floor(Net.rate + 0.5),
			blocked = Net.blocked,
			delayed = Net.delayed,
			choking = Net.active() and Net.choking(),
			errors = Net.err,
		}
	end

	
	
	
	
	local Hooks: any = {}
	
	
	function Hooks.passThrough(...: any): ...any
		return ...
	end
	
	
	
	
	
	local function hook(target: any, fn: any, group: string?): (any, boolean)
		if type(target) ~= "function" or type(EXEC.hookfunction) ~= "function" then
			return target, false
		end
		if S.hookedFns[target] then
			return Hooks.passThrough, false 
		end
		if type(EXEC.isfunctionhooked) == "function" then
			local okH, hooked = pcall(EXEC.isfunctionhooked, target)
			if okH and hooked == true then
				
				
				
				
				local okR = type(EXEC.restorefunction) == "function" and pcall(EXEC.restorefunction, target)
				local okH2, still = pcall(EXEC.isfunctionhooked, target)
				if not okR or (okH2 and still == true) then
					log("DEBUG", "hook: function already carries a detour — skipped")
					S.hookedFns[target] = true
					return Hooks.passThrough, false
				end
				log("INFO", "hook: a foreign detour was restored before hooking")
			end
		end
		local function once(f: any): any
			local ok, old = pcall(EXEC.hookfunction, target, f)
			if ok and type(old) == "function" then
				return old
			end
			return nil
		end
		local function mark(wrap: string)
			S.hookedFns[target] = true
			S.hookReg[target] = { group = group or "misc", wrap = wrap }
			S.hookWraps[wrap] = (S.hookWraps[wrap] or 0) + 1
		end
		
		
		if Game.pilot.get("wrapper") == "cclosure" then
			local okW, wrapped = pcall(EXEC.newcclosure, fn)
			if okW and type(wrapped) == "function" then
				local old = once(wrapped)
				if old then
					mark("cclosure")
					return old, true
				end
			end
		end
		local old = once(fn)
		if old then
			mark("raw")
			return old, true
		end
		log("WARN", "hook skipped")
		return Hooks.passThrough, false
	end
	
	
	function Hooks.giveBack(groups: { [string]: boolean }): number
		if type(EXEC.restorefunction) ~= "function" then
			return 0
		end
		local n = 0
		for target, rec in pairs(S.hookReg) do
			if groups.all or groups[rec.group] then
				if pcall(EXEC.restorefunction, target) then
					n += 1
				end
				S.hookedFns[target] = nil
				S.hookReg[target] = nil
			end
		end
		return n
	end
	
	function Hooks.guarded(source: string, fallback: any, fn: any, ...: any): any
		local ok, out = pcall(fn, ...)
		if ok then
			return out
		end
		if S.hookErr then
			S.hookErr(source, out)
		end
		return fallback
	end
	
	local function classMethod(cls: any, name: string): any
		local t = cls
		local depth = 0
		while type(t) == "table" and depth < 6 do
			local v = rawget(t, name)
			if type(v) == "function" then
				return v
			end
			local mt = getmetatable(t)
			t = mt and mt.__index
			depth += 1
		end
		return nil
	end

	
